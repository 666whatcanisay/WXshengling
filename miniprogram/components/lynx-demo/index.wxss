.lynx-card {
  padding: 30rpx 24rpx 24rpx;
  border: 1rpx solid #68794c;
  border-radius: 28rpx;
  background: radial-gradient(ellipse at 50% 42%, #456651 0%, #345446 52%, #2d4a3e 100%);
  color: #f5e6c8;
  text-align: center;
}

.lynx-heading text { display: block; }
.lynx-kicker { color: #c4d4ac; font-size: 22rpx; letter-spacing: 2rpx; }
.lynx-title { margin-top: 6rpx; font-size: 36rpx; font-weight: 700; }

.lynx-choices { display: flex; gap: 10rpx; }
.lynx-choice {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 12rpx 0;
  margin: 0;
  border: 1rpx solid #597265;
  border-radius: 14rpx;
  background: #294539;
  color: #eddfbe;
  font-size: 24rpx;
  line-height: 1.25;
}
.lynx-choice::after { border: 0; }
.lynx-grade { color: #edca83; font-size: 18rpx; font-weight: 700; }
.lynx-choice-selected { background: #475f3c; border-color: #c7a560; color: #fff0cd; }
.lynx-help { display: block; margin-top: 16rpx; color: #d0dcc0; font-size: 22rpx; }
