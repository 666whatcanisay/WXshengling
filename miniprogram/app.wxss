/* ============================================ */
/*  AI 成长伙伴 - 全局样式文件                    */
/*  设计风格：AI自律森林 - 深绿森林治愈风  */
/*  主色调：深森林绿 + 木纹棕 + 奶油米黄            */
/* ============================================ */

/* ---------- CSS 变量定义（动森森林色板） ---------- */
page {
  /* 森林深色系 */
  --bg-deep: #2D4A3E;
  --bg-main: #355447;
  --bg-card: #3D6254;
  --bg-card-light: #4A7361;
  /* 木纹棕色系 */
  --wood-dark: #8B6914;
  --wood: #B8860B;
  --wood-light: #DAA520;
  /* 奶油米黄色系 */
  --cream: #F5E6C8;
  --cream-soft: #E8D9BB;
  /* 叶子绿色系 */
  --leaf-green: #7CB342;
  --leaf-light: #AED581;
  /* 点缀色 */
  --accent-orange: #FFAB40;
  /* 文字颜色 */
  --text-primary: #F5E6C8;
  --text-secondary: #C4B89A;
  --text-muted: #8B9A7D;
  /* 边框颜色 */
  --border-dash: rgba(165, 190, 140, 0.4);
  --border-solid: #8B6914;

  background-color: var(--bg-deep);
  color: var(--text-primary);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* ---------- 动画关键帧 ---------- */

/* 轻柔浮动动画 - 模拟树叶/精灵漂浮 */
@keyframes floatGentle {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12rpx);
  }
}

/* 轻微摇摆动画 - 模拟树枝/草叶摇曳 */
@keyframes sway {
  0%,
  100% {
    transform: rotate(0deg);
  }
  25% {
    transform: rotate(2deg);
  }
  75% {
    transform: rotate(-2deg);
  }
}

/* 星光闪烁动画 - 用于装饰性元素 */
@keyframes sparkle {
  0%, 100% { opacity: 0.4; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1.15); }
}

/* 从下往上淡入滑出 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 基础淡入 */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 弹性弹出 - 动森风格UI出现效果 */
@keyframes popIn {
  0% {
    opacity: 0;
    transform: scale(0.6);
  }
  60% {
    opacity: 1;
    transform: scale(1.08);
  }
  100% {
    transform: scale(1);
  }
}

/* 呼吸效果 - 卡片/按钮微动效 */
@keyframes breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.03); }
}

/* 脉冲光效 - 进度条/加载指示器 */
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* 骨架屏流光效果 */
@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

/* 叶子飘落动画（装饰用） */
@keyframes leafFall {
  0% {
    transform: translateY(-20rpx) rotate(0deg);
    opacity: 0;
  }
  20% { opacity: 0.8; }
  80% { opacity: 0.6; }
  100% {
    transform: translateY(80rpx) rotate(180deg);
    opacity: 0;
  }
}

/* ---------- 页面容器 ---------- */

/* 默认页面容器 - 深森林背景 + 微妙树影图案 */
.page {
  min-height: 100vh;
  background-color: var(--bg-deep);
  background-image:
    radial-gradient(circle at 20% 30%, rgba(74, 115, 97, 0.18) 0%, transparent 50%),
    radial-gradient(circle at 80% 70%, rgba(74, 115, 97, 0.14) 0%, transparent 45%),
    radial-gradient(circle at 50% 90%, rgba(124, 179, 66, 0.06) 0%, transparent 40%);
  padding: 20rpx;
  box-sizing: border-box;
  color: var(--text-primary);
}

/* 沉浸式全屏容器（无内边距） */
.page-full {
  min-height: 100vh;
  background-color: var(--bg-deep);
  background-image:
    radial-gradient(circle at 20% 30%, rgba(74, 115, 97, 0.18) 0%, transparent 50%),
    radial-gradient(circle at 80% 70%, rgba(74, 115, 97, 0.14) 0%, transparent 45%);
}

/* 渐变增强版页面容器 */
.page-gradient {
  min-height: 100vh;
  background:
    linear-gradient(180deg, var(--bg-deep) 0%, var(--bg-main) 50%, var(--bg-card) 100%);
  padding: 20rpx;
  box-sizing: border-box;
}

/* 居中内容页面容器 */
.page-center {
  min-height: 100vh;
  background-color: var(--bg-deep);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

/* ---------- Section 头部区域 ---------- */

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 16rpx;
}

/* 小节标题 - 带叶子前缀图标 */
.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--cream);
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-title::before {
  content: '🌿';
  font-size: 28rpx;
  animation: sway 4s ease-in-out infinite;
}

.section-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  padding: 0 32rpx 16rpx;
}

.section-more {
  font-size: 26rpx;
  color: var(--leaf-light);
  font-weight: 500;
}

/* ---------- 🌲 木纹标题栏（动森标志性元素！）---------- */

/* 木纹药丸形标题栏 - 深木底 + 奶油文字 + 叶子装饰 */
.wood-title {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: linear-gradient(135deg, var(--wood-dark) 0%, var(--wood) 50%, var(--wood-dark) 100%);
  color: var(--cream);
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  border-radius: 50rpx;
  padding: 16rpx 48rpx;
  margin: 24rpx auto;
  position: relative;
  box-shadow:
    0 4rpx 16rpx rgba(139, 105, 20, 0.5),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.12),
    inset 0 -2rpx 4rpx rgba(0, 0, 0, 0.2);
  text-align: center;
}

/* 标题左侧叶子装饰 */
.wood-title::before {
  content: '🍃';
  font-size: 24rpx;
  position: absolute;
  left: 20rpx;
  top: 50%;
  transform: translateY(-50%) rotate(-15deg);
  animation: sway 3s ease-in-out infinite;
}

/* 标题右侧叶子装饰 */
.wood-title::after {
  content: '🍃';
  font-size: 24rpx;
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%) rotate(15deg);
  animation: sway 3s ease-in-out infinite reverse;
}

/* 窄版木纹标题（用于卡片内小标题） */
.wood-title-sm {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: linear-gradient(135deg, var(--wood-dark), var(--wood));
  color: var(--cream);
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  border-radius: 40rpx;
  padding: 10rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow:
    0 2rpx 10rpx rgba(139, 105, 20, 0.4),
    inset 0 1rpx 3rpx rgba(255, 255, 255, 0.1);
}

.wood-title-sm::before {
  content: '🌿';
  font-size: 20rpx;
  margin-right: 6rpx;
}

/* ---------- Card 卡片组件 ---------- */

/* 虚线边框卡片 - 浅绿半透明背景 + 绿色虚线边框 */
.card {
  background-color: rgba(61, 98, 84, 0.65);
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 16rpx 20rpx;
  border: 2rpx dashed var(--border-dash);
  position: relative;
  overflow: hidden;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  backdrop-filter: blur(4rpx);
}

.card:active {
  transform: scale(0.98);
}

/* 实心木纹边框卡片 - 更重要的内容区域 */
.card-solid {
  background-color: rgba(61, 98, 84, 0.7);
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 16rpx 20rpx;
  border: 3rpx solid var(--border-solid);
  position: relative;
  overflow: hidden;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  box-shadow:
    0 4rpx 20rpx rgba(0, 0, 0, 0.15),
    inset 0 1rpx 2rpx rgba(174, 213, 129, 0.05);
}

.card-solid:active {
  transform: scale(0.98);
}

/* 顶部带木纹色条的卡片 */
.card-accent {
  background-color: rgba(61, 98, 84, 0.7);
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 16rpx 20rpx;
  border: 2rpx dashed var(--border-dash);
  position: relative;
  overflow: hidden;
}

.card-accent::before {
  content: '';
  position: absolute;
  top: 0;
  left: 24rpx;
  right: 24rpx;
  height: 6rpx;
  background: linear-gradient(90deg, var(--wood-dark), var(--wood), var(--wood-light), var(--wood), var(--wood-dark));
  border-radius: 0 0 6rpx 6rpx;
}

/* 带呼吸动效的卡片（重要状态提示） */
.card-breathe {
  animation: breathe 3s ease-in-out infinite;
}

/* 卡片标题文字 */
.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--cream);
  margin-bottom: 12rpx;
}

/* 卡片描述文字 */
.card-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 紧凑型卡片（内边距更小） */
.card-compact {
  padding: 24rpx;
  margin: 12rpx 20rpx;
}

/* ---------- 引用/语录悬浮卡片 ---------- */

/* 引用卡片 - 更浅的背景 + 左侧木纹强调线 */
.quote-card {
  background-color: rgba(74, 115, 97, 0.55);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin: 16rpx 20rpx;
  border-left: 6rpx solid var(--wood);
  position: relative;
  font-style: italic;
}

.quote-card .quote-text {
  font-size: 28rpx;
  color: var(--cream-soft);
  line-height: 1.7;
}

.quote-card .quote-author {
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: right;
  margin-top: 12rpx;
}

/* ---------- 按钮样式 ---------- */

/* 木纹主按钮 - 棕色底 + 奶油文字 + 圆角 */
.btn-wood {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, var(--wood-dark) 0%, var(--wood) 50%, var(--wood-light) 100%);
  color: var(--cream);
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  letter-spacing: 2rpx;
  box-shadow:
    0 6rpx 24rpx rgba(139, 105, 20, 0.45),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.15),
    inset 0 -2rpx 4rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.btn-wood:active {
  transform: scale(0.96);
  box-shadow:
    0 3rpx 12rpx rgba(139, 105, 20, 0.35),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.1);
}

.btn-wood[disabled] {
  background: linear-gradient(135deg, #6B5620, #7A6228);
  box-shadow: none;
  opacity: 0.6;
}

/* 叶子绿按钮 - 清新自然风格 */
.btn-leaf {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, var(--leaf-green) 0%, #689F38 100%);
  color: var(--cream);
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  letter-spacing: 2rpx;
  box-shadow:
    0 6rpx 24rpx rgba(124, 179, 66, 0.35),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.18);
  transition: all 0.3s ease;
}

.btn-leaf:active {
  transform: scale(0.96);
  box-shadow: 0 3rpx 12rpx rgba(124, 179, 66, 0.25);
}

.btn-leaf[disabled] {
  background: linear-gradient(135deg, #9CCC65, #AED581);
  box-shadow: none;
  opacity: 0.6;
}

/* 次级按钮 - 透明底 + 木纹边框 */
.btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  background: rgba(61, 98, 84, 0.5);
  color: var(--cream-soft);
  font-size: 30rpx;
  font-weight: 500;
  border: 2rpx solid var(--border-solid);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.btn-secondary:active {
  transform: scale(0.96);
  background: rgba(74, 115, 97, 0.6);
}

.btn-secondary[disabled] {
  border-color: rgba(139, 105, 20, 0.3);
  color: var(--text-muted);
  opacity: 0.5;
}

/* 文字按钮 - 无背景仅文字 */
.btn-text {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 16rpx;
  background: transparent;
  color: var(--leaf-light);
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.btn-text:active {
  color: var(--leaf-green);
}

/* 小型按钮 */
.btn-small {
  height: 60rpx;
  padding: 0 32rpx;
  font-size: 26rpx;
  border-radius: 30rpx;
}

/* 危险按钮 - 橙红色警告风格 */
.btn-danger {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #E64A19 0%, #D84315 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 6rpx 24rpx rgba(230, 74, 25, 0.35);
}

.btn-danger:active {
  transform: scale(0.96);
}

/* ---------- 表单元素 ---------- */

.form-group {
  padding: 0 20rpx;
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--cream);
  margin-bottom: 12rpx;
}

/* 必填标记 - 橙色星号 */
.form-label-required::after {
  content: ' *';
  color: var(--accent-orange);
  font-weight: 400;
}

/* 输入框 - 森林主题样式 */
.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  background: rgba(61, 98, 84, 0.6);
  border: 2rpx solid rgba(139, 105, 20, 0.3);
  border-radius: 24rpx;
  font-size: 28rpx;
  color: var(--cream);
  box-sizing: border-box;
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
}

.form-input:focus {
  border-color: var(--wood);
  box-shadow: 0 0 0 4rpx rgba(184, 134, 11, 0.15);
  outline: none;
}

.form-input::placeholder {
  color: var(--text-muted);
}

/* 输入框错误状态 */
.form-input-error {
  border-color: #E64A19;
}

.form-input-error:focus {
  box-shadow: 0 0 0 4rpx rgba(230, 74, 25, 0.15);
}

/* 多行文本输入框 */
.form-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx 28rpx;
  background: rgba(61, 98, 84, 0.6);
  border: 2rpx solid rgba(139, 105, 20, 0.3);
  border-radius: 24rpx;
  font-size: 28rpx;
  color: var(--cream);
  box-sizing: border-box;
  line-height: 1.6;
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
}

.form-textarea:focus {
  border-color: var(--wood);
  box-shadow: 0 0 0 4rpx rgba(184, 134, 11, 0.15);
  outline: none;
}

.form-textarea::placeholder {
  color: var(--text-muted);
}

/* 表单错误提示文字 */
.form-error {
  font-size: 24rpx;
  color: #E64A19;
  margin-top: 8rpx;
  padding-left: 8rpx;
}

/* 表单提示文字 */
.form-hint {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
  padding-left: 8rpx;
}

/* ---------- Checkbox 动森风格复选框 ---------- */

/* 木纹圆形复选框容器 */
.checkbox-ac {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
}

.checkbox-ac .checkbox-box {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid var(--border-solid);
  background: rgba(61, 98, 84, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
  flex-shrink: 0;
}

.checkbox-ac .checkbox-box.checked {
  background: linear-gradient(135deg, var(--wood), var(--wood-light));
  border-color: var(--wood-light);
  box-shadow: 0 2rpx 8rpx rgba(184, 134, 11, 0.35);
}

.checkbox-ac .checkbox-box.checked::after {
  content: '✓';
  color: var(--cream);
  font-size: 26rpx;
  font-weight: 700;
}

.checkbox-ac .checkbox-label {
  font-size: 28rpx;
  color: var(--cream-soft);
}

/* ---------- Badge / Tag 标签组件 ---------- */

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
}

/* 叶子绿标签 */
.badge-primary {
  background: rgba(124, 179, 66, 0.2);
  color: var(--leaf-light);
}

/* 金色/木纹标签 */
.badge-accent {
  background: rgba(218, 165, 32, 0.2);
  color: var(--wood-light);
}

/* 成功状态标签 */
.badge-success {
  background: rgba(124, 179, 66, 0.2);
  color: var(--leaf-light);
}

/* 危险/警告标签 */
.badge-danger {
  background: rgba(230, 74, 25, 0.15);
  color: #FF8A65;
}

/* 弱化标签 */
.badge-muted {
  background: rgba(61, 98, 84, 0.4);
  color: var(--text-muted);
}

/* 叶子形状标签 - 带圆角和浅绿底色 */
.tag-leaf {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  background: rgba(124, 179, 66, 0.15);
  color: var(--leaf-light);
  border: 1rpx solid rgba(124, 179, 66, 0.3);
}

.tag-leaf::before {
  content: '🌿 ';
  font-size: 20rpx;
}

/* 金色高亮标签 */
.tag-accent {
  background: rgba(218, 165, 32, 0.15);
  color: var(--wood-light);
  border-color: rgba(218, 165, 32, 0.3);
}

.tag-accent::before {
  content: '✨ ';
  font-size: 20rpx;
}

/* ---------- Progress Bar 进度条（木纹框架风格）---------- */

/* 木纹进度条外框 */
.progress-wood {
  width: 100%;
  height: 24rpx;
  background: rgba(45, 74, 62, 0.8);
  border-radius: 12rpx;
  border: 2rpx solid var(--border-solid);
  overflow: hidden;
  position: relative;
  box-shadow:
    inset 0 2rpx 4rpx rgba(0, 0, 0, 0.3),
    0 1rpx 2rpx rgba(184, 134, 11, 0.2);
}

/* 叶子绿进度填充 */
.progress-wood .progress-fill {
  height: 100%;
  border-radius: 10rpx;
  background: linear-gradient(90deg, var(--leaf-green), var(--leaf-light), var(--leaf-green));
  transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  position: relative;
  overflow: hidden;
}

/* 进度条内部光泽动效 */
.progress-wood .progress-fill::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.25) 50%,
    transparent 100%
  );
  animation: shimmer 2s infinite;
}

/* 兼容旧版进度条包装器 */
.progress-wrap {
  width: 100%;
  height: 16rpx;
  background: rgba(45, 74, 62, 0.8);
  border-radius: 8rpx;
  border: 2rpx solid rgba(139, 105, 20, 0.3);
  overflow: hidden;
  position: relative;
}

.progress-bar {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, var(--leaf-light), var(--leaf-green), var(--leaf-light));
  transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  position: relative;
  overflow: hidden;
}

.progress-bar::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.25) 50%,
    transparent 100%
  );
  animation: shimmer 2s infinite;
}

/* 带标签的进度条 */
.progress-with-label {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.progress-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--leaf-light);
  white-space: nowrap;
  min-width: 60rpx;
  text-align: right;
}

/* 大号进度条 */
.progress-large {
  height: 24rpx;
  border-radius: 12rpx;
}

.progress-large .progress-bar {
  border-radius: 10rpx;
}

/* 分段进度条 - 用于成就/等级展示 */
.progress-segment {
  display: flex;
  gap: 6rpx;
  width: 100%;
}

.progress-segment-item {
  flex: 1;
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(45, 74, 62, 0.6);
  border: 1rpx solid rgba(139, 105, 20, 0.2);
  transition: background 0.4s ease;
}

.progress-segment-item.active {
  background: var(--leaf-green);
  border-color: var(--leaf-light);
  box-shadow: 0 0 6rpx rgba(124, 179, 66, 0.3);
}

/* ---------- Overlay / Modal 遮罩与弹窗 ---------- */

/* 半透明遮罩层 - 深森林色调 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(29, 46, 38, 0.70);
  z-index: 1000;
  animation: fadeIn 0.25s ease;
}

/* 底部弹出弹窗 */
.modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(180deg, var(--bg-card) 0%, var(--bg-main) 100%);
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx;
  z-index: 1001;
  animation: slideUp 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  max-height: 80vh;
  overflow-y: auto;
  border-top: 3rpx solid var(--border-solid);
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.3);
}

/* 木纹居中弹窗 - 动森招牌弹窗风格！ */
.modal-wood {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  max-width: 90vw;
  background: linear-gradient(180deg, var(--bg-card) 0%, var(--bg-main) 100%);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  z-index: 1001;
  animation: popIn 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  box-shadow:
    0 20rpx 60rpx rgba(0, 0, 0, 0.4),
    0 0 0 3rpx var(--border-solid),
    0 0 0 6rpx rgba(139, 105, 20, 0.15);
  border: 3rpx solid var(--border-solid);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--cream);
  text-align: center;
  margin-bottom: 16rpx;
}

.modal-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.modal-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(61, 98, 84, 0.6);
  font-size: 28rpx;
  color: var(--text-secondary);
  border: 2rpx solid rgba(139, 105, 20, 0.3);
}

/* ---------- Skeleton / Loading 骨架屏 ---------- */

.skeleton {
  background: rgba(61, 98, 84, 0.4);
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
}

.skeleton::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(174, 213, 129, 0.08) 50%,
    transparent 100%
  );
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

.skeleton-circle {
  border-radius: 50%;
}

.skeleton-line {
  height: 28rpx;
  margin-bottom: 16rpx;
  width: 100%;
}

.skeleton-line:last-child {
  width: 60%;
}

.skeleton-card {
  background: rgba(61, 98, 84, 0.5);
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 16rpx 20rpx;
  border: 2rpx dashed var(--border-dash);
}

/* 加载指示器 */
.loading-spinner {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--leaf-green);
  margin: 0 8rpx;
  animation: pulse 1.2s ease-in-out infinite;
  box-shadow: 0 0 8rpx rgba(124, 179, 66, 0.4);
}

.loading-dot:nth-child(2) {
  animation-delay: 0.2s;
  background: var(--wood-light);
  box-shadow: 0 0 8rpx rgba(218, 165, 32, 0.4);
}

.loading-dot:nth-child(3) {
  animation-delay: 0.4s;
}

.loading-text {
  font-size: 26rpx;
  color: var(--text-muted);
  text-align: center;
  margin-top: 16rpx;
}

/* ---------- Empty State 空状态 ---------- */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
  animation: floatGentle 4s ease-in-out infinite;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-muted);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

/* ---------- 通用工具类 ---------- */

/* 弹性布局 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

/* 间距工具类 */
.gap-8 { gap: 8rpx; }
.gap-12 { gap: 12rpx; }
.gap-16 { gap: 16rpx; }
.gap-20 { gap: 20rpx; }
.gap-24 { gap: 24rpx; }
.gap-32 { gap: 32rpx; }

/* 内边距 */
.p-16 { padding: 16rpx; }
.p-24 { padding: 24rpx; }
.p-32 { padding: 32rpx; }

.px-32 {
  padding-left: 32rpx;
  padding-right: 32rpx;
}

.py-16 {
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

/* 外边距 */
.m-0 { margin: 0; }
.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mb-32 { margin-bottom: 32rpx; }
.ml-auto { margin-left: auto; }

/* 文字对齐 */
.text-center { text-align: center; }
.text-right { text-align: right; }

/* 文字颜色 - 森林主题 */
.text-primary { color: var(--leaf-light); }
.text-primary-dark { color: var(--leaf-green); }
.text-secondary { color: var(--text-secondary); }
.text-muted { color: var(--text-muted); font-size: 24rpx; }
.text-danger { color: #FF8A65; }
.text-accent { color: var(--wood-light); }
.text-cream { color: var(--cream); }
.text-cream-soft { color: var(--cream-soft); }

/* 文字粗细 */
.text-bold { font-weight: 700; }
.text-medium { font-weight: 500; }

/* 文字大小 */
.text-sm { font-size: 24rpx; }
.text-base { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.text-xxl { font-size: 48rpx; }

/* 圆角 - 全部圆润无锐角 */
.radius-12 { border-radius: 12rpx; }
.radius-16 { border-radius: 16rpx; }
.radius-20 { border-radius: 20rpx; }
.radius-24 { border-radius: 24rpx; }
.radius-28 { border-radius: 28rpx; }
.radius-32 { border-radius: 32rpx; }
.radius-40 { border-radius: 40rpx; }
.radius-full { border-radius: 50%; }

/* 背景色 */
.bg-white { background: rgba(255, 255, 255, 0.95); color: var(--bg-deep); }
.bg-page { background-color: var(--bg-deep); }
.bg-card { background-color: var(--bg-card); }
.bg-card-light { background-color: var(--bg-card-light); }
.bg-primary-light { background: rgba(124, 179, 66, 0.12); }
.bg-accent-light { background: rgba(218, 165, 32, 0.12); }

/* 边框 */
.border-bottom { border-bottom: 1rpx solid rgba(139, 105, 20, 0.2); }
.border-top { border-top: 1rpx solid rgba(139, 105, 20, 0.2); }

/* 文本溢出省略 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  text-overflow: ellipsis;
}

/* 定位 */
.relative { position: relative; }
.absolute { position: absolute; }

/* 宽高 */
.w-full { width: 100%; }
.h-full { height: 100%; }

/* 动画工具类 */
.animate-float { animation: floatGentle 3s ease-in-out infinite; }
.animate-fadeIn { animation: fadeIn 0.4s ease; }
.animate-slideUp { animation: fadeInUp 0.4s cubic-bezier(0.22, 1, 0.36, 1); }
.animate-popIn { animation: popIn 0.4s cubic-bezier(0.22, 1, 0.36, 1); }
.animate-breathe { animation: breathe 3s ease-in-out infinite; }
.animate-sway { animation: sway 4s ease-in-out infinite; }
.animate-sparkle { animation: sparkle 2s ease-in-out infinite; }

/* 点击反馈 */
.clickable {
  opacity: 1;
  transition: opacity 0.2s;
}

.clickable:active {
  opacity: 0.7;
}

/* 分隔线 - 森林风格 */
.divider {
  height: 1rpx;
  background: rgba(139, 105, 20, 0.2);
  margin: 24rpx 20rpx;
}

.divider-text {
  display: flex;
  align-items: center;
  color: var(--text-muted);
  font-size: 24rpx;
  margin: 32rpx 0;
}

.divider-text::before,
.divider-text::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: rgba(139, 105, 20, 0.2);
}

.divider-text::before { margin-right: 24rpx; }
.divider-text::after { margin-left: 24rpx; }

/* 安全区域适配 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom, 0);
}

/* 隐藏滚动条 */
.hide-scrollbar::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

/* ---------- 全局基础重置样式 ---------- */

/* 移除微信小程序默认按钮样式 */
button {
  padding: 0;
  margin: 0;
  background: none;
  line-height: 1.4;
  color: inherit;
}

button::after {
  border: none;
}

/* 输入框统一样式重置 */
input,
textarea {
  border: none;
  outline: none;
  background: transparent;
  color: var(--cream);
}

input::placeholder,
textarea::placeholder {
  color: var(--text-muted);
}

/* 图片块级化 */
image {
  display: block;
}
