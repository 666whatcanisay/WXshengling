/* Pet Preview — Pipeline 验收页样式 */

.preview-page {
  min-height: 100vh;
  background: #1a2e23;
}

/* ===== 加载态 ===== */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60vh;
}
.loading-text {
  color: #7ED6A7;
  font-size: 28rpx;
}

/* ===== 主滚动区 ===== */
.preview-scroll {
  height: 100vh;
}
.preview-inner {
  padding: 20rpx 24rpx;
}
.portrait-gallery-link { margin-bottom: 18rpx; padding: 18rpx; color: #edca83; text-align: center; }

/* ===== 头部 ===== */
.preview-header {
  text-align: center;
  padding: 30rpx 0 24rpx;
}
.preview-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #E8F5E9;
  margin-bottom: 12rpx;
}
.preview-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.stat-item {
  font-size: 24rpx;
  color: #A5D6A7;
}
.stat-divider {
  color: #4a6b5a;
  font-size: 22rpx;
}
.stat-highlight {
  color: #FFD700;
  font-weight: bold;
}
.preview-hint {
  display: block;
  font-size: 22rpx;
  color: #6b8f75;
  margin-top: 8rpx;
}

/* ===== 分类Tab ===== */
.category-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
  justify-content: center;
  flex-wrap: wrap;
}
.cat-tab {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
  background: rgba(255,255,255,0.06);
  border: 2rpx solid rgba(255,255,255,0.1);
  transition: all 0.2s;
}
.cat-tab-active {
  background: rgba(126,214,167,0.15);
  border-color: #7ED6A7;
}
.cat-tab-active .cat-tab-name,
.cat-tab-active .cat-tab-count {
  color: #E8F5E9;
}
.cat-tab-icon {
  font-size: 28rpx;
}
.cat-tab-name {
  font-size: 26rpx;
  color: #a5c4ab;
}
.cat-tab-count {
  font-size: 20rpx;
  color: #6b8f75;
  background: rgba(0,0,0,0.2);
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
}

/* ===== 物种行 ===== */
.species-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.species-row {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.05);
  border-radius: 20rpx;
  padding: 20rpx 16rpx;
  border: 1rpx solid rgba(255,255,255,0.08);
  gap: 12rpx;
}

/* ===== 物种信息列 ===== */
.species-info-cell {
  width: 140rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding-right: 12rpx;
  border-right: 2rpx solid rgba(255,255,255,0.08);
}
.species-icon-lg {
  font-size: 44rpx;
}
.species-name-lg {
  font-size: 26rpx;
  color: #E8F5E9;
  font-weight: bold;
  text-align: center;
}
.species-id-sm {
  font-size: 18rpx;
  color: #6b8f75;
  text-align: center;
}

/* ===== 阶段图片列 ===== */
.stage-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  min-width: 0;
}
.stage-image-wrap {
  width: 140rpx;
  height: 140rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 2rpx solid rgba(255,255,255,0.08);
  transition: border-color 0.2s;
}
.stage-image-wrap:active {
  border-color: #7ED6A7;
}
.stage-image {
  width: 120rpx;
  height: 120rpx;
}
.stage-label {
  font-size: 22rpx;
  color: #a5d6a7;
  text-align: center;
}
.stage-key-sm {
  font-size: 18rpx;
  color: #5a7a64;
  text-align: center;
}

/* ===== 底部间距 ===== */
.preview-bottom-space {
  height: 80rpx;
}
