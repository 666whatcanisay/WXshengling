/* ========== 反馈页 - 动森森林主题样式 ========== */

/* 页面容器 */
.page-container {
  min-height: 100vh;
  background: #2D4A3E;
  padding: 30rpx 24rpx;
  box-sizing: border-box;
}

/* ---------- 木纹标题栏 ---------- */
.wood-title {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background: linear-gradient(135deg, #8B6914, #B8860B);
  border-radius: 50rpx;
  margin-bottom: 28rpx;
  gap: 16rpx;
}
.title-icon {
  font-size: 28rpx;
}
.title-text {
  color: #F5E6C8;
  font-size: 34rpx;
  font-weight: bold;
}

/* ---------- 实边卡片 ---------- */
.card-solid {
  background: rgba(61,98,84,0.7);
  border: 3rpx solid #8B6914;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

/* 表单区块 */
.form-section {
  margin-bottom: 24rpx;
}
.form-label {
  display: block;
  font-size: 27rpx;
  color: #F5E6C8;
  font-weight: bold;
  margin-bottom: 12rpx;
}

/* 类型选择芯片 */
.type-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.type-chip {
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  font-size: 25rpx;
  color: #C4B89A;
  background: rgba(74,115,97,0.35);
  border: 2rpx solid transparent;
  transition: all 0.2s;
}
.chip-active {
  background: linear-gradient(135deg, #8B6914, #B8860B);
  color: #F5E6C8;
  border-color: #DAA520;
  font-weight: bold;
}

/* 输入框 */
.wood-input {
  width: 100%;
  height: 86rpx;
  background: rgba(45,74,62,0.5);
  border: 2rpx solid rgba(139,105,20,0.3);
  border-radius: 18rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 27rpx;
  color: #F5E6C8;
}
.input-placeholder {
  color: #8B9A7D;
  font-size: 26rpx;
}

/* 文本域 */
.wood-textarea {
  width: 100%;
  min-height: 200rpx;
  background: rgba(45,74,62,0.5);
  border: 2rpx solid rgba(139,105,20,0.3);
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 27rpx;
  color: #F5E6C8;
  line-height: 1.6;
}
.textarea-placeholder {
  color: #8B9A7D;
  font-size: 26rpx;
}
.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #8B9A7D;
  margin-top: 8rpx;
}

/* 提交按钮 */
.btn-wood {
  width: 100%;
  height: 86rpx;
  line-height: 86rpx;
  text-align: center;
  background: linear-gradient(135deg, #8B6914, #B8860B) !important;
  color: #F5E6C8 !important;
  border-radius: 43rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none !important;
  margin-top: 16rpx;
}

/* ---------- 引用悬浮卡（提示）---------- */
.quote-card {
  position: relative;
  background: rgba(74,115,97,0.5);
  border-radius: 22rpx;
  padding: 22rpx 22rpx 22rpx 30rpx;
  overflow: hidden;
}
.quote-bar {
  position: absolute;
  left: 0;
  top: 18rpx;
  bottom: 18rpx;
  width: 6rpx;
  background: #7CB342;
  border-radius: 0 4rpx 4rpx 0;
}
.quote-content {
  position: relative;
  z-index: 1;
}
.tip-title {
  display: block;
  font-size: 26rpx;
  color: #AED581;
  font-weight: bold;
  margin-bottom: 8rpx;
}
.tip-body {
  display: block;
  font-size: 25rpx;
  color: #E8D9BB;
  line-height: 1.65;
}
