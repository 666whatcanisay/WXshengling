<view class="page">
  <!-- ===== 新手引导遮罩（木纹风格） ===== -->
  <view wx:if="{{showTutorial}}" class="tutorial-overlay">
    <view class="tutorial-modal-wood">
      <text class="tutorial-icon">{{tutorialSteps[tutorialStep].icon}}</text>
      <text class="tutorial-title">{{tutorialSteps[tutorialStep].title}}</text>
      <text class="tutorial-desc">{{tutorialSteps[tutorialStep].desc}}</text>
      <view class="tutorial-dots">
        <view wx:for="{{tutorialSteps}}" wx:key="index" class="tutorial-dot {{index === tutorialStep ? 'active' : ''}}"></view>
      </view>
      <view class="tutorial-actions">
        <button class="btn-wood" bindtap="skipTutorial">跳过</button>
        <button class="btn-leaf" bindtap="nextTutorialStep">
          {{tutorialStep < tutorialSteps.length - 1 ? '下一步' : '开始成长之旅！'}}
        </button>
      </view>
    </view>
  </view>

  <!-- ===== 页面内容 ===== -->
  <scroll-view scroll-y class="page-scroll" enhanced show-scrollbar="{{false}}">
    <view class="page-inner">

      <!-- 1. 木纹标题栏 -->
      <view class="wood-title">
        <text class="leaf-icon-left">🌿</text>
        <text class="wood-title-text">AI自律森林</text>
        <text class="leaf-icon-right">🌿</text>
      </view>

      <!-- 2. 问候区卡片 -->
      <view class="card greeting-card">
        <view class="greeting-row">
          <text class="greeting-time">{{greeting}} ☀️</text>
          <text class="greeting-name">{{user.nickname || user.username || '小伙伴'}}</text>
        </view>
        <view class="greeting-streak">
          <text class="streak-text">今天是你坚持成长的第 {{todayGrowth.streakDays}} 天</text>
          <text class="camp-deco">🌲 🌿 ✨</text>
        </view>
      </view>

      <!-- 3. 宠物轮播区（原生swiper，支持手滑） -->
      <view wx:if="{{displayPets.length > 0}}" class="pet-carousel">
        <!-- 轮播指示点 -->
        <view class="carousel-dots" wx:if="{{displayPets.length > 1}}">
          <view
            wx:for="{{displayPets}}"
            wx:key="_id"
            class="carousel-dot {{homeSwiperIndex === index ? 'dot-active' : ''}}"
            data-index="{{index}}"
            bindtap="switchHomePet"
          ></view>
        </view>

        <!-- 原生swiper轮播（支持左右滑动） -->
        <swiper
          class="pet-swiper"
          current="{{homeSwiperIndex}}"
          bindchange="onHomeSwiperChange"
          circular="{{true}}"
          duration="{{300}}"
          previous-margin="20rpx"
          next-margin="20rpx"
        >
          <swiper-item wx:for="{{displayPets}}" wx:key="_id" wx:for-item="dp">
            <view class="card-solid pet-hero-card" bindtap="goPets">

              <!-- 宠物浮动区域 -->
              <view class="pet-float-area">
                <view class="pet-glow-ring" style="border: 4rpx solid {{dp.rarityColor}};"></view>
                <view class="pet-emoji-wrap {{petStatusClass}}">
                  <text class="pet-emoji-large">{{dp.emoji}}</text>
                </view>
              </view>
              <!-- 宠物名字 + 稀有度标签 -->
              <view class="pet-name-row">
                <text class="pet-display-name">{{dp.name}}</text>
                <view wx:if="{{dp.rarityName}}" class="rarity-tag" style="background:{{dp.rarityColor}};">
                  <text>{{dp.rarityName}}</text>
                </view>
              </view>
              <!-- 对话气泡 -->
              <view class="quote-card pet-speech">
                <text class="quote-accent">💬</text>
                <text class="quote-text">{{dp.talk}}</text>
              </view>
              <!-- 状态/蛋阶段徽章 -->
              <view wx:if="{{dp.isEgg}}" class="status-badge status-normal">
                <text>🥚 孵化中 · {{dp.growthPercent}}%</text>
              </view>
              <view wx:else class="status-badge status-normal">
                <text>{{dp.statusText}}</text>
              </view>

              <!-- 已孵化：成长阶段进度 -->
              <view wx:if="{{!dp.isEgg && dp.stageProgress}}" class="xp-bar-wood" style="margin-top:12rpx;">
                <view class="xp-fill-leaf" style="width:{{dp.stageProgress.percent}}%"></view>
              </view>
              <view wx:if="{{!dp.isEgg && dp.stageProgress}}" class="xp-info-row" style="justify-content:center;">
                <text class="xp-percent-text">{{dp.stageProgress.currentStage}} {{dp.stageProgress.percent}}%</text>
                <text wx:if="{{dp.stageProgress.nextStage}}" class="xp-remain-text">→ {{dp.stageProgress.nextStage}}</text>
              </view>

            </view>
          </swiper-item>
        </swiper>
      </view>

      <!-- 无宠物时有 activePet 但 displayPets 未加载完成 → 保留旧版兜底 -->
      <view wx:elif="{{activePet && displayPets.length === 0}}" class="card-solid pet-hero-card" bindtap="goPets">
        <!-- 宠物浮动区域 -->
        <view class="pet-float-area">
          <view class="pet-glow-ring"></view>
          <view class="pet-emoji-wrap {{petStatusClass}}">
            <text class="pet-emoji-large">{{petEmoji}}</text>
          </view>
        </view>
        <!-- 宠物名字 -->
        <text class="pet-display-name">{{activePet.name}}</text>
        <!-- 对话气泡 -->
        <view class="quote-card pet-speech">
          <text class="quote-accent">💬</text>
          <text class="quote-text">{{petTalk}}</text>
        </view>
        <!-- 状态/蛋阶段徽章 -->
        <view wx:if="{{isEgg}}" class="status-badge status-normal">
          <text>🥚 孵化中 · {{activePet.growth_value >= 100 ? 100 : activePet.growth_value}}%</text>
        </view>
        <view wx:else class="status-badge status-{{activePet.status}}">
          <text>{{petStatusText}} {{activePet.status === 'happy' ? '😊' : activePet.status === 'normal' ? '😐' : '😢'}}</text>
        </view>
      </view>

      <!-- 4. 成长进度（真实经验条：基于 growth_value） -->
      <view wx:if="{{activePet}}" class="card level-section">
        <view class="wood-title-mini">
          <text wx:if="{{activePet.stageProgress.nextStage}}">🌳 {{activePet.stageProgress.currentStage}} → {{activePet.stageProgress.nextStage}}</text>
          <text wx:else>🌳 {{activePet.stageProgress.currentStage}}</text>
        </view>
        <view class="xp-bar-wood">
          <view class="xp-fill-leaf" style="width:{{activePet.stageProgress.percent}}%"></view>
        </view>
        <view class="xp-info-row">
          <text class="xp-percent-text">{{activePet.stageProgress.percent}}%</text>
          <text class="xp-remain-text">总成长值 {{activePet.stageProgress.growthValue}} · 还需{{activePet.stageProgress.growthNeeded}}</text>
        </view>
      </view>

      <!-- 5. 今日任务 -->
      <view class="card quest-section">
        <view class="section-title-row">
          <text class="section-title-leaf">🎋 今日任务</text>
        </view>
        <view wx:for="{{todayTasks}}" wx:key="id"
              class="task-row-wood {{item.completed ? 'done' : ''}}"
              data-id="{{item.id}}"
              bindtap="quickCheckin">
          <view class="wood-checkbox {{item.completed ? 'checked' : ''}}">
            <text wx:if="{{item.completed}}" class="check-mark">✓</text>
          </view>
          <text class="task-label {{item.completed ? 'task-done' : ''}}">{{item.title}}</text>
          <view class="xp-chip {{item.completed ? 'chip-done' : ''}}">
            <text>+{{item.xp_reward}}XP</text>
          </view>
        </view>
        <view class="quest-footer">
          <text class="quest-summary">完成 {{todayGrowth.completedTasks}}/{{todayGrowth.totalTasks}}</text>
        </view>
      </view>

      <!-- 6. 每日签到（实边卡片） -->
      <view class="card-solid signin-section" bindtap="dailySignIn">
        <view class="signin-header">
          <text class="signin-fire">{{signedIn ? '✅' : '🔥'}}</text>
          <text class="signin-label">{{signedIn ? '今日已签到' : '每日签到'}}</text>
        </view>
        <view wx:if="{{!signedIn}}" class="signin-btn-wrap">
          <view class="btn-leaf signin-btn">签到 +10XP</view>
        </view>
        <view class="signin-streak-row">
          <text class="streak-flame">🔥</text>
          <text class="streak-num">连续 {{signInDays}} 天</text>
        </view>
      </view>

      <!-- 7. 今日成长 -->
      <view class="card growth-section">
        <view class="section-title-row">
          <text class="section-title-leaf">🌱 今日成长</text>
        </view>
        <view class="growth-stats-row">
          <view class="growth-stat-block">
            <text class="growth-stat-val">+{{todayGrowth.xp}}</text>
            <text class="growth-stat-lbl">经验</text>
          </view>
          <view class="growth-divider-line"></view>
          <view class="growth-stat-block">
            <text class="growth-stat-val">{{todayGrowth.streakDays}}天</text>
            <text class="growth-stat-lbl">连续打卡</text>
          </view>
        </view>
      </view>

      <!-- 8. AI 鼓励（引用悬浮卡片） -->
      <view wx:if="{{encouragement}}" class="quote-card encouragement-quote">
        <text class="quote-accent">✨</text>
        <text class="quote-text">{{encouragement.text}}</text>
        <view class="encourage-badge">
          <text>你已经超过了 {{todayGrowth.completionRate}}% 的营友</text>
        </view>
      </view>

      <!-- 9. 快速心情 -->
      <view class="card mood-section">
        <view class="section-title-row">
          <text class="section-title-leaf">🌸 今日心情</text>
          <text class="mood-done-tag" wx:if="{{moodSubmitted}}">已记录 ✓</text>
        </view>
        <view class="mood-grid">
          <view wx:for="{{moods}}" wx:key="index"
                class="mood-chip {{selectedMood === index ? 'mood-selected' : ''}}"
                data-mood="{{index}}"
                bindtap="selectMood">
            <text>{{item}}</text>
          </view>
        </view>
      </view>

      <!-- 底部留白 -->
      <view class="bottom-spacer"></view>

    </view>
  </scroll-view>

  <!-- 右下角悬浮客服按钮（始终可见） -->
  <button class="cs-float-btn" open-type="contact" session-from="home_float" hover-class="cs-float-hover">
    <text class="cs-float-icon">💬</text>
  </button>
</view>
