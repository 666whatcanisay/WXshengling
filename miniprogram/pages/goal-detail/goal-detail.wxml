<!-- 目标详情 - 动森森林风格 -->
<view class="page">
  <scroll-view scroll-y class="page-scroll" enhanced show-scrollbar="{{false}}" scroll-into-view="{{taskAnchor}}">
    <view class="page-inner">

    <!-- 木纹标题栏 -->
    <view class="wood-title">
      <text class="title-icon">{{goal.emoji || '🎯'}}</text>
      <text class="title-text">{{goal.title}}</text>
      <text class="title-icon">{{goal.emoji || '🎯'}}</text>
    </view>

  <!-- 目标信息卡片 -->
  <view class="card-solid goal-info-card">
    <!-- 顶部：emoji + 状态 + 天数 -->
    <view class="goal-hero-row">
      <view class="goal-emoji-lg">{{goal.emoji || '🎯'}}</view>
      <view class="goal-hero-info">
        <view class="meta-tag status-{{goal.status}}">{{goal.statusLabel}}</view>
        <text class="goal-days">📅 {{goal.target_days}}天目标</text>
      </view>
    </view>

    <!-- 描述 -->
    <text class="goal-desc-text">{{goal.description}}</text>
    <view class="goal-progress-row">
      <text class="progress-label">所选日期进度</text>
      <text class="progress-val">{{completedTaskCount}}/{{tasks.length}}</text>
    </view>
    <view class="progress-bar-wrap">
      <view class="progress-bar-fill" style="width: {{tasks.length > 0 ? (completedTaskCount / tasks.length * 100) : 0}}%"></view>
    </view>
  </view>

  <!-- 筛选与排序工具栏 -->
  <picker mode="date" value="{{selectedDate}}" bindchange="onTaskDateChange">
    <view class="date-selector">任务日期　{{selectedDate}}　选择日期</view>
  </picker>
  <view class="toolbar">
    <view class="tool-group">
      <text
        wx:for="{{['all','completed','pending']}}"
        wx:key="*this"
        class="tool-chip {{filter === item ? 'tool-active' : ''}}"
        bindtap="setFilter"
        data-filter="{{item}}"
      >{{item === 'all' ? '全部' : (item === 'completed' ? '已完成' : '未完成')}}</text>
    </view>
    <view class="tool-group">
      <text
        class="tool-chip {{sortBy === 'date' ? 'tool-active' : ''}}"
        bindtap="setSort"
        data-sort="date"
      >按日期</text>
      <text
        class="tool-chip {{sortBy === 'xp' ? 'tool-active' : ''}}"
        bindtap="setSort"
        data-sort="xp"
      >按经验</text>
    </view>
  </view>

  <!-- 任务列表 -->
  <text wx:if="{{focusMissing && !loading && !loadError}}" class="empty-tasks">原任务已移出这一天，可以重新查看待办。</text>
  <view class="task-list">
    <view
      wx:for="{{filteredTasks}}"
      wx:key="id"
      id="goal-task-{{index}}"
      class="task-card card {{item.completed ? 'task-done' : ''}} {{focusedTask === item.id ? 'task-focused' : ''}}"
    >
      <view class="task-main">
        <view
          class="check-circle {{item.completed ? 'checked' : ''}}"
          bindtap="checkinTask"
          data-id="{{item.id}}"
        >
          <text wx:if="{{item.completed}}" class="check-icon">✓</text>
        </view>
        <view class="task-info">
          <view class="task-description">
          <text class="task-title {{item.completed ? 'done-text' : ''}}">{{item.title}}</text>
          <text wx:if="{{item.estimated_minutes}}" class="task-duration">{{item.estimated_minutes}}分钟 · 阶段{{item.stage || 1}}</text>
          </view>
          <text wx:if="{{!goalClosed || item.completed}}" class="task-xp-reward">+{{item.xp_reward}} XP ⭐</text>
          <text wx:else class="task-duration">未完成</text>
        </view>
      </view>
    </view>
  </view>
  <text wx:if="{{accountChanged}}" class="empty-tasks">登录状态已变化，请返回目标页重新打开。</text>
  <text wx:elif="{{loadError}}" class="empty-tasks" bindtap="retryLoad">加载失败，点击重试</text>
  <text wx:elif="{{!loading && !filteredTasks.length}}" class="empty-tasks">这一天还没有符合条件的任务</text>

  <text wx:if="{{goalClosed}}" class="empty-tasks">目标已结束，任务记录仍可查看</text>
  <text wx:if="{{taskCreationStorageError && !showAdd}}" class="empty-tasks">{{taskCreationStorageError}}</text>
  <button wx:if="{{taskCreationPending || taskCreationStorageError || (goal && !goalClosed && !loadError)}}" class="btn-wood add-task-btn" bindtap="showAddTask">{{taskCreationPending ? '继续确认上次添加' : (taskCreationStorageError ? '重读本机记录' : '➕ 添加新任务')}}</button>

  <!-- 底部操作区 -->
  <view wx:if="{{goal && !goalClosed && !loadError}}" class="bottom-actions">
    <button class="complete-btn" bindtap="completeGoal" disabled="{{closingGoal}}">✅ 完成目标</button>
    <button class="abandon-btn" bindtap="abandonGoal" disabled="{{closingGoal}}">🚫 放弃目标</button>
  </view>

  <!-- 打卡结果弹窗 -->
  <view wx:if="{{result}}" class="modal-overlay" bindtap="closeResult">
    <view class="result-popup wood-frame" catchtap>
      <text class="result-icon">🎉</text>
      <text class="result-title">打卡成功！</text>
      <view class="result-details">
        <view class="rd-item">
          <text class="rd-key">基础经验</text>
          <text class="rd-val">+{{result.xp_added}} XP</text>
        </view>
        <view class="rd-item">
          <text class="rd-key">连续奖励</text>
          <text class="rd-val bonus">+{{result.streak_bonus}} XP 🔥</text>
        </view>
        <view class="rd-divider"></view>
        <view class="rd-item rd-total">
          <text class="rd-key">总计获得</text>
          <text class="rd-val total-xp">+{{result.total_xp}} XP ✨</text>
        </view>
      </view>
      <button class="btn-leaf result-close" bindtap="closeResult">太棒了！</button>
    </view>
  </view>

  <!-- 添加任务弹窗 -->
  <view wx:if="{{showAdd}}" class="modal-overlay" bindtap="cancelAdd">
    <view class="add-popup wood-frame" catchtap>
      <text class="add-title">{{taskCreationPending ? '确认上次添加' : '➕ 新增任务'}}</text>
      <text wx:if="{{taskCreationPending}}" class="empty-tasks">任务日期 {{taskCreationDate}}。继续确认会使用原请求。</text>
      <text wx:if="{{taskCreationStorageError}}" class="empty-tasks">{{taskCreationStorageError}}</text>
      <input
        class="add-input"
        placeholder="输入任务名称..."
        placeholder-class="add-placeholder"
        value="{{taskTitle}}"
        maxlength="200"
        disabled="{{taskCreationPending || submittingTask}}"
        bindinput="onTaskTitle"
      />
      <view class="section-title-inline" style="margin-top:16rpx;">选择经验值</view>
      <view class="xp-options">
        <view
          wx:for="{{[10,20,30,50]}}"
          wx:key="*this"
          class="xp-opt {{taskXp === item ? 'xp-selected' : ''}}"
          bindtap="selectTaskXp"
          data-xp="{{item}}"
        >+{{item}} XP</view>
      </view>
      <view class="add-btns">
        <button class="btn-cancel" bindtap="cancelAdd" disabled="{{submittingTask}}">{{taskCreationPending ? '稍后确认' : '取消'}}</button>
        <button class="btn-leaf" bindtap="submitTask" disabled="{{submittingTask}}" loading="{{submittingTask}}">{{taskCreationPending ? '继续确认' : '确认添加'}}</button>
      </view>
    </view>
  </view>

    </view>
  </scroll-view>
</view>
