/* ========== 目标详情 - 动森森林主题样式 ========== */

/* 页面容器 */
.page {
  min-height: 100vh;
  background: radial-gradient(ellipse at center top, #355447 0%, #2D4A3E 70%);
}
.page-scroll { height: 100vh; }
.page-inner { max-width: 720rpx; margin: 0 auto; padding: 20rpx 24rpx 150rpx; box-sizing: border-box; }

/* ---------- 木纹标题栏 ---------- */
.wood-title {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #8B6914, #B8860B);
  border-radius: 50rpx;
  margin-bottom: 24rpx;
  gap: 14rpx;
  padding: 14rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.25);
}
.title-icon { font-size: 28rpx; }
.title-text {
  color: #F5E6C8; font-size: 30rpx; font-weight: 800; letter-spacing: 1px;
}

/* ---------- 实边/虚线卡片 ---------- */
.card-solid {
  background: rgba(61,98,84,0.7);
  border: 3rpx solid #8B6914;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 22rpx;
}
.card {
  background: rgba(61,98,84,0.55);
  border: 2rpx dashed rgba(165,190,140,0.35);
  border-radius: 22rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 14rpx;
}

/* ---------- 目标信息卡 ---------- */
.goal-info-card { overflow: hidden; }

/* 目标英雄行：大emoji + 状态信息 */
.goal-hero-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx dashed rgba(184,134,11,0.2);
}
.goal-emoji-lg {
  font-size: 64rpx;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(124,179,66,0.12);
  border-radius: 24rpx;
  border: 2rpx solid rgba(124,179,66,0.25);
  flex-shrink: 0;
}
.goal-hero-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.goal-meta-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 12rpx;
}
.meta-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: bold;
}
.status-doing { color: #AED581; background: rgba(124,179,66,0.2); }
.status-done { color: #FFD700; background: rgba(255,215,0,0.15); }
.status-todo { color: #C4B89A; background: rgba(196,184,154,0.15); }
.status-abandoned { color: #8B9A7D; background: rgba(139,154,125,0.2); }
.goal-days {
  font-size: 23rpx;
  color: #C4B89A;
}
.goal-desc-text {
  font-size: 26rpx;
  color: #E8D9BB;
  line-height: 1.6;
  display: block;
  margin-bottom: 18rpx;
}

/* 进度条 */
.goal-progress-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.progress-label {
  font-size: 24rpx;
  color: #C4B89A;
}
.progress-val {
  font-size: 24rpx;
  color: #F5E6C8;
  font-weight: bold;
}
.progress-bar-wrap {
  width: 100%;
  height: 14rpx;
  background: rgba(45,74,62,0.5);
  border-radius: 7rpx;
  overflow: hidden;
}
.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #7CB342, #AED581);
  border-radius: 7rpx;
  transition: width 0.3s;
}

/* ---------- 工具栏 ---------- */
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  gap: 12rpx;
}
.tool-group {
  display: flex;
  gap: 10rpx;
}
.tool-chip {
  font-size: 23rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  color: #C4B89A;
  background: rgba(74,115,97,0.35);
  border: 1rpx solid transparent;
}
.tool-active {
  background: linear-gradient(135deg, #8B6914, #B8860B);
  color: #F5E6C8;
  border-color: #DAA520;
  font-weight: bold;
}

/* ---------- 任务列表 ---------- */
.task-list {
  margin-bottom: 20rpx;
}
.task-done {
  opacity: 0.65;
}
.task-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.check-circle {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(139,105,20,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.25s;
}
.check-circle.checked {
  background: #7CB342;
  border-color: #7CB342;
}
.check-icon {
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
}
.task-info {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.task-title {
  font-size: 27rpx;
  color: #F5E6C8;
  font-weight: 500;
}
.done-text {
  text-decoration: line-through;
  color: #8B9A7D;
}
.task-xp-reward {
  font-size: 22rpx;
  color: #DAA520;
  font-weight: bold;
  flex-shrink: 0;
}

/* ---------- 按钮 ---------- */
.btn-wood {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: linear-gradient(135deg, #8B6914, #B8860B) !important;
  color: #F5E6C8 !important;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: bold;
  border: none !important;
  margin-bottom: 16rpx;
}
.btn-leaf {
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #7CB342 !important;
  color: #fff !important;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none !important;
}
.add-task-btn {
  margin-top: 10rpx;
}

/* 底部操作 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: #2D4A3E;
  border-top: 2rpx solid rgba(139,105,20,0.3);
}
.abandon-btn {
  width: 100% !important;
  height: 76rpx !important;
  line-height: 76rpx !important;
  text-align: center;
  background: rgba(255,107,107,0.15) !important;
  color: #FF6B6B !important;
  border: 2rpx solid rgba(255,107,107,0.3) !important;
  border-radius: 38rpx !important;
  font-size: 28rpx !important;
}

/* ---------- 弹窗通用 ---------- */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(45,74,62,0.85);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}
.wood-frame {
  width: 100%;
  max-width: 600rpx;
  background: #355447;
  border: 4rpx solid #8B6914;
  border-radius: 28rpx;
  overflow: hidden;
  padding: 36rpx 28rpx;
}

/* ---------- 结果弹窗 ---------- */
.result-icon {
  font-size: 64rpx;
  display: block;
  text-align: center;
  margin-bottom: 12rpx;
}
.result-title {
  font-size: 34rpx;
  color: #F5E6C8;
  font-weight: bold;
  display: block;
  text-align: center;
  margin-bottom: 24rpx;
}
.result-details {
  background: rgba(74,115,97,0.3);
  border-radius: 18rpx;
  padding: 18rpx;
  margin-bottom: 24rpx;
}
.rd-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}
.rd-key {
  font-size: 25rpx;
  color: #C4B89A;
}
.rd-val {
  font-size: 26rpx;
  color: #F5E6C8;
  font-weight: bold;
}
.bonus { color: #FFAB40; }
.rd-divider {
  height: 1rpx;
  background: dashed rgba(165,190,140,0.2);
  margin: 6rpx 0;
}
.rd-total .rd-key {
  font-weight: bold;
  color: #F5E6C8;
}
.total-xp {
  color: #FFD700 !important;
  font-size: 30rpx !important;
}
.result-close {
  width: 100% !important;
}

/* ---------- 添加任务弹窗 ---------- */
.add-title {
  font-size: 32rpx;
  color: #F5E6C8;
  font-weight: bold;
  display: block;
  text-align: center;
  margin-bottom: 22rpx;
}
.add-input {
  width: 100%;
  height: 80rpx;
  background: rgba(45,74,62,0.5);
  border: 2rpx solid rgba(139,105,20,0.3);
  border-radius: 18rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 27rpx;
  color: #F5E6C8;
  margin-bottom: 10rpx;
}
.add-placeholder {
  color: #8B9A7D;
  font-size: 27rpx;
}
.xp-options {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.xp-opt {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 16rpx;
  font-size: 25rpx;
  color: #C4B89A;
  background: rgba(74,115,97,0.3);
  border: 2rpx solid transparent;
}
.xp-selected {
  background: rgba(218,165,32,0.2);
  border-color: #DAA520;
  color: #FFAB40;
  font-weight: bold;
}
.add-btns {
  display: flex;
  gap: 16rpx;
}
.btn-cancel {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: rgba(139,154,125,0.2) !important;
  color: #C4B89A !important;
  border-radius: 36rpx !important;
  font-size: 28rpx !important;
  border: none !important;
}
.add-btns .btn-leaf {
  flex: 1;
}

/* 区块内联标题 */
.section-title-inline {
  font-size: 26rpx;
  color: #F5E6C8;
  font-weight: bold;
  margin-bottom: 12rpx;
}
.section-title {
  font-size: 28rpx;
  color: #F5E6C8;
  margin: 30rpx 0 16rpx;
  padding-left: 10rpx;
}
