/* ===== AI 伙伴小屋 - 全功能版样式 ===== */

/* 页面基础 */
.page { min-height: 100vh; background: radial-gradient(ellipse at center top, #355447 0%, #2D4A3E 70%); }
.page-scroll { height: 100vh; }
.page-inner, .menu-container, .mode-container { max-width: 720rpx; margin: 0 auto; padding: 20rpx 24rpx 150rpx; box-sizing: border-box; }

/* 返回按钮 - 木纹风格 */
.back-bar {
  display: flex; align-items: center; gap: 10rpx;
  padding: 14rpx 28rpx;
  background: linear-gradient(135deg, rgba(139,105,20,0.3), rgba(184,134,11,0.2));
  border: 2rpx solid rgba(139,105,20,0.35);
  border-radius: 999rpx;
  margin-bottom: 16rpx;
  width: fit-content;
}
.back-bar:active { transform: scale(0.96); opacity: 0.85; }
.back-icon { font-size: 30rpx; }
.back-text { font-size: 25rpx; color: #F5E6C8; font-weight: 600; }

/* 顶部操作行：返回按钮 + 生成计划按钮 */
.top-bar-row {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 16rpx;
  gap: 16rpx;
}

/* 生成计划按钮（顶部右侧） */
.plan-gen-top-btn {
  display: flex; align-items: center; gap: 6rpx;
  padding: 14rpx 24rpx;
  background: linear-gradient(135deg, #7CB342, #558B2F);
  border-radius: 999rpx;
  box-shadow: 0 4rpx 14rpx rgba(124,179,66,0.35);
  flex-shrink: 0;
}
.plan-gen-top-btn:active { transform: scale(0.94); opacity: 0.85; }
.plan-gen-top-icon { font-size: 26rpx; }
.plan-gen-top-text { font-size: 24rpx; color: #fff; font-weight: 700; }

/* 测试按钮组 */

/* ===== 分区标签 ===== */
.section-label {
  font-size: 24rpx; color: #AED581; letter-spacing: 4px;
  margin: 28rpx 0 14rpx; padding-left: 8rpx;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.3);
}

/* ===== AI 网格布局（紧凑排列：每行 3 个） ===== */
.ai-grid {
  display: flex; flex-wrap: wrap; gap: 14rpx;
  padding: 0 4rpx;
}
.ai-grid-item {
  width: calc((100% - 28rpx) / 3);  /* 3列均分 */
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 22rpx 8rpx 18rpx;
  background: linear-gradient(145deg, rgba(74,115,97,0.55), rgba(61,98,84,0.45));
  border: 2rpx solid rgba(139,105,20,0.3);
  border-radius: 22rpx;
  box-sizing: border-box;
  transition: transform 0.15s, box-shadow 0.15s;
}
.ai-grid-item:active {
  transform: scale(0.94);
  box-shadow: 0 0 20rpx rgba(124,179,66,0.25);
}
.ai-grid-icon {
  font-size: 44rpx;
  margin-bottom: 10rpx;
}
.ai-grid-name {
  font-size: 22rpx; font-weight: 600;
  color: #F5E6C8;
  text-align: center;
  line-height: 1.3;
}

/* ===== 模式描述文字（详情页内显示） ===== */
.mode-desc {
  display: block; font-size: 23rpx; color: #A89978;
  line-height: 1.6; margin-bottom: 22rpx;
  padding: 16rpx 20rpx;
  background: rgba(45,74,62,0.35);
  border-radius: 16rpx;
  border-left: 4rpx solid rgba(124,179,66,0.4);
}

/* ===== 木纹标题栏 ===== */
.wood-title {
  display: flex; align-items: center; justify-content: center; gap: 16rpx;
  background: linear-gradient(135deg, #8B6914, #B8860B);
  border-radius: 50rpx; padding: 16rpx 44rpx; margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.28);
}
.wood-title-leaf { font-size: 26rpx; animation: sway 3s ease-in-out infinite; }
.wood-title-text { font-size: 30rpx; font-weight: 800; color: #F5E6C8; letter-spacing: 3px; }

/* ===== 基础组件 ===== */
.card-solid {
  background: linear-gradient(135deg, #3D6254, #4A7361);
  border: 3rpx solid #B8860B; border-radius: 28rpx;
  padding: 28rpx; margin-bottom: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.25);
}
.card-solid-sm {
  background: linear-gradient(135deg, #3D6254, #4A7361);
  border: 2rpx solid rgba(184,134,11,0.5); border-radius: 18rpx;
  padding: 16rpx 20rpx; margin-bottom: 12rpx;
}
.card {
  background: rgba(61,98,84,0.55);
  border: 2rpx dashed rgba(165,190,140,0.35);
  border-radius: 20rpx; padding: 20rpx 24rpx; margin-bottom: 16rpx;
}
.btn-wood {
  display: inline-flex; align-items: center; justify-content: center;
  height: 72rpx; padding: 0 36rpx;
  background: linear-gradient(135deg, #8B6914, #B8860B);
  border-radius: 999rpx; font-size: 27rpx; font-weight: 600;
  color: #F5E6C8; border: none;
  box-shadow: 0 4rpx 14rpx rgba(0,0,0,0.25);
}
.btn-leaf {
  display: inline-flex; align-items: center; justify-content: center;
  height: 72rpx; padding: 0 36rpx;
  background: linear-gradient(135deg, #7CB342, #689F38);
  border-radius: 999rpx; font-size: 27rpx; font-weight: 600;
  color: #fff; border: none;
  box-shadow: 0 4rpx 14rpx rgba(124,179,66,0.35);
}
.quote-card {
  background: linear-gradient(135deg, rgba(74,115,97,0.8), rgba(61,98,84,0.7));
  border-left: 5rpx solid #7CB342; border-radius: 18rpx;
  padding: 18rpx 22rpx; margin-top: 20rpx;
}
.quote-card-text { font-size: 25rpx; color: #E8D9BB; line-height: 1.6; }

.section-title { font-size: 27rpx; font-weight: 700; color: #F5E6C8; margin: 20rpx 0 12rpx; }
.wood-input {
  width: 100%; height: 80rpx;
  background: rgba(45,74,62,0.5); border: 2rpx solid rgba(139,105,20,0.4);
  border-radius: 18rpx; padding: 0 24rpx;
  font-size: 27rpx; color: #F5E6C8; box-sizing: border-box;
}
.wood-textarea {
  width: 100%; min-height: 160rpx;
  background: rgba(45,74,62,0.5); border: 2rpx solid rgba(139,105,20,0.4);
  border-radius: 18rpx; padding: 20rpx 24rpx;
  font-size: 26rpx; color: #F5E6C8; line-height: 1.6; box-sizing: border-box;
}

/* ===== AI规划师 · 对话式 Agent（V9.0）===== */

/* 对话模式容器 */
.plan-chat-mode { padding-bottom: 80rpx; }
.plan-chat-card { display: flex; flex-direction: column; height: 65vh; }

/* 对话消息区 */
.plan-chat-messages { flex: 1; padding: 16rpx; min-height: 0; }

.plan-msg { display: flex; gap: 12rpx; margin-bottom: 20rpx; align-items: flex-start; }
.plan-msg-user { flex-direction: row-reverse; }
.plan-msg-avatar {
  width: 52rpx; height: 52rpx; border-radius: 50%;
  background: rgba(124,179,66,0.2);
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; flex-shrink: 0;
}

.plan-msg-bubble {
  max-width: 75%; padding: 16rpx 22rpx;
  border-radius: 20rpx; font-size: 26rpx;
  line-height: 1.8; white-space: pre-wrap; word-break: break-all;
}
.plan-bubble-ai {
  background: linear-gradient(135deg, rgba(61,98,84,0.85), rgba(74,115,97,0.85));
  color: #E8D9BB; border-bottom-left-radius: 6rpx;
  border: 1rpx solid rgba(139,105,20,0.25);
}
.plan-bubble-user {
  background: linear-gradient(135deg, #8B6914, #B8860B);
  color: #F5E6C8; border-bottom-right-radius: 6rpx;
}
.plan-thinking { opacity: 0.6; font-style: italic; }

/* 打字机闪烁光标 */
.typing-cursor {
  display: inline;
  animation: cursor-blink 0.8s steps(1) infinite;
  color: #AED581;
  font-weight: bold;
  font-size: inherit;
  margin-left: 2rpx;
}
@keyframes cursor-blink {
  0%, 50% { opacity: 1; }
  51%, 100% { opacity: 0; }
}

/* 对话输入区 */
.plan-chat-input-row {
  display: flex; gap: 8rpx; padding: 12rpx 14rpx; align-items: center;
  border-top: 1rpx dashed rgba(165,190,140,0.25);
}

/* 规划师标题栏内的重置按钮 */
.plan-reset-btn {
  display: flex; align-items: center; gap: 4rpx;
  margin-left: auto;
  padding: 4rpx 14rpx;
  background: rgba(139,105,20,0.25);
  border-radius: 20rpx;
}
.plan-reset-icon { font-size: 22rpx; }
.plan-reset-text { font-size: 22rpx; color: #C5A572; }

/* 规划信息卡片（V11.0 新增） */
.plan-info-card {
  background: linear-gradient(135deg, rgba(139,105,20,0.35), rgba(184,134,11,0.2));
  border: 2rpx solid rgba(139,105,20,0.4);
  border-radius: 18rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 18rpx;
}
.plan-info-row {
  display: flex; flex-wrap: wrap; gap: 10rpx;
}
.plan-info-item {
  font-size: 23rpx; color: #F5E6C8;
  background: rgba(61,98,84,0.5);
  border: 1rpx solid rgba(139,105,20,0.25);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}
.plan-info-missing {
  margin-top: 12rpx; padding: 10rpx 14rpx;
  background: rgba(244,143,177,0.08);
  border-radius: 12rpx;
  display: flex; align-items: center; gap: 6rpx;
}
.plan-missing-label {
  font-size: 22rpx; color: #F48FB1; font-weight: 600; flex-shrink: 0;
}
.plan-missing-fields {
  font-size: 22rpx; color: #F5E6C8;
}
.plan-info-error {
  margin-top: 10rpx; padding: 8rpx 14rpx;
  background: rgba(255,107,107,0.1);
  border-radius: 10rpx;
  font-size: 22rpx; color: #FF6B6B;
}

/* 生成任务按钮区 */
.plan-generate-area {
  padding: 16rpx; text-align: center;
  border-top: 1rpx dashed rgba(165,190,140,0.25);
}
.plan-generate-status {
  display: block; font-size: 24rpx; color: #AED581;
  margin-bottom: 8rpx; animation: pulse 1.5s ease-in-out infinite;
}
.plan-generate-hint {
  display: block; font-size: 23rpx; color: #AED581;
  margin-bottom: 12rpx;
}
.plan-generate-btn {
  height: 80rpx !important; font-size: 30rpx !important;
}

/* ═══════════ 底部抽屉弹窗 V2（三段式 Bottom Sheet）═══════════ */

/* 遮罩全屏 */
.plan-sheet-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  z-index: 9999;
}
.plan-sheet-backdrop {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0.55);
}

/* 底部弹出容器 */
.plan-sheet {
  position: absolute; left: 0; right: 0; bottom: 0;
  height: 86vh;
  max-height: 86vh;
  background: linear-gradient(180deg, #355447, #2D4A3E);
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: sheet-slide-up 0.35s ease-out;
}
@keyframes sheet-slide-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

/* 拖拽横条 */
.plan-sheet-dragbar {
  width: 72rpx;
  height: 6rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 3rpx;
  margin: 16rpx auto 8rpx;
  flex-shrink: 0;
}

/* 头部 */
.plan-sheet-header {
  padding: 0 28rpx 18rpx;
  flex-shrink: 0;
}
.plan-sheet-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.plan-sheet-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #F5E6C8;
  letter-spacing: 1px;
}
.plan-sheet-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 300;
  color: #C4B89A;
  background: rgba(139,105,20,0.2);
  border-radius: 50%;
  flex-shrink: 0;
}
.plan-sheet-close:active {
  background: rgba(139,105,20,0.35);
}
.plan-sheet-subtitle {
  font-size: 24rpx;
  color: #A89978;
  display: block;
  margin-top: 8rpx;
}

/* 可滚动 body——view 占 flex 空间，内部 scroll-view 填满 */
.plan-sheet-body {
  flex: 1;
  min-height: 0;
  max-height: 58vh;
  overflow: hidden;
}
.plan-sheet-scroll {
  width: 100%;
  height: 100%;
  padding: 0 28rpx;
  box-sizing: border-box;
}

/* ===== 卡片通用 ===== */
.bs-card {
  background: rgba(61,98,84,0.55);
  border: 2rpx solid rgba(139,105,20,0.2);
  border-radius: 20rpx;
  padding: 24rpx 22rpx;
  margin-bottom: 18rpx;
}
.bs-card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #F5E6C8;
  margin-bottom: 16rpx;
}
.bs-card-row {
  margin-bottom: 12rpx;
}
.bs-card-row:last-child {
  margin-bottom: 0;
}
.bs-card-label {
  font-size: 22rpx;
  color: #AED581;
  font-weight: 600;
  display: block;
  margin-bottom: 4rpx;
}
.bs-card-text {
  font-size: 25rpx;
  color: #E8D9BB;
  line-height: 1.6;
  display: block;
}

/* ===== B. 目标草稿 ===== */
.bs-goal-title-row {
  margin-bottom: 12rpx;
}
.bs-goal-title-label {
  font-size: 22rpx;
  color: #AED581;
  font-weight: 600;
  display: block;
  margin-bottom: 6rpx;
}
.bs-input {
  width: 100%;
  height: 72rpx;
  background: rgba(45,74,62,0.5);
  border: 2rpx solid rgba(139,105,20,0.35);
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #F5E6C8;
  box-sizing: border-box;
}

/* 阶段标签 */
.bs-stages {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.bs-stage-tag {
  background: rgba(45,74,62,0.5);
  border: 1rpx solid rgba(139,105,20,0.3);
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
}
.bs-stage-name {
  display: block;
  font-size: 24rpx;
  color: #F5E6C8;
  font-weight: 600;
}
.bs-stage-dur {
  display: block;
  font-size: 20rpx;
  color: #8B9A7D;
  margin-top: 2rpx;
}

/* ===== C. 任务编辑区 ===== */
.bs-task-item {
  background: rgba(45,74,62,0.4);
  border: 2rpx solid rgba(139,105,20,0.15);
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 12rpx;
}
.bs-task-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.bs-task-info {
  flex: 1;
  min-width: 0;
}
.bs-task-input {
  width: 100%;
  height: 72rpx;
  background: rgba(45,74,62,0.5);
  border: 2rpx solid rgba(139,105,20,0.3);
  border-radius: 12rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  color: #F5E6C8;
  box-sizing: border-box;
  margin-bottom: 10rpx;
}
.bs-xp-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.bs-xp-label {
  font-size: 22rpx;
  color: #A89978;
  flex-shrink: 0;
}
.bs-xp-chip {
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(139,105,20,0.3);
  font-size: 22rpx;
  color: #C4B89A;
  background: transparent;
}
.bs-xp-active {
  background: linear-gradient(135deg, #7CB342, #689F38);
  color: #fff;
  border-color: #7CB342;
}
.bs-task-delete {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
  background: rgba(255,107,107,0.12);
  border-radius: 50%;
  font-size: 28rpx;
  color: #FF6B6B;
}
.bs-task-delete:active {
  background: rgba(255,107,107,0.25);
}
.bs-task-empty {
  text-align: center;
  padding: 36rpx 0;
  font-size: 24rpx;
  color: #8B9A7D;
}

/* 新增任务按钮 */
.bs-add-task-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  margin-top: 4rpx;
  border: 2rpx dashed rgba(124,179,66,0.35);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #7CB342;
  font-weight: 600;
}
.bs-add-task-btn:active {
  background: rgba(124,179,66,0.1);
}

/* ===== 固定底部操作栏（在 scroll-view 外部，永远可见） ===== */
.plan-sheet-footer {
  flex-shrink: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(0deg, #2D4A3E, rgba(45,74,62,0.98));
  border-top: 1rpx solid rgba(139,105,20,0.15);
  z-index: 2;
}
.plan-sheet-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
  border: none;
  padding: 0;
}
.plan-sheet-btn-cancel {
  background: rgba(139,105,20,0.25);
  color: #C4B89A;
}
.plan-sheet-btn-cancel:active {
  background: rgba(139,105,20,0.35);
}
.plan-sheet-btn-publish {
  background: linear-gradient(135deg, #7CB342, #558B2F);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(124,179,66,0.3);
}
.plan-sheet-btn-publish:active {
  opacity: 0.88;
}
.plan-sheet-btn-publish[disabled] {
  opacity: 0.45;
}

/* ===== 教练模式 ===== */
.stats-row { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.stat-item {
  flex: 1; text-align: center; padding: 20rpx 12rpx;
  border: 2rpx dashed rgba(165,190,140,0.35);
  border-radius: 20rpx; background: rgba(45,74,62,0.3);
}
.stat-num { display: block; font-size: 40rpx; font-weight: 800; color: #AED581; }
.stat-label { display: block; font-size: 21rpx; color: #C4B89A; margin-top: 6rpx; }
.coach-empty { text-align: center; padding: 40rpx 0; }
.coach-empty-text { font-size: 26rpx; color: #8B9A7D; }

/* ===== 答案之书 ===== */
.oracle-card { text-align: center; }
.oracle-hint {
  display: block; font-size: 24rpx; color: #A89978;
  margin-bottom: 16rpx; font-style: italic;
}
.oracle-input { text-align: center; margin-bottom: 20rpx; }
.btn-oracle { width: 100%; margin-top: 16rpx; }

/* 翻牌动画 */
.oracle-flip-area {
  display: flex; justify-content: center; padding: 30rpx 0;
}
.oracle-card-flip {
  width: 200rpx; height: 260rpx;
  background: linear-gradient(135deg, #8B6914, #DAA520);
  border-radius: 20rpx;
  animation: card-flip 1.2s ease-in-out;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.4);
}
@keyframes card-flip {
  0% { transform: rotateY(0deg) scale(1); opacity: 1; }
  50% { transform: rotateY(90deg) scale(1.05); opacity: 0.5; }
  100% { transform: rotateY(0deg) scale(1); opacity: 1; }
}

/* 答案结果 */
.oracle-result { margin-top: 24rpx; text-align: left; }
.oracle-q {
  display: block; font-size: 24rpx; color: #C4B89A;
  text-align: center; margin-bottom: 20rpx; font-style: italic;
}
.oracle-answer-box {
  background: rgba(45,74,62,0.5); border-radius: 18rpx;
  padding: 20rpx 24rpx; margin-bottom: 16rpx; text-align: center;
}
.oracle-answer-label {
  display: block; font-size: 22rpx; color: #A89978; margin-bottom: 8rpx;
}
.oracle-answer-text {
  display: block; font-size: 42rpx; font-weight: 900;
  letter-spacing: 4rpx; text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.3);
}
.oracle-explain-box {
  background: rgba(124,179,66,0.08); border-left: 4rpx solid #7CB342;
  border-radius: 14rpx; padding: 18rpx 22rpx;
}
.oracle-explain-label {
  display: block; font-size: 22rpx; color: #AED581; margin-bottom: 8rpx;
}
.oracle-explain-text { font-size: 25rpx; color: #E8D9BB; line-height: 1.65; }

/* ===== 今日运势 ===== */
.btn-fortune-btn { width: 100%; height: 88rpx; font-size: 30rpx; margin-top: 20rpx; }
.fortune-card { text-align: center; }
.fortune-date {
  display: block; font-size: 26rpx; color: #FFD54F;
  font-weight: 700; margin-bottom: 20rpx;
  letter-spacing: 2px;
}
.fortune-stars-row { display: flex; justify-content: center; gap: 24rpx; margin-bottom: 24rpx; }
.fortune-star-item { text-align: center; }
.star-label { display: block; font-size: 23rpx; color: #C4B89A; margin-bottom: 8rpx; }
.star-value { font-size: 28rpx; letter-spacing: 2rpx; }
.fortune-advice {
  background: rgba(255,215,79,0.06); border-radius: 16rpx;
  padding: 18rpx 22rpx; margin-bottom: 16rpx; text-align: left;
}
.advice-label { display: block; font-size: 24rpx; color: #FFD54F; font-weight: 700; margin-bottom: 8rpx; }
.advice-text { font-size: 25rpx; color: #E8D9BB; line-height: 1.6; }
.fortune-lucky {
  background: rgba(124,179,66,0.08); border-radius: 16rpx;
  padding: 16rpx 22rpx; text-align: left;
}
.lucky-label { display: block; font-size: 24rpx; color: #AED581; font-weight: 700; margin-bottom: 6rpx; }
.lucky-text { font-size: 26rpx; color: #F5E6C8; font-weight: 600; }

/* ===== 成长翻译 ===== */
.translate-card { text-align: left; }
.translate-result { margin-top: 20rpx; }
.trans-original, .trans-translated {
  display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx;
}
.trans-tag {
  font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 999rpx;
  font-weight: 600; flex-shrink: 0;
}
.trans-user { background: rgba(218,165,32,0.2); color: #DAA520; }
.trans-ai { background: rgba(124,179,66,0.2); color: #7CB342; }
.trans-text { font-size: 26rpx; color: #F5E6C8; }
.trans-encourage { display: flex; align-items: flex-start; gap: 12rpx; }
.encourage-icon { font-size: 28rpx; flex-shrink: 0; }
.encourage-text { font-size: 25rpx; color: #E8D9BB; line-height: 1.6; }

/* ===== 昵称生成器 ===== */
.nickname-card { text-align: left; }
.nick-hint { display: block; font-size: 23rpx; color: #A89978; margin-bottom: 12rpx; }
.nickname-results { margin-top: 20rpx; }
.nickname-item {
  display: flex; align-items: center; gap: 14rpx;
  padding: 16rpx 20rpx; margin-bottom: 10rpx;
}
.nickname-prefix {
  font-size: 22rpx; color: #DAA520; font-weight: 800;
  min-width: 48rpx; flex-shrink: 0;
}
.nickname-text { flex: 1; font-size: 28rpx; font-weight: 700; color: #F5E6C8; }
.nickname-copy {
  font-size: 22rpx; color: #7CB342; padding: 6rpx 18rpx;
  border: 2rpx solid rgba(124,179,66,0.4); border-radius: 999rpx;
  flex-shrink: 0;
}

/* ===== 目标命名器 ===== */
.goalname-card { text-align: left; }
.gn-hint { display: block; font-size: 23rpx; color: #A89978; margin-bottom: 12rpx; }
.goalname-results { margin-top: 20rpx; }
.gn-before {
  display: block; font-size: 23rpx; color: #8B9A7D;
  margin-bottom: 12rpx; text-decoration: line-through;
}
.goalname-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx 22rpx; margin-bottom: 10rpx;
}
.gn-name { font-size: 29rpx; font-weight: 800; color: #FFD54F; }
.gn-use {
  font-size: 22rpx; color: #7CB342; padding: 6rpx 18rpx;
  border: 2rpx solid rgba(124,179,66,0.4); border-radius: 999rpx;
}

/* ===== 未来来信 ===== */
.future-card { text-align: left; }
.future-hint { display: block; font-size: 23rpx; color: #A89978; margin-bottom: 12rpx; }
.future-letter-result { margin-top: 24rpx; }
.letter-header { text-align: center; margin-bottom: 20rpx; }
.letter-from {
  display: block; font-size: 24rpx; color: #F48FB1;
  font-weight: 700; margin-bottom: 6rpx;
}
.letter-dream { display: block; font-size: 23rpx; color: #C4B89A; }
.letter-body { background: rgba(244,143,177,0.04); }
.letter-content {
  font-size: 25rpx; color: #E8D9BB; line-height: 1.75;
  white-space: pre-wrap;
}

/* ===== 时间胶囊 ===== */
.capsule-card { text-align: left; }
.capsule-hint { display: block; font-size: 23rpx; color: #A89978; margin-bottom: 12rpx; }
.capsule-saved-view { text-align: center; }
.capsule-sealed {
  padding: 32rpx 0 24rpx;
}
.sealed-icon { font-size: 80rpx; display: block; margin-bottom: 16rpx; }
.sealed-text {
  display: block; font-size: 30rpx; font-weight: 800; color: #80CBC4;
  margin-bottom: 10rpx;
}
.sealed-date { display: block; font-size: 23rpx; color: #C4B89A; margin-bottom: 4rpx; }
.sealed-open { display: block; font-size: 23rpx; color: #80CBC4; }
.capsule-content-preview { text-align: left; margin: 20rpx 0; }
.preview-label { display: block; font-size: 22rpx; color: #A89978; margin-bottom: 8rpx; }
.preview-text { font-size: 25rpx; color: #F5E6C8; line-height: 1.5; }

/* ===== 随机挑战 ===== */
.challenge-draw-btn { width: 100%; height: 96rpx; font-size: 32rpx; margin-top: 30rpx; }
.challenge-card { text-align: center; }
.challenge-active { padding: 20rpx 0; }
.challenge-icon-lg { font-size: 120rpx; display: block; margin-bottom: 20rpx; animation: bounce-gentle 2s ease-in-out infinite; }
@keyframes bounce-gentle {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}
.challenge-task {
  display: block; font-size: 36rpx; font-weight: 800; color: #F5E6C8;
  margin-bottom: 24rpx; letter-spacing: 2px;
}
.challenge-reward {
  display: inline-block; background: rgba(255,215,79,0.08);
  border: 2rpx solid rgba(255,215,79,0.25);
  border-radius: 999rpx; padding: 10rpx 28rpx; margin-bottom: 24rpx;
}
.reward-label { display: block; font-size: 21rpx; color: #A89978; }
.reward-xp { display: block; font-size: 28rpx; font-weight: 800; color: #FFD54F; margin-top: 4rpx; }
.challenge-done-btn { width: 85%; font-size: 28rpx; }
.challenge-completed { padding: 30rpx 0; }
.completed-badge {
  display: block; font-size: 36rpx; font-weight: 900; color: #7CB342;
  margin-bottom: 20rpx;
}
.completed-task { display: block; font-size: 26rpx; color: #C4B89A; margin-bottom: 10rpx; text-decoration: line-through; }
.completed-xp { display: block; font-size: 28rpx; font-weight: 700; color: #FFD54F; }

/* ===== 聊天模式 ===== */
.chat-area { display: flex; flex-direction: column; height: 60vh; }
.chat-messages { flex: 1; padding: 16rpx; }
.msg { display: flex; gap: 12rpx; margin-bottom: 20rpx; align-items: flex-start; }
.msg-user { flex-direction: row-reverse; }
.msg-avatar {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: rgba(124,179,66,0.2);
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; flex-shrink: 0;
}
.msg-bubble {
  max-width: 70%; padding: 16rpx 22rpx;
  border-radius: 20rpx; font-size: 25rpx;
  line-height: 1.55; word-break: break-all;
}
.bubble-wood {
  background: linear-gradient(135deg, #8B6914, #B8860B);
  color: #F5E6C8; border-bottom-right-radius: 6rpx;
}
.bubble-leaf {
  background: linear-gradient(135deg, rgba(124,179,66,0.85), rgba(104,159,56,0.85));
  color: #fff; border-bottom-left-radius: 6rpx;
}
.chat-empty { text-align: center; padding: 60rpx 0; }
.chat-empty-icon { font-size: 64rpx; display: block; margin-bottom: 12rpx; opacity: 0.5; }
.chat-empty-text { font-size: 25rpx; color: #8B9A7D; }
.chat-input-row {
  display: flex; gap: 12rpx; padding: 16rpx;
  border-top: 1rpx dashed rgba(165,190,140,0.25);
}
.wood-chat-input {
  flex: 1 1 0%; min-width: 0; height: 72rpx;
  background: rgba(45,74,62,0.5);
  border: 2rpx solid rgba(139,105,20,0.4);
  border-radius: 36rpx; padding: 0 24rpx;
  font-size: 26rpx; color: #F5E6C8;
}
/* 规划师发送按钮 — 紧凑小按钮 */
.plan-send-btn {
  flex-shrink: 0;
  height: 64rpx !important; line-height: 64rpx !important;
  padding: 0 20rpx !important; font-size: 24rpx !important;
  min-width: 96rpx !important; border-radius: 32rpx !important;
  background: linear-gradient(135deg, #8B6914, #A67C00) !important;
  color: #FFF8E1 !important; margin: 0 !important;
}
/* 聊天发送按钮 — 同样紧凑 */
.chat-input-row .btn-leaf.send-btn-mini,
.chat-input-row .send-btn-mini {
  flex-shrink: 0;
  height: 64rpx !important; line-height: 64rpx !important;
  padding: 0 20rpx !important; font-size: 24rpx !important;
  min-width: 96rpx !important; border-radius: 32rpx !important;
  margin: 0 !important;
}

/* ===== 工具弹窗 Bottom Sheet ===== */
.tool-sheet-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  z-index: 9999;
}
.tool-sheet-backdrop {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0.55);
}
.tool-sheet {
  position: absolute; left: 0; right: 0; bottom: 0;
  height: 86vh;
  max-height: 86vh;
  background: linear-gradient(180deg, #355447, #2D4A3E);
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: sheet-slide-up 0.35s ease-out;
}
.tool-sheet-dragbar {
  width: 72rpx;
  height: 6rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 3rpx;
  margin: 16rpx auto 8rpx;
  flex-shrink: 0;
}
.tool-sheet-header {
  padding: 0 28rpx 18rpx;
  flex-shrink: 0;
}
.tool-sheet-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.tool-sheet-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #F5E6C8;
  letter-spacing: 1px;
}
.tool-sheet-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 300;
  color: #C4B89A;
  background: rgba(139,105,20,0.2);
  border-radius: 50%;
  flex-shrink: 0;
}
.tool-sheet-close:active {
  background: rgba(139,105,20,0.35);
}
.tool-sheet-body {
  flex: 1;
  min-height: 0;
  padding: 0 28rpx;
}
.tool-sheet-footer {
  flex-shrink: 0;
  padding: 20rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(0deg, #2D4A3E, rgba(45,74,62,0.98));
  border-top: 1rpx solid rgba(139,105,20,0.15);
}
.tool-sheet-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
  border: none;
  padding: 0;
  background: rgba(139,105,20,0.25);
  color: #C4B89A;
}
.tool-sheet-btn:active {
  background: rgba(139,105,20,0.35);
}

/* ===== 工具内容通用 ===== */
.tool-content {
  padding: 10rpx 0 40rpx;
}
.tool-hint {
  display: block; font-size: 24rpx; color: #A89978;
  margin-bottom: 20rpx; text-align: center;
}

/* ===== 番茄钟 ===== */
.pomodoro-mode-row {
  display: flex; gap: 16rpx; margin-bottom: 32rpx;
}
.pomodoro-mode-btn {
  flex: 1;
  display: flex; flex-direction: column; align-items: center;
  padding: 20rpx 12rpx;
  background: rgba(61,98,84,0.5);
  border: 2rpx solid rgba(139,105,20,0.25);
  border-radius: 20rpx;
  transition: all 0.2s;
}
.pomodoro-mode-btn:active {
  transform: scale(0.96);
}
.pomodoro-active {
  background: linear-gradient(135deg, rgba(124,179,66,0.3), rgba(104,159,56,0.2));
  border-color: #7CB342;
  box-shadow: 0 0 20rpx rgba(124,179,66,0.2);
}
.pomodoro-mode-icon { font-size: 40rpx; margin-bottom: 8rpx; }
.pomodoro-mode-name { font-size: 26rpx; font-weight: 700; color: #F5E6C8; }
.pomodoro-mode-desc { font-size: 20rpx; color: #A89978; margin-top: 4rpx; }

.pomodoro-timer {
  text-align: center; padding: 40rpx 0;
}
.pomodoro-time {
  display: block; font-size: 96rpx; font-weight: 900;
  color: #F5E6C8; font-family: 'Courier New', monospace;
  text-shadow: 0 4rpx 20rpx rgba(0,0,0,0.4);
  margin-bottom: 12rpx;
}
.pomodoro-status {
  font-size: 26rpx; color: #AED581;
}

.pomodoro-controls {
  display: flex; gap: 16rpx; justify-content: center;
}
.pomodoro-controls .btn-leaf,
.pomodoro-controls .btn-wood {
  min-width: 180rpx;
}

/* ===== 今日待办抽签 ===== */
.todo-draw-area {
  text-align: center; padding: 40rpx 0;
}
.todo-hint {
  font-size: 26rpx; color: #C4B89A;
}
.todo-draw-btn {
  width: 100%; margin-top: 24rpx; height: 96rpx; font-size: 32rpx;
}

.todo-result {
  text-align: center; padding: 30rpx 0;
}
.todo-icon { font-size: 80rpx; display: block; margin-bottom: 16rpx; }
.todo-task {
  display: block; font-size: 32rpx; font-weight: 800; color: #F5E6C8;
  margin-bottom: 20rpx; line-height: 1.5;
}
.todo-meta {
  display: flex; justify-content: center; gap: 24rpx; margin-bottom: 28rpx;
}
.todo-difficulty, .todo-time {
  font-size: 24rpx; color: #A89978;
  background: rgba(45,74,62,0.5);
  padding: 8rpx 20rpx; border-radius: 999rpx;
}
.todo-actions {
  display: flex; gap: 20rpx; padding: 0 20rpx;
}
.todo-actions .btn-wood,
.todo-actions .btn-leaf {
  flex: 1;
}

/* ===== 专注宣言 ===== */
.oath-result {
  margin-top: 24rpx;
  background: rgba(124,179,66,0.08);
  border-left: 5rpx solid #7CB342;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
}
.oath-text {
  display: block; font-size: 26rpx; color: #E8D9BB;
  line-height: 1.8; font-weight: 600;
}
.oath-actions {
  display: flex; gap: 16rpx; margin-top: 20rpx;
}
.oath-actions .btn-wood,
.oath-actions .btn-leaf {
  flex: 1;
}

.oath-history {
  margin-top: 28rpx;
}
.oath-history-title {
  display: block; font-size: 26rpx; font-weight: 700; color: #F5E6C8;
  margin-bottom: 16rpx;
}
.oath-history-item {
  background: rgba(61,98,84,0.4);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}
.oath-history-text {
  display: block; font-size: 25rpx; color: #E8D9BB;
  line-height: 1.5;
}
.oath-history-date {
  display: block; font-size: 20rpx; color: #8B9A7D;
  margin-top: 8rpx;
}

/* ===== 拖延急救 ===== */
.delay-options {
  display: flex; flex-wrap: wrap; gap: 14rpx;
}
.delay-option {
  width: calc((100% - 14rpx) / 2);
  display: flex; align-items: center; gap: 12rpx;
  padding: 20rpx 16rpx;
  background: rgba(61,98,84,0.4);
  border: 2rpx solid rgba(139,105,20,0.2);
  border-radius: 18rpx;
  transition: all 0.2s;
}
.delay-option:active {
  transform: scale(0.98);
}
.delay-selected {
  background: linear-gradient(135deg, rgba(255,152,0,0.15), rgba(255,152,0,0.05));
  border-color: #FF9800;
}
.delay-icon { font-size: 32rpx; }
.delay-label { font-size: 24rpx; color: #F5E6C8; font-weight: 600; }

.delay-result {
  margin-top: 28rpx;
  background: rgba(255,152,0,0.06);
  border: 2rpx solid rgba(255,152,0,0.2);
  border-radius: 20rpx;
  padding: 24rpx;
}
.delay-advice {
  display: block; font-size: 28rpx; font-weight: 700; color: #FFD54F;
  margin-bottom: 16rpx; line-height: 1.5;
}
.delay-action {
  display: block; font-size: 25rpx; color: #E8D9BB;
  margin-bottom: 12rpx; padding-left: 20rpx;
  border-left: 4rpx solid #7CB342;
}
.delay-encourage {
  display: block; font-size: 24rpx; color: #AED581;
  font-style: italic;
}

/* ===== 人格测试 ===== */
.personality-disclaimer {
  display: block; font-size: 22rpx; color: #8B9A7D;
  text-align: center; margin-bottom: 20rpx;
}
.personality-quiz {
  padding: 10rpx 0;
}
.quiz-question {
  display: block; font-size: 30rpx; font-weight: 700; color: #F5E6C8;
  line-height: 1.6; margin-bottom: 24rpx;
}
.quiz-options {
  display: flex; flex-direction: column; gap: 14rpx;
}
.quiz-option {
  display: flex; align-items: center; gap: 16rpx;
  padding: 22rpx 24rpx;
  background: rgba(61,98,84,0.4);
  border: 2rpx solid rgba(139,105,20,0.2);
  border-radius: 18rpx;
  transition: all 0.2s;
}
.quiz-option:active {
  transform: scale(0.98);
  background: rgba(124,179,66,0.15);
  border-color: #7CB342;
}
.quiz-option-icon { font-size: 36rpx; }
.quiz-option-text { font-size: 26rpx; color: #E8D9BB; flex: 1; }
.quiz-progress {
  display: block; font-size: 24rpx; color: #A89978;
  text-align: center; margin-top: 28rpx;
}

.personality-result {
  text-align: center; padding: 20rpx 0;
}
.personality-type-icon { font-size: 100rpx; display: block; margin-bottom: 16rpx; }
.personality-type-name {
  display: block; font-size: 36rpx; font-weight: 900; color: #F5E6C8;
  margin-bottom: 16rpx;
}
.personality-keywords {
  display: block; font-size: 25rpx; color: #AED581;
  margin-bottom: 20rpx;
}
.personality-method, .personality-today, .personality-tools {
  display: block; font-size: 25rpx; color: #E8D9BB;
  line-height: 1.6; margin-bottom: 16rpx;
}

/* ===== 自律人格卡 ===== */
.discipline-tags {
  display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 28rpx;
}
.discipline-tag {
  padding: 14rpx 24rpx;
  background: rgba(61,98,84,0.4);
  border: 2rpx solid rgba(139,105,20,0.2);
  border-radius: 999rpx;
  font-size: 24rpx; color: #C4B89A;
  transition: all 0.2s;
}
.discipline-tag:active {
  transform: scale(0.96);
}
.discipline-selected {
  background: linear-gradient(135deg, rgba(124,179,66,0.3), rgba(104,159,56,0.2));
  border-color: #7CB342;
  color: #F5E6C8;
}

.discipline-card-result {
  background: linear-gradient(135deg, rgba(74,115,97,0.7), rgba(61,98,84,0.6));
  border: 2rpx solid rgba(139,105,20,0.3);
  border-radius: 24rpx;
  padding: 28rpx;
}
.card-title {
  display: block; font-size: 32rpx; font-weight: 900; color: #F5E6C8;
  text-align: center; margin-bottom: 16rpx;
}
.card-keyword {
  display: block; font-size: 24rpx; color: #AED581;
  text-align: center; margin-bottom: 20rpx;
}
.card-advantage, .card-challenge, .card-action {
  display: block; font-size: 25rpx; color: #E8D9BB;
  line-height: 1.6; margin-bottom: 14rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid rgba(124,179,66,0.5);
}

/* ===== 情绪能量检测 ===== */
.energy-levels {
  display: flex; justify-content: center; gap: 12rpx; margin-bottom: 28rpx;
}
.energy-level {
  width: 80rpx;
  display: flex; flex-direction: column; align-items: center;
  padding: 16rpx 8rpx;
  background: rgba(61,98,84,0.4);
  border: 2rpx solid rgba(139,105,20,0.2);
  border-radius: 16rpx;
  transition: all 0.2s;
}
.energy-level:active {
  transform: scale(0.96);
}
.energy-selected {
  background: linear-gradient(135deg, rgba(124,179,66,0.3), rgba(104,159,56,0.2));
  border-color: #7CB342;
}
.energy-num {
  font-size: 32rpx; font-weight: 800; color: #F5E6C8;
}
.energy-label {
  font-size: 18rpx; color: #A89978; margin-top: 4rpx;
}

.emotion-options {
  display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 28rpx;
}
.emotion-option {
  width: calc((100% - 48rpx) / 5);
  display: flex; flex-direction: column; align-items: center;
  padding: 16rpx 8rpx;
  background: rgba(61,98,84,0.4);
  border: 2rpx solid rgba(139,105,20,0.2);
  border-radius: 16rpx;
  transition: all 0.2s;
}
.emotion-option:active {
  transform: scale(0.96);
}
.emotion-selected {
  background: linear-gradient(135deg, rgba(124,179,66,0.3), rgba(104,159,56,0.2));
  border-color: #7CB342;
}
.emotion-icon { font-size: 36rpx; }
.emotion-label {
  font-size: 20rpx; color: #C4B89A; margin-top: 6rpx;
}

.energy-result {
  background: rgba(139,195,74,0.06);
  border: 2rpx solid rgba(139,195,74,0.2);
  border-radius: 20rpx;
  padding: 24rpx;
}
.energy-status {
  display: block; font-size: 28rpx; font-weight: 700; color: #F5E6C8;
  margin-bottom: 16rpx;
}
.energy-do {
  display: block; font-size: 25rpx; color: #AED581;
  line-height: 1.6; margin-bottom: 12rpx;
}
.energy-not-do {
  display: block; font-size: 25rpx; color: #FF6B6B;
  line-height: 1.6;
}

/* ===== 工具盒头部 ===== */
.toolbox-header {
  background: linear-gradient(135deg, #FFD54F, #FFB300);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  text-align: center;
  box-shadow: 0 6rpx 24rpx rgba(255,193,7,0.3);
}
.toolbox-title {
  font-size: 28rpx; font-weight: 800;
  color: #5D4037;
  letter-spacing: 3px;
}

/* ===== 动画 ===== */
@keyframes sway { 0%,100%{transform:rotate(0deg)} 25%{transform:rotate(3deg)} 75%{transform:rotate(-3deg)} }
.bs-task-schedule { display: flex; flex-wrap: wrap; gap: 12rpx; align-items: center; color: #C4B89A; font-size: 22rpx; margin: 12rpx 0; }
.bs-schedule-picker { color: #F5E6C8; border-bottom: 2rpx solid #B8860B; padding: 8rpx 0; }
.bs-schedule-number { width: 100rpx; color: #F5E6C8; background: rgba(45,74,62,0.5); border: 1rpx solid #B8860B; border-radius: 8rpx; padding: 8rpx 12rpx; font-size: 24rpx; }
.bs-schedule-hint { display: block; color: #C4B89A; font-size: 23rpx; line-height: 1.6; margin-bottom: 16rpx; }
