/* ===== AI 伙伴小屋 - 全功能版样式 ===== */

/* 页面基础 */
.page { min-height: 100vh; background: radial-gradient(ellipse at center top, #355447 0%, #2D4A3E 70%); }
.page-scroll { height: 100vh; }
.page-inner, .menu-container, .mode-container { max-width: 720rpx; margin: 0 auto; padding: 20rpx 24rpx 150rpx; box-sizing: border-box; }

/* 返回按钮 - 木纹风格 */
.back-bar {
  display: flex; align-items: center; gap: 10rpx;
  padding: 14rpx 28rpx;
  background: linear-gradient(135deg, rgba(139,105,20,0.3), rgba(184,134,11,0.2));
  border: 2rpx solid rgba(139,105,20,0.35);
  border-radius: 999rpx;
  margin-bottom: 16rpx;
  width: fit-content;
}
.back-bar:active { transform: scale(0.96); opacity: 0.85; }
.back-icon { font-size: 30rpx; }
.back-text { font-size: 25rpx; color: #F5E6C8; font-weight: 600; }

/* 顶部操作行：返回按钮 + 生成计划按钮 */
.top-bar-row {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 16rpx;
  gap: 16rpx;
}

/* 生成计划按钮（顶部右侧） */
.plan-gen-top-btn {
  display: flex; align-items: center; gap: 6rpx;
  padding: 14rpx 24rpx;
  background: linear-gradient(135deg, #7CB342, #558B2F);
  border-radius: 999rpx;
  box-shadow: 0 4rpx 14rpx rgba(124,179,66,0.35);
  flex-shrink: 0;
}
.plan-gen-top-btn:active { transform: scale(0.94); opacity: 0.85; }
.plan-gen-top-icon { font-size: 26rpx; }
.plan-gen-top-text { font-size: 24rpx; color: #fff; font-weight: 700; }

/* 测试按钮组 */

/* ===== 分区标签 ===== */
.section-label {
  font-size: 24rpx; color: #AED581; letter-spacing: 4px;
  margin: 28rpx 0 14rpx; padding-left: 8rpx;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.3);
}

/* ===== AI 网格布局（紧凑排列：每行 3 个） ===== */
.ai-grid {
  display: flex; flex-wrap: wrap; gap: 14rpx;
  padding: 0 4rpx;
}
.ai-grid-item {
  width: calc((100% - 28rpx) / 3);  /* 3列均分 */
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 22rpx 8rpx 18rpx;
  background: linear-gradient(145deg, rgba(74,115,97,0.55), rgba(61,98,84,0.45));
  border: 2rpx solid rgba(139,105,20,0.3);
  border-radius: 22rpx;
  box-sizing: border-box;
  transition: transform 0.15s, box-shadow 0.15s;
}
.ai-grid-item:active {
  transform: scale(0.94);
  box-shadow: 0 0 20rpx rgba(124,179,66,0.25);
}
.ai-grid-icon {
  font-size: 44rpx;
  margin-bottom: 10rpx;
}
.ai-grid-name {
  font-size: 22rpx; font-weight: 600;
  color: #F5E6C8;
  text-align: center;
  line-height: 1.3;
}

/* ===== 模式描述文字（详情页内显示） ===== */
.partner-grid .ai-grid-item { width: calc((100% - 14rpx) / 2); align-items: flex-start; padding: 24rpx; }
.partner-grid .ai-grid-name { text-align: left; font-size: 26rpx; }
.partner-description { display: block; font-size: 20rpx; color: #B8C9A7; margin-top: 10rpx; line-height: 1.5; }
.partner-workspace { font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; }
.partner-hero { display: flex; align-items: center; gap: 20rpx; padding: 14rpx 0 30rpx; }
.partner-hero-icon { width: 100rpx; height: 100rpx; line-height: 100rpx; text-align: center; border-radius: 30rpx; border: 1rpx solid #8B783D; background: #3F604E; font-size: 54rpx; flex-shrink: 0; }
.partner-hero-copy { flex: 1; min-width: 0; }
.partner-kicker { display: block; font-size: 20rpx; color: #B8C9A7; line-height: 1.6; }
.partner-title { display: block; font-size: 38rpx; color: #F5E6C8; font-weight: 700; margin: 6rpx 0; letter-spacing: 3rpx; }
.partner-subtitle { display: block; font-size: 23rpx; color: #C4CBAA; line-height: 1.7; }
.partner-step-row { display: flex; justify-content: space-between; gap: 8rpx; padding: 0 2rpx 24rpx; color: #C7BC8E; font-size: 21rpx; }
.partner-paper { margin: 0 0 24rpx; padding: 26rpx; border-radius: 24rpx; background: #F4ECD6; color: #304C3D; }
.partner-panel { padding: 26rpx; margin-bottom: 24rpx; border-radius: 22rpx; border: 1rpx solid #647950; background: #385746; color: #F5E6C8; }
.partner-heading { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; margin-bottom: 18rpx; flex-wrap: wrap; }
.partner-paper-title, .partner-section-title { display: block; font-size: 27rpx; font-weight: 600; line-height: 1.6; }
.partner-badge { display: inline-block; padding: 5rpx 12rpx; border-radius: 8rpx; font-size: 19rpx; color: #786027; background: #E5DDC1; flex-shrink: 0; }
.partner-small-label { font-size: 19rpx; color: #BDC9A4; }
.review-goal-title { display: block; font-size: 32rpx; font-weight: 700; line-height: 1.6; overflow-wrap: break-word; }
.partner-source { display: block; font-size: 20rpx; color: #788369; line-height: 1.7; margin-top: 10rpx; }
.review-hero { padding-bottom: 22rpx; }
.review-hero .partner-hero-icon { width: 78rpx; height: 78rpx; line-height: 78rpx; border-radius: 22rpx; font-size: 38rpx; }
.review-eyebrow { display: block; color: #6B603C; font-size: 21rpx; line-height: 1.6; }
.review-draft-actions { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8rpx 20rpx; margin-top: 12rpx; border-top: 1rpx solid #DCD5BF; }
.review-draft-actions .partner-link { padding: 16rpx 0 0; }
.review-draft-actions .partner-link:first-child { font-weight: 600; }
.review-workspace .partner-link[disabled] { background: transparent; opacity: .55; }
.review-workspace .partner-paper .partner-inline-note { margin: 14rpx 0 0; }
.review-disclosure { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; width: 100%; padding: 0; text-align: left; background: transparent; color: #F5E6C8; line-height: 1.5; }
.review-disclosure-copy { flex: 1; min-width: 0; }
.review-disclosure-title { display: block; font-size: 27rpx; font-weight: 600; }
.review-disclosure-caption { display: block; margin-top: 4rpx; color: #C4CBAA; font-size: 22rpx; }
.review-disclosure-action { flex-shrink: 0; color: #E0C67B; font-size: 22rpx; }
.review-fold-panel { padding-top: 20rpx; padding-bottom: 20rpx; }
.review-fold-panel .partner-inline-note { margin: 16rpx 0 0; }
.review-rule-summary { margin-top: 12rpx; padding: 16rpx; border-radius: 12rpx; background: #304C3C; }
.review-audit-actions { margin-top: 16rpx; }
.review-audit-actions .partner-link { display: block; margin: 6rpx auto 0; }
.review-workspace .audit-model-section { margin-top: 16rpx; padding-top: 14rpx; }
.review-workspace .audit-model-section > .partner-footnote:first-child { margin-top: 0; }
.review-workspace .audit-model-section .partner-primary { margin-top: 18rpx; }
.review-details { margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid #647950; }
.review-detail-paper { margin-bottom: 18rpx; }
.review-detail-paper .partner-source { margin-bottom: 12rpx; }
.partner-inline-note { display: block; padding: 16rpx; background: #E9DFC3; border-radius: 10rpx; color: #7A6632; font-size: 22rpx; line-height: 1.7; margin-bottom: 18rpx; }
.partner-workspace button { margin: 0; font-family: inherit; box-sizing: border-box; }
.partner-workspace button::after { border: 0; }
.partner-primary { display: block; width: 100%; padding: 21rpx 14rpx; border-radius: 15rpx; background: #8B6914; color: #FFF3D3; font-size: 25rpx; font-weight: 600; line-height: 1.6; }
.partner-primary[disabled] { background: #536344; color: #B9C1A6; opacity: 1; }
.partner-paper .partner-primary { margin-top: 20rpx; }
.partner-link { display: inline-block; background: transparent; padding: 10rpx 0; border-radius: 0; color: #E0C67B; font-size: 23rpx; line-height: 1.6; }
.partner-paper .partner-link { color: #80631B; }
.partner-outline { background: transparent; border: 1rpx solid #A1A77E; color: #526442; padding: 17rpx; border-radius: 14rpx; font-size: 24rpx; line-height: 1.6; }
.partner-action-row { display: flex; align-items: center; gap: 14rpx; margin-top: 20rpx; }
.partner-action-row .partner-primary { flex: 1; width: auto; margin: 0; }
.partner-disclosure { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; width: 100%; padding: 10rpx 0; text-align: left; background: transparent; color: #F5E6C8; line-height: 1.5; }
.partner-disclosure-paper { color: #304C3D; }
.partner-disclosure-paper .review-disclosure-caption { color: #5D6C4D; }
.partner-disclosure-paper .review-disclosure-action { color: #78601E; }
.coach-fold { margin-top: 16rpx; padding-top: 8rpx; border-top: 1rpx solid #849064; }
.coach-window .coach-fold { border-color: #DCD5BF; }
.coach-fold-body { margin-top: 14rpx; }
.coach-workspace .coach-steward-link { display: block; width: 100%; margin-top: 14rpx; }
.coach-scope-note { margin: 0 10rpx; }
.partner-task-row { display: flex; align-items: center; gap: 14rpx; padding: 22rpx 0; border-top: 1rpx solid #DED8C2; }
.partner-task-number { display: block; width: 30rpx; font-size: 22rpx; color: #7A874F; flex-shrink: 0; }
.partner-task-copy { flex: 1; min-width: 0; }
.partner-task-title { display: block; color: #3B533C; font-size: 25rpx; line-height: 1.7; overflow-wrap: break-word; }
.partner-task-meta { display: block; color: #7A8469; font-size: 20rpx; line-height: 1.7; flex-shrink: 0; }
.partner-body-copy { display: block; color: #C0CCAF; font-size: 23rpx; line-height: 1.9; margin-top: 12rpx; }
.partner-footnote { display: block; color: #B1C09D; font-size: 20rpx; line-height: 1.8; margin-top: 18rpx; }
.partner-awaiting .partner-primary { margin-top: 22rpx; }
.muted-badge { color: #D0BF8D; background: #4C6146; }
.partner-empty { display: flex; flex-direction: column; align-items: center; text-align: center; padding-top: 40rpx; padding-bottom: 40rpx; font-size: 24rpx; line-height: 1.8; color: #788369; gap: 18rpx; }
.partner-empty-icon { display: block; font-size: 52rpx; }
.partner-muted { display: block; color: #788369; font-size: 23rpx; line-height: 1.9; }
.partner-empty .partner-primary { width: 100%; }
.partner-error { display: block; padding: 20rpx; background: #68533B; color: #F1D9AE; border-radius: 12rpx; font-size: 23rpx; line-height: 1.8; margin-bottom: 20rpx; }
.partner-error .partner-link { display: block; }
.requirement-row { display: flex; align-items: flex-start; gap: 16rpx; border-top: 1rpx solid #526C4D; padding: 18rpx 0; font-size: 23rpx; line-height: 1.8; }
.requirement-label { width: 100rpx; flex-shrink: 0; color: #CFBE91; }
.requirement-value { flex: 1; min-width: 0; color: #E3E0BF; overflow-wrap: break-word; }
.review-check-grid { display: flex; gap: 16rpx; margin-top: 22rpx; }
.review-check-grid > view { flex: 1; padding: 18rpx; background: #304C3C; border-radius: 12rpx; min-width: 0; }
.review-check-grid text { display: block; font-size: 23rpx; line-height: 1.7; }
.review-check-grid text + text { color: #B2C29F; font-size: 20rpx; margin-top: 10rpx; }
.coach-picker { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 20rpx; background: #2D4A3E; border: 1rpx solid #7C8851; border-radius: 14rpx; margin-top: 20rpx; color: #F5E6C8; font-size: 25rpx; line-height: 1.7; }
.coach-picker text:first-child { flex: 1; min-width: 0; overflow-wrap: break-word; }
.coach-picker text:last-child { flex-shrink: 0; color: #DCC17A; font-size: 22rpx; }
.coach-date-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 20rpx; font-size: 23rpx; color: #C0CCAF; }
.coach-date-value { padding: 10rpx 16rpx; background: #2D4A3E; border-radius: 10rpx; color: #E1CE93; }
.coach-fact-grid { display: flex; padding: 26rpx 0; }
.coach-fact-grid > view { flex: 1; min-width: 0; text-align: center; border-right: 1rpx solid #DCD5BF; color: #798369; font-size: 21rpx; }
.coach-fact-grid > view:last-child { border-right: 0; }
.coach-fact-value { display: block; font-size: 43rpx; font-weight: 700; color: #3B533C; margin-bottom: 6rpx; }
.green-value { color: #5F813E; }
.coach-progress { padding: 0 0 24rpx; }
.coach-progress-heading { display: flex; justify-content: space-between; color: #71805F; font-size: 21rpx; margin-bottom: 14rpx; }
.coach-progress-track { height: 10rpx; border-radius: 8rpx; background: #DDD8C1; overflow: hidden; }
.coach-progress-fill { height: 100%; border-radius: 8rpx; background: #7C9956; }
.small-empty { padding: 20rpx 0; font-size: 23rpx; }
.coach-task-mark { width: 34rpx; height: 34rpx; line-height: 34rpx; text-align: center; border-radius: 50%; border: 1rpx solid #ABB893; color: #85956C; flex-shrink: 0; }
.completed-mark { color: #5C7B44; background: #E1E8CF; }
.coach-refresh { display: block; text-align: center; margin-top: 14rpx !important; }
.coach-reason-list { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 22rpx; }
.coach-reason { border-radius: 999rpx; padding: 12rpx 22rpx; background: #2D4A3E; color: #BBCAA9; border: 1rpx solid #61754F; font-size: 22rpx; line-height: 1.6; }
.reason-selected { border-color: #CFB15E; background: #566B43; color: #F4E6B8; }
.partner-note-input { display: block; width: 100%; min-height: 144rpx; max-height: 320rpx; padding: 20rpx; margin-top: 22rpx; border-radius: 14rpx; background: #2D4A3E; color: #F5E6C8; box-sizing: border-box; font-size: 25rpx; line-height: 1.8; }
.partner-input-placeholder { color: #9CAF94; }
.coach-note-footer { display: flex; align-items: center; justify-content: space-between; font-size: 20rpx; color: #ADBF9D; margin-top: 10rpx; }
.partner-feedback-state { display: block; color: #B9D399; font-size: 20rpx; line-height: 1.8; margin-top: 10rpx; }
.partner-feedback-error { display: block; color: #F0CEA0; font-size: 22rpx; line-height: 1.8; margin-top: 10rpx; }
.plan-review-shortcut { padding: 16rpx 24rpx; text-align: center; font-size: 22rpx; color: #D8C286; line-height: 1.6; flex-shrink: 0; background: #304C3E; }

.steward-entry { padding: 26rpx; margin: 0 0 30rpx; border: 2rpx solid #A78B3B; border-radius: 26rpx; background: #3B5944; color: #F5E6C8; }
.steward-entry:active { opacity: .86; }
.steward-entry-heading { display: flex; align-items: center; gap: 18rpx; }
.steward-entry-avatar { display: block; width: 84rpx; height: 84rpx; border-radius: 24rpx; line-height: 84rpx; text-align: center; background: #4C6A49; font-size: 52rpx; }
.steward-entry-copy { flex: 1; }
.steward-entry-label { display: block; font-size: 19rpx; color: #C3C99B; letter-spacing: 2rpx; }
.steward-entry-title { display: block; font-size: 35rpx; font-weight: 700; margin-top: 4rpx; letter-spacing: 3rpx; }
.steward-entry-arrow { font-size: 46rpx; color: #E5CA70; }
.steward-entry-description { display: block; margin-top: 20rpx; font-size: 23rpx; line-height: 1.7; color: #D3D4B4; }
.steward-entry-bottom { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14rpx; margin-top: 22rpx; padding-top: 18rpx; border-top: 1rpx solid #67774E; color: #B8C9A7; font-size: 20rpx; }
.steward-entry-action { color: #E5CA70; font-size: 23rpx; font-weight: 600; }

.mode-desc {
  display: block; font-size: 23rpx; color: #A89978;
  line-height: 1.6; margin-bottom: 22rpx;
  padding: 16rpx 20rpx;
  background: rgba(45,74,62,0.35);
  border-radius: 16rpx;
  border-left: 4rpx solid rgba(124,179,66,0.4);
}

/* ===== 木纹标题栏 ===== */
.wood-title {
  display: flex; align-items: center; justify-content: center; gap: 16rpx;
  background: linear-gradient(135deg, #8B6914, #B8860B);
  border-radius: 50rpx; padding: 16rpx 44rpx; margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.28);
}
.wood-title-leaf { font-size: 26rpx; animation: sway 3s ease-in-out infinite; }
.wood-title-text { font-size: 30rpx; font-weight: 800; color: #F5E6C8; letter-spacing: 3px; }

/* ===== 基础组件 ===== */
.card-solid {
  background: linear-gradient(135deg, #3D6254, #4A7361);
  border: 3rpx solid #B8860B; border-radius: 28rpx;
  padding: 28rpx; margin-bottom: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.25);
}
.card-solid-sm {
  background: linear-gradient(135deg, #3D6254, #4A7361);
  border: 2rpx solid rgba(184,134,11,0.5); border-radius: 18rpx;
  padding: 16rpx 20rpx; margin-bottom: 12rpx;
}
.card {
  background: rgba(61,98,84,0.55);
  border: 2rpx dashed rgba(165,190,140,0.35);
  border-radius: 20rpx; padding: 20rpx 24rpx; margin-bottom: 16rpx;
}
.btn-wood {
  display: inline-flex; align-items: center; justify-content: center;
  height: 72rpx; padding: 0 36rpx;
  background: linear-gradient(135deg, #8B6914, #B8860B);
  border-radius: 999rpx; font-size: 27rpx; font-weight: 600;
  color: #F5E6C8; border: none;
  box-shadow: 0 4rpx 14rpx rgba(0,0,0,0.25);
}
.btn-leaf {
  display: inline-flex; align-items: center; justify-content: center;
  height: 72rpx; padding: 0 36rpx;
  background: linear-gradient(135deg, #7CB342, #689F38);
  border-radius: 999rpx; font-size: 27rpx; font-weight: 600;
  color: #fff; border: none;
  box-shadow: 0 4rpx 14rpx rgba(124,179,66,0.35);
}
.quote-card {
  background: linear-gradient(135deg, rgba(74,115,97,0.8), rgba(61,98,84,0.7));
  border-left: 5rpx solid #7CB342; border-radius: 18rpx;
  padding: 18rpx 22rpx; margin-top: 20rpx;
}
.quote-card-text { font-size: 25rpx; color: #E8D9BB; line-height: 1.6; }

.section-title { font-size: 27rpx; font-weight: 700; color: #F5E6C8; margin: 20rpx 0 12rpx; }
.wood-input {
  width: 100%; height: 80rpx;
  background: rgba(45,74,62,0.5); border: 2rpx solid rgba(139,105,20,0.4);
  border-radius: 18rpx; padding: 0 24rpx;
  font-size: 27rpx; color: #F5E6C8; box-sizing: border-box;
}
.wood-textarea {
  width: 100%; min-height: 160rpx;
  background: rgba(45,74,62,0.5); border: 2rpx solid rgba(139,105,20,0.4);
  border-radius: 18rpx; padding: 20rpx 24rpx;
  font-size: 26rpx; color: #F5E6C8; line-height: 1.6; box-sizing: border-box;
}

/* ===== AI规划师 · 对话式 Agent（V9.0）===== */

/* 对话模式容器 */
.plan-chat-mode { padding-bottom: 80rpx; }
.plan-chat-card { display: flex; flex-direction: column; height: 65vh; }

/* 对话消息区 */
.plan-chat-messages { flex: 1; padding: 16rpx; min-height: 0; }

.plan-msg { display: flex; gap: 12rpx; margin-bottom: 20rpx; align-items: flex-start; }
.plan-msg-user { flex-direction: row-reverse; }
.plan-msg-avatar {
  width: 52rpx; height: 52rpx; border-radius: 50%;
  background: rgba(124,179,66,0.2);
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; flex-shrink: 0;
}

.plan-msg-bubble {
  max-width: 75%; padding: 16rpx 22rpx;
  border-radius: 20rpx; font-size: 26rpx;
  line-height: 1.8; white-space: pre-wrap; word-break: break-all;
}
.plan-bubble-ai {
  background: linear-gradient(135deg, rgba(61,98,84,0.85), rgba(74,115,97,0.85));
  color: #E8D9BB; border-bottom-left-radius: 6rpx;
  border: 1rpx solid rgba(139,105,20,0.25);
}
.plan-bubble-user {
  background: linear-gradient(135deg, #8B6914, #B8860B);
  color: #F5E6C8; border-bottom-right-radius: 6rpx;
}
.plan-thinking { opacity: 0.6; font-style: italic; }

/* 打字机闪烁光标 */
.typing-cursor {
  display: inline;
  animation: cursor-blink 0.8s steps(1) infinite;
  color: #AED581;
  font-weight: bold;
  font-size: inherit;
  margin-left: 2rpx;
}
@keyframes cursor-blink {
  0%, 50% { opacity: 1; }
  51%, 100% { opacity: 0; }
}

/* 对话输入区 */
.plan-chat-input-row {
  display: flex; gap: 8rpx; padding: 12rpx 14rpx; align-items: center;
  border-top: 1rpx dashed rgba(165,190,140,0.25);
}

/* 规划师标题栏内的重置按钮 */
.plan-reset-btn {
  display: flex; align-items: center; gap: 4rpx;
  margin-left: auto;
  padding: 4rpx 14rpx;
  background: rgba(139,105,20,0.25);
  border-radius: 20rpx;
}
.plan-reset-icon { font-size: 22rpx; }
.plan-reset-text { font-size: 22rpx; color: #C5A572; }

/* 规划信息卡片（V11.0 新增） */
.plan-info-card {
  background: linear-gradient(135deg, rgba(139,105,20,0.35), rgba(184,134,11,0.2));
  border: 2rpx solid rgba(139,105,20,0.4);
  border-radius: 18rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 18rpx;
}
.plan-info-row {
  display: flex; flex-wrap: wrap; gap: 10rpx;
}
.plan-info-item {
  font-size: 23rpx; color: #F5E6C8;
  background: rgba(61,98,84,0.5);
  border: 1rpx solid rgba(139,105,20,0.25);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}
.plan-info-missing {
  margin-top: 12rpx; padding: 10rpx 14rpx;
  background: rgba(244,143,177,0.08);
  border-radius: 12rpx;
  display: flex; align-items: center; gap: 6rpx;
}
.plan-missing-label {
  font-size: 22rpx; color: #F48FB1; font-weight: 600; flex-shrink: 0;
}
.plan-missing-fields {
  font-size: 22rpx; color: #F5E6C8;
}
.plan-info-error {
  margin-top: 10rpx; padding: 8rpx 14rpx;
  background: rgba(255,107,107,0.1);
  border-radius: 10rpx;
  font-size: 22rpx; color: #FF6B6B;
}

/* 生成任务按钮区 */
.plan-generate-area {
  padding: 16rpx; text-align: center;
  border-top: 1rpx dashed rgba(165,190,140,0.25);
}
.plan-generate-status {
  display: block; font-size: 24rpx; color: #AED581;
  margin-bottom: 8rpx; animation: pulse 1.5s ease-in-out infinite;
}
.plan-generate-hint {
  display: block; font-size: 23rpx; color: #AED581;
  margin-bottom: 12rpx;
}
.plan-generate-btn {
  height: 80rpx !important; font-size: 30rpx !important;
}

/* ═══════════ 底部抽屉弹窗 V2（三段式 Bottom Sheet）═══════════ */

/* 遮罩全屏 */
.plan-sheet-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  z-index: 9999;
}
.plan-sheet-backdrop {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0.55);
}

/* 底部弹出容器 */
.plan-sheet {
  position: absolute; left: 0; right: 0; bottom: 0;
  height: 86vh;
  max-height: 86vh;
  background: linear-gradient(180deg, #355447, #2D4A3E);
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: sheet-slide-up 0.35s ease-out;
}
@keyframes sheet-slide-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

/* 拖拽横条 */
.plan-sheet-dragbar {
  width: 72rpx;
  height: 6rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 3rpx;
  margin: 16rpx auto 8rpx;
  flex-shrink: 0;
}

/* 头部 */
.plan-sheet-header {
  padding: 0 28rpx 18rpx;
  flex-shrink: 0;
}
.plan-sheet-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.plan-sheet-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #F5E6C8;
  letter-spacing: 1px;
}
.plan-sheet-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 300;
  color: #C4B89A;
  background: rgba(139,105,20,0.2);
  border-radius: 50%;
  flex-shrink: 0;
}
.plan-sheet-close:active {
  background: rgba(139,105,20,0.35);
}
.plan-sheet-subtitle {
  font-size: 24rpx;
  color: #A89978;
  display: block;
  margin-top: 8rpx;
}

/* 可滚动 body——view 占 flex 空间，内部 scroll-view 填满 */
.plan-sheet-body {
  flex: 1;
  min-height: 0;
  max-height: 58vh;
  overflow: hidden;
}
.plan-sheet-scroll {
  width: 100%;
  height: 100%;
  padding: 0 28rpx;
  box-sizing: border-box;
}

/* ===== 卡片通用 ===== */
.bs-card {
  background: rgba(61,98,84,0.55);
  border: 2rpx solid rgba(139,105,20,0.2);
  border-radius: 20rpx;
  padding: 24rpx 22rpx;
  margin-bottom: 18rpx;
}
.bs-card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #F5E6C8;
  margin-bottom: 16rpx;
}
.bs-card-row {
  margin-bottom: 12rpx;
}
.bs-card-row:last-child {
  margin-bottom: 0;
}
.bs-card-label {
  font-size: 22rpx;
  color: #AED581;
  font-weight: 600;
  display: block;
  margin-bottom: 4rpx;
}
.bs-card-text {
  font-size: 25rpx;
  color: #E8D9BB;
  line-height: 1.6;
  display: block;
}

/* ===== B. 目标草稿 ===== */
.bs-goal-title-row {
  margin-bottom: 12rpx;
}
.bs-goal-title-label {
  font-size: 22rpx;
  color: #AED581;
  font-weight: 600;
  display: block;
  margin-bottom: 6rpx;
}
.bs-input {
  width: 100%;
  height: 72rpx;
  background: rgba(45,74,62,0.5);
  border: 2rpx solid rgba(139,105,20,0.35);
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #F5E6C8;
  box-sizing: border-box;
}

/* 阶段标签 */
.bs-stages {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.bs-stage-tag {
  background: rgba(45,74,62,0.5);
  border: 1rpx solid rgba(139,105,20,0.3);
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
}
.bs-stage-name {
  display: block;
  font-size: 24rpx;
  color: #F5E6C8;
  font-weight: 600;
}
.bs-stage-dur {
  display: block;
  font-size: 20rpx;
  color: #8B9A7D;
  margin-top: 2rpx;
}

/* ===== C. 任务编辑区 ===== */
.bs-task-item {
  background: rgba(45,74,62,0.4);
  border: 2rpx solid rgba(139,105,20,0.15);
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 12rpx;
}
.bs-task-focused {
  border-color: #d5a54d;
}
.bs-task-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.bs-task-info {
  flex: 1;
  min-width: 0;
}
.bs-task-input {
  width: 100%;
  height: 72rpx;
  background: rgba(45,74,62,0.5);
  border: 2rpx solid rgba(139,105,20,0.3);
  border-radius: 12rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  color: #F5E6C8;
  box-sizing: border-box;
  margin-bottom: 10rpx;
}
.bs-xp-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.bs-xp-label {
  font-size: 22rpx;
  color: #A89978;
  flex-shrink: 0;
}
.bs-xp-chip {
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(139,105,20,0.3);
  font-size: 22rpx;
  color: #C4B89A;
  background: transparent;
}
.bs-xp-active {
  background: linear-gradient(135deg, #7CB342, #689F38);
  color: #fff;
  border-color: #7CB342;
}
.bs-task-delete {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
  background: rgba(255,107,107,0.12);
  border-radius: 50%;
  font-size: 28rpx;
  color: #FF6B6B;
}
.bs-task-delete:active {
  background: rgba(255,107,107,0.25);
}
.bs-task-empty {
  text-align: center;
  padding: 36rpx 0;
  font-size: 24rpx;
  color: #8B9A7D;
}

/* 新增任务按钮 */
.bs-add-task-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  margin-top: 4rpx;
  border: 2rpx dashed rgba(124,179,66,0.35);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #7CB342;
  font-weight: 600;
}
.bs-add-task-btn:active {
  background: rgba(124,179,66,0.1);
}

/* ===== 固定底部操作栏（在 scroll-view 外部，永远可见） ===== */
.plan-sheet-footer {
  flex-shrink: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(0deg, #2D4A3E, rgba(45,74,62,0.98));
  border-top: 1rpx solid rgba(139,105,20,0.15);
  z-index: 2;
}
.plan-sheet-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
  border: none;
  padding: 0;
}
.plan-sheet-btn-cancel {
  background: rgba(139,105,20,0.25);
  color: #C4B89A;
}
.plan-sheet-btn-cancel:active {
  background: rgba(139,105,20,0.35);
}
.plan-sheet-btn-publish {
  background: linear-gradient(135deg, #7CB342, #558B2F);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(124,179,66,0.3);
}
.plan-sheet-btn-publish:active {
  opacity: 0.88;
}
.plan-sheet-btn-publish[disabled] {
  opacity: 0.45;
}

/* ===== 教练模式 ===== */
.stats-row { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.stat-item {
  flex: 1; text-align: center; padding: 20rpx 12rpx;
  border: 2rpx dashed rgba(165,190,140,0.35);
  border-radius: 20rpx; background: rgba(45,74,62,0.3);
}
.stat-num { display: block; font-size: 40rpx; font-weight: 800; color: #AED581; }
.stat-label { display: block; font-size: 21rpx; color: #C4B89A; margin-top: 6rpx; }
.coach-empty { text-align: center; padding: 40rpx 0; }
.coach-empty-text { font-size: 26rpx; color: #8B9A7D; }

/* ===== 答案之书 ===== */
.oracle-card { text-align: center; }
.oracle-hint {
  display: block; font-size: 24rpx; color: #A89978;
  margin-bottom: 16rpx; font-style: italic;
}
.oracle-input { text-align: center; margin-bottom: 20rpx; }
.btn-oracle { width: 100%; margin-top: 16rpx; }

/* 翻牌动画 */
.oracle-flip-area {
  display: flex; justify-content: center; padding: 30rpx 0;
}
.oracle-card-flip {
  width: 200rpx; height: 260rpx;
  background: linear-gradient(135deg, #8B6914, #DAA520);
  border-radius: 20rpx;
  animation: card-flip 1.2s ease-in-out;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.4);
}
@keyframes card-flip {
  0% { transform: rotateY(0deg) scale(1); opacity: 1; }
  50% { transform: rotateY(90deg) scale(1.05); opacity: 0.5; }
  100% { transform: rotateY(0deg) scale(1); opacity: 1; }
}

/* 答案结果 */
.oracle-result { margin-top: 24rpx; text-align: left; }
.oracle-q {
  display: block; font-size: 24rpx; color: #C4B89A;
  text-align: center; margin-bottom: 20rpx; font-style: italic;
}
.oracle-answer-box {
  background: rgba(45,74,62,0.5); border-radius: 18rpx;
  padding: 20rpx 24rpx; margin-bottom: 16rpx; text-align: center;
}
.oracle-answer-label {
  display: block; font-size: 22rpx; color: #A89978; margin-bottom: 8rpx;
}
.oracle-answer-text {
  display: block; font-size: 42rpx; font-weight: 900;
  letter-spacing: 4rpx; text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.3);
}
.oracle-explain-box {
  background: rgba(124,179,66,0.08); border-left: 4rpx solid #7CB342;
  border-radius: 14rpx; padding: 18rpx 22rpx;
}
.oracle-explain-label {
  display: block; font-size: 22rpx; color: #AED581; margin-bottom: 8rpx;
}
.oracle-explain-text { font-size: 25rpx; color: #E8D9BB; line-height: 1.65; }

/* ===== 今日运势 ===== */
.btn-fortune-btn { width: 100%; height: 88rpx; font-size: 30rpx; margin-top: 20rpx; }
.fortune-card { text-align: center; }
.fortune-date {
  display: block; font-size: 26rpx; color: #FFD54F;
  font-weight: 700; margin-bottom: 20rpx;
  letter-spacing: 2px;
}
.fortune-stars-row { display: flex; justify-content: center; gap: 24rpx; margin-bottom: 24rpx; }
.fortune-star-item { text-align: center; }
.star-label { display: block; font-size: 23rpx; color: #C4B89A; margin-bottom: 8rpx; }
.star-value { font-size: 28rpx; letter-spacing: 2rpx; }
.fortune-advice {
  background: rgba(255,215,79,0.06); border-radius: 16rpx;
  padding: 18rpx 22rpx; margin-bottom: 16rpx; text-align: left;
}
.advice-label { display: block; font-size: 24rpx; color: #FFD54F; font-weight: 700; margin-bottom: 8rpx; }
.advice-text { font-size: 25rpx; color: #E8D9BB; line-height: 1.6; }
.fortune-lucky {
  background: rgba(124,179,66,0.08); border-radius: 16rpx;
  padding: 16rpx 22rpx; text-align: left;
}
.lucky-label { display: block; font-size: 24rpx; color: #AED581; font-weight: 700; margin-bottom: 6rpx; }
.lucky-text { font-size: 26rpx; color: #F5E6C8; font-weight: 600; }

/* ===== 成长翻译 ===== */
.translate-card { text-align: left; }
.translate-result { margin-top: 20rpx; }
.trans-original, .trans-translated {
  display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx;
}
.trans-tag {
  font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 999rpx;
  font-weight: 600; flex-shrink: 0;
}
.trans-user { background: rgba(218,165,32,0.2); color: #DAA520; }
.trans-ai { background: rgba(124,179,66,0.2); color: #7CB342; }
.trans-text { font-size: 26rpx; color: #F5E6C8; }
.trans-encourage { display: flex; align-items: flex-start; gap: 12rpx; }
.encourage-icon { font-size: 28rpx; flex-shrink: 0; }
.encourage-text { font-size: 25rpx; color: #E8D9BB; line-height: 1.6; }

/* ===== 昵称生成器 ===== */
.nickname-card { text-align: left; }
.nick-hint { display: block; font-size: 23rpx; color: #A89978; margin-bottom: 12rpx; }
.nickname-results { margin-top: 20rpx; }
.nickname-item {
  display: flex; align-items: center; gap: 14rpx;
  padding: 16rpx 20rpx; margin-bottom: 10rpx;
}
.nickname-prefix {
  font-size: 22rpx; color: #DAA520; font-weight: 800;
  min-width: 48rpx; flex-shrink: 0;
}
.nickname-text { flex: 1; font-size: 28rpx; font-weight: 700; color: #F5E6C8; }
.nickname-copy {
  font-size: 22rpx; color: #7CB342; padding: 6rpx 18rpx;
  border: 2rpx solid rgba(124,179,66,0.4); border-radius: 999rpx;
  flex-shrink: 0;
}

/* ===== 目标命名器 ===== */
.goalname-card { text-align: left; }
.gn-hint { display: block; font-size: 23rpx; color: #A89978; margin-bottom: 12rpx; }
.goalname-results { margin-top: 20rpx; }
.gn-before {
  display: block; font-size: 23rpx; color: #8B9A7D;
  margin-bottom: 12rpx; text-decoration: line-through;
}
.goalname-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx 22rpx; margin-bottom: 10rpx;
}
.gn-name { min-width: 0; word-break: break-all; font-size: 29rpx; font-weight: 800; color: #FFD54F; }
.gn-use {
  font-size: 22rpx; color: #7CB342; padding: 6rpx 18rpx;
  border: 2rpx solid rgba(124,179,66,0.4); border-radius: 999rpx;
}

/* ===== 未来来信 ===== */
.future-card { text-align: left; }
.future-hint { display: block; font-size: 23rpx; color: #A89978; margin-bottom: 12rpx; }
.future-letter-result { margin-top: 24rpx; }
.letter-header { text-align: center; margin-bottom: 20rpx; }
.letter-from {
  display: block; font-size: 24rpx; color: #F48FB1;
  font-weight: 700; margin-bottom: 6rpx;
}
.letter-dream { display: block; font-size: 23rpx; color: #C4B89A; }
.letter-body { background: rgba(244,143,177,0.04); }
.letter-content {
  font-size: 25rpx; color: #E8D9BB; line-height: 1.75;
  white-space: pre-wrap;
}

/* ===== 时间胶囊 ===== */
.capsule-card { text-align: left; }
.capsule-hint { display: block; font-size: 23rpx; color: #A89978; margin-bottom: 12rpx; }
.capsule-saved-view { text-align: center; }
.capsule-sealed {
  padding: 32rpx 0 24rpx;
}
.sealed-icon { font-size: 80rpx; display: block; margin-bottom: 16rpx; }
.sealed-text {
  display: block; font-size: 30rpx; font-weight: 800; color: #80CBC4;
  margin-bottom: 10rpx;
}
.sealed-date { display: block; font-size: 23rpx; color: #C4B89A; margin-bottom: 4rpx; }
.sealed-open { display: block; font-size: 23rpx; color: #80CBC4; }
.capsule-content-preview { text-align: left; margin: 20rpx 0; }
.preview-label { display: block; font-size: 22rpx; color: #A89978; margin-bottom: 8rpx; }
.preview-text { font-size: 25rpx; color: #F5E6C8; line-height: 1.5; }

/* ===== 随机挑战 ===== */
.challenge-draw-btn { width: 100%; height: 96rpx; font-size: 32rpx; margin-top: 30rpx; }
.challenge-card { text-align: center; }
.challenge-active { padding: 20rpx 0; }
.challenge-icon-lg { font-size: 120rpx; display: block; margin-bottom: 20rpx; animation: bounce-gentle 2s ease-in-out infinite; }
@keyframes bounce-gentle {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}
.challenge-task {
  display: block; font-size: 36rpx; font-weight: 800; color: #F5E6C8;
  margin-bottom: 24rpx; letter-spacing: 2px;
}
.challenge-reward {
  display: inline-block; background: rgba(255,215,79,0.08);
  border: 2rpx solid rgba(255,215,79,0.25);
  border-radius: 999rpx; padding: 10rpx 28rpx; margin-bottom: 24rpx;
}
.reward-label { display: block; font-size: 21rpx; color: #A89978; }
.reward-xp { display: block; font-size: 28rpx; font-weight: 800; color: #FFD54F; margin-top: 4rpx; }
.challenge-done-btn { width: 85%; font-size: 28rpx; }
.challenge-completed { padding: 30rpx 0; }
.completed-badge {
  display: block; font-size: 36rpx; font-weight: 900; color: #7CB342;
  margin-bottom: 20rpx;
}
.completed-task { display: block; font-size: 26rpx; color: #C4B89A; margin-bottom: 10rpx; text-decoration: line-through; }
.completed-xp { display: block; font-size: 28rpx; font-weight: 700; color: #FFD54F; }

/* ===== 聊天模式 ===== */
.chat-area { display: flex; flex-direction: column; height: 60vh; }
.chat-messages { flex: 1; padding: 16rpx; }
.msg { display: flex; gap: 12rpx; margin-bottom: 20rpx; align-items: flex-start; }
.msg-user { flex-direction: row-reverse; }
.msg-avatar {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: rgba(124,179,66,0.2);
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; flex-shrink: 0;
}
.msg-bubble {
  max-width: 70%; padding: 16rpx 22rpx;
  border-radius: 20rpx; font-size: 25rpx;
  line-height: 1.55; word-break: break-all;
}
.bubble-wood {
  background: linear-gradient(135deg, #8B6914, #B8860B);
  color: #F5E6C8; border-bottom-right-radius: 6rpx;
}
.bubble-leaf {
  background: linear-gradient(135deg, rgba(124,179,66,0.85), rgba(104,159,56,0.85));
  color: #fff; border-bottom-left-radius: 6rpx;
}
.chat-empty { text-align: center; padding: 60rpx 0; }
.chat-empty-icon { font-size: 64rpx; display: block; margin-bottom: 12rpx; opacity: 0.5; }
.chat-empty-text { font-size: 25rpx; color: #8B9A7D; }
.chat-input-row {
  display: flex; gap: 12rpx; padding: 16rpx;
  border-top: 1rpx dashed rgba(165,190,140,0.25);
}
.wood-chat-input {
  flex: 1 1 0%; min-width: 0; height: 72rpx;
  background: rgba(45,74,62,0.5);
  border: 2rpx solid rgba(139,105,20,0.4);
  border-radius: 36rpx; padding: 0 24rpx;
  font-size: 26rpx; color: #F5E6C8;
}
/* 规划师发送按钮 — 紧凑小按钮 */
.plan-send-btn {
  flex-shrink: 0;
  height: 64rpx !important; line-height: 64rpx !important;
  padding: 0 20rpx !important; font-size: 24rpx !important;
  min-width: 96rpx !important; border-radius: 32rpx !important;
  background: linear-gradient(135deg, #8B6914, #A67C00) !important;
  color: #FFF8E1 !important; margin: 0 !important;
}
