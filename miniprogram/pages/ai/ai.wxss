  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
  border: none;
  padding: 0;
  background: rgba(139,105,20,0.25);
  color: #C4B89A;
}
.tool-sheet-btn:active {
  background: rgba(139,105,20,0.35);
}

/* ===== 工具内容通用 ===== */
.tool-content {
