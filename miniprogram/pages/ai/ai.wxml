  <!-- ==================== 成长翻译 ==================== -->
  <view wx:elif="{{mode === 'translate'}}" class="mode-container">
    <view class="wood-title">
      <text class="wood-title-leaf">🌐</text><text class="wood-title-text">成长翻译官</text>
      <text class="wood-title-leaf">🌐</text>
    </view>
    <view class="card-solid translate-card">
      <text class="mode-desc">写下此刻的感受。森林给你一句鼓励和一个可以尝试的小动作。</text>
      <input class="wood-input" maxlength="120" placeholder="例如：复习太难，今天有点想放弃" value="{{translateInput}}" bindinput="onTranslateInput" confirm-type="go" bindconfirm="doTranslate" />
      <button class="btn-leaf" bindtap="doTranslate">🌱 换个说法</button>

      <view wx:if="{{translateResult}}" class="translate-result">
        <view class="trans-original">
          <text class="trans-tag trans-user">你说的</text>
          <text class="trans-text">{{translateResult.original}}</text>
        </view>
        <view class="trans-translated">
          <text class="trans-tag trans-ai">可以先试</text>
          <text class="trans-text">{{translateResult.nextStep}}</text>
        </view>
        <button class="toolbox-action" bindtap="openTool" data-tool="delayHelp">试试拖延急救</button>
        <view class="trans-encourage quote-card">
          <text class="encourage-icon">💚</text>
          <text class="encourage-text">{{translateResult.encourage}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ==================== 昵称生成器 ==================== -->
  <view wx:elif="{{mode === 'nickname'}}" class="mode-container">
    <view class="wood-title">
      <text class="wood-title-leaf">✨</text><text class="wood-title-text">昵称生成器</text>
      <text class="wood-title-leaf">✨</text>
    </view>
    <view class="card-solid nickname-card">
      <text class="mode-desc">用你的技能、爱好或性格关键词，组合几个可复制的森林昵称。</text>
      <text class="nick-hint">输入关键词，用空格或逗号分隔多个词</text>
      <input class="wood-input" maxlength="50" placeholder="如：程序员 英语 AI 运动" value="{{nicknameInput}}" bindinput="onNicknameInput" />
      <button class="btn-leaf" bindtap="generateNickname">✨ 生成昵称</button>

      <view wx:if="{{nicknames.length > 0}}" class="nickname-results">
        <view wx:for="{{nicknames}}" wx:key="index" class="nickname-item card">
          <text class="nickname-prefix">#{{index + 1}}</text>
          <text class="nickname-text">{{item}}</text>
          <text class="nickname-copy" catchtap="copyNick" data-name="{{item}}">复制</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ==================== 目标命名器 ==================== -->
  <view wx:elif="{{mode === 'goalname'}}" class="mode-container">
    <view class="wood-title">
      <text class="wood-title-leaf">🎯</text><text class="wood-title-text">目标命名器</text>
      <text class="wood-title-leaf">🎯</text>
    </view>
    <view class="card-solid goalname-card">
      <text class="mode-desc">先写想做的事，选个标题带到目标页。说明和周期可以在新建表单里继续填写。</text>
      <input class="wood-input" maxlength="35" placeholder="如：考四六级 / 早起 / 学编程" value="{{goalNameInput}}" bindinput="onGoalNameInput" />
      <button class="btn-leaf" bindtap="generateGoalName">🎯 生成候选</button>

      <view wx:if="{{goalNames.length > 0}}" class="goalname-results">
        <view wx:for="{{goalNames}}" wx:key="*this" class="goalname-item card-solid-sm">
          <text class="gn-name">{{item}}</text>
          <view class="toolbox-inline-links">
            <button class="toolbox-link" catchtap="copyToolText" data-text="{{item}}">复制</button>
            <button class="toolbox-link" catchtap="useGoalName" data-name="{{item}}">带入目标</button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ==================== 未来来信 ==================== -->
  <view wx:elif="{{mode === 'future'}}" class="mode-container">
    <view class="wood-title">
      <text class="wood-title-leaf">📨</text><text class="wood-title-text">未来来信</text>
      <text class="wood-title-leaf">📨</text>
    </view>
    <view class="card-solid future-card">
      <text class="mode-desc">写下一个愿望，读一封想象中来自三年后的信，想想今天能迈出哪一步。</text>
      <textarea class="wood-textarea" placeholder="我希望成为..." value="{{futureInput}}" bindinput="onFutureInput" auto-height maxlength="100" />
      <button class="btn-leaf" bindtap="generateFutureLetter">📨 接收来信</button>

      <view wx:if="{{futureLetter}}" class="future-letter-result">
        <view class="letter-header">
          <text class="letter-from">来自 {{futureLetter.date}} 的你</text>
          <text class="letter-dream">关于「{{futureLetter.dream}}」</text>
        </view>
        <view class="letter-body card">
          <text class="letter-content">{{futureLetter.content}}</text>
        </view>
        <button class="toolbox-action" bindtap="copyToolText" data-text="{{futureLetter.content}}">复制来信</button>
      </view>
    </view>
  </view>

  <!-- ==================== 时间胶囊 ==================== -->
  <view wx:elif="{{mode === 'capsule'}}" class="mode-container">
    <view class="wood-title">
      <text class="wood-title-leaf">⏳</text><text class="wood-title-text">时间胶囊</text>
      <text class="wood-title-leaf">⏳</text>
    </view>
    <view class="card-solid capsule-card">
      <text class="mode-desc">给 30 天后的自己写一封信，到期回工具箱打开。</text>
      <view wx:if="{{!capsuleSaved}}">
        <textarea class="wood-textarea" placeholder="30 天后，我想看看自己坚持了什么…" value="{{capsuleText}}" bindinput="onCapsuleInput" disabled="{{capsuleSaving}}" auto-height maxlength="200" />
        <button class="btn-leaf" bindtap="saveCapsule" loading="{{capsuleSaving}}" disabled="{{capsuleSaving || capsuleLoading}}">{{capsuleUnconfirmed ? '再次尝试封存' : '⏳ 封存胶囊'}}</button>
        <text wx:if="{{capsuleUnconfirmed}}" class="tool-hint">上次封存结果待确认，原文已保留。可先刷新列表核对。</text>
      </view>

      <view wx:if="{{capsuleSaved}}" class="capsule-saved-view">
        <view class="capsule-sealed">
          <text class="sealed-icon">📦</text>
          <text class="sealed-text">胶囊已封存</text>
          <text class="sealed-date">封存日期：{{capsuleDate}}</text>
          <text class="sealed-open">{{capsuleOpenDate}} 可打开</text>
        </view>
        <button class="toolbox-action" bindtap="writeAnotherCapsule">再写一封</button>
      </view>
      <view class="capsule-list">
          <button class="toolbox-action" bindtap="toggleCapsuleHistory" aria-expanded="{{capsuleHistoryExpanded}}">{{capsuleHistoryExpanded ? '收起' : '展开'}}我的胶囊 · {{myCapsules.length}} 封</button>
          <block wx:if="{{capsuleHistoryExpanded}}">
          <text wx:if="{{capsuleLoading}}" class="tool-hint">正在读取…</text>
          <button wx:elif="{{capsuleLoadError}}" class="toolbox-action" bindtap="loadCapsules">读取失败 · 重试</button>
          <text wx:elif="{{!myCapsules.length}}" class="tool-hint">还没有封存的胶囊</text>
          <button wx:if="{{capsuleUnconfirmed && !capsuleLoading && !capsuleLoadError}}" class="toolbox-link" bindtap="loadCapsules">刷新列表</button>
          <view wx:for="{{myCapsules}}" wx:key="_id" class="capsule-list-item card">
            <text class="capsule-item-icon">📦</text>
            <view class="capsule-item-body">
              <text class="capsule-item-text">{{item.can_open ? '已到开启日' : '封存中 · ' + item.open_date + ' 可打开'}}</text>
              <text class="capsule-item-date">封存：{{item.created_date}}</text>
            </view>
            <text wx:if="{{item.can_open}}" class="capsule-item-open" catchtap="openCapsule" data-id="{{item._id}}">打开</text>
          </view>
          </block>
      </view>
    </view>
  </view>

  <!-- ==================== 随机挑战 ==================== -->
  <view wx:elif="{{mode === 'challenge'}}" class="mode-container">
    <view class="wood-title">
      <text class="wood-title-leaf">🎲</text>
      <text class="wood-title-text">随机挑战</text>
      <text class="wood-title-leaf">🎲</text>
    </view>
    <view class="card-solid challenge-card">
      <text class="mode-desc">抽一件轻量的生活挑战。做完可以在本页记下完成，也可以换一个。</text>
      <button wx:if="{{!challenge}}" class="btn-wood challenge-draw-btn" bindtap="getChallenge">🎲 抽取今日挑战</button>

      <view wx:if="{{challenge}}" class="challenge-result">
        <!-- 未完成状态 -->
        <view wx:if="{{!challengeDone}}" class="challenge-active">
          <text class="challenge-icon-lg">{{challenge.icon}}</text>
          <text class="challenge-task">{{challenge.text}}</text>
          <button class="btn-leaf challenge-done-btn" bindtap="completeChallenge">✅ 我完成了！</button>
          <button class="toolbox-action" bindtap="getChallenge">换个挑战</button>
        </view>

        <!-- 已完成状态 -->
        <view wx:if="{{challengeDone}}" class="challenge-completed">
          <text class="completed-badge">🎉 挑战完成！</text>
          <text class="completed-task">{{challenge.icon}} {{challenge.text}}</text>
          <button class="btn-wood" bindtap="getChallenge" style="margin-top:20rpx;">🎲 再来一题</button>
        </view>
      </view>
    </view>
  </view>

  <view id="page-bottom-anchor" style="height:1px;"></view>
    </view>
  </scroll-view>

  <view wx:else class="pc-chat" style="{{pcKeyboard ? 'bottom:' + pcKeyboard + 'px' : ''}}">
    <scroll-view wx:if="{{pcScreen === 'picker'}}" scroll-y class="pc-picker">
      <view class="pc-picker-head">
        <button class="pc-small pc-picker-back" bindtap="switchMode" data-mode="menu" aria-label="返回 AI 首页">‹ 返回</button>
        <text class="pc-picker-title">和谁聊聊？</text>
      </view>
      <view wx:if="{{pcLoading}}" class="pc-state">正在找森林伙伴…</view>
      <view wx:elif="{{pcLoadError}}" class="pc-state">
        <text>{{pcLoadError}}</text><button class="pc-small" bindtap="pcReload">重新读取</button>
      </view>
      <view wx:elif="{{!pcPets.length}}" class="pc-state">
        <text>森林里还没有伙伴</text><button class="pc-small" bindtap="pcForest">去森林看看</button>
      </view>
      <block wx:else>
        <text class="pc-picker-hint">{{pcUpgrade ? '当前可查看宠物档案' : pcCanChoose ? '选一只伙伴，慢慢说。' : '孵化后就能和它聊天'}}</text>
        <swiper class="pc-pet-swiper" current="{{pcPickerIndex}}" bindchange="pcSwipe" circular="{{pcPets.length > 1}}" duration="280"
          previous-margin="{{pcPets.length > 1 ? '132rpx' : '0rpx'}}" next-margin="{{pcPets.length > 1 ? '132rpx' : '0rpx'}}">
          <swiper-item wx:for="{{pcPets}}" wx:key="id">
            <view class="pc-pet-card {{pcPickerIndex === index ? '' : 'pc-pet-card-side'}}" role="button" aria-disabled="{{!item.is_hatched}}" data-id="{{item.id}}" bindtap="pcPick">
              <view class="pc-picker-avatar">
                <view wx:if="{{item.portrait}}" class="pc-picker-portrait">
                  <pet-portrait species="{{item.portrait.species}}" form="{{item.portrait.form}}" theme="{{item.portrait.theme}}"
                    active="{{pcPickerIndex === index && !pcPanel}}" label="{{item.speciesName}}" color-style="{{item.colorStyle}}" fallback-emoji="{{item.emoji}}" />
                </view>
                <text wx:else>{{item.emoji}}</text>
              </view>
              <view class="pc-picker-name"><text>{{item.name}}</text><text wx:if="{{item.rarityName}}" class="pc-picker-badge">{{item.rarityName}}</text></view>
              <text class="pc-meta">{{item.is_hatched ? (item.temperamentName || item.speciesName) + ' · ' + item.stageName : '孵化中'}}{{item.distinction ? ' · ' + item.distinction : ''}}</text>
              <text class="pc-card-cta {{!item.is_hatched ? 'pc-card-cta-idle' : ''}}">{{item.is_hatched ? (pcUpgrade ? '查看档案 ›' : '和' + item.name + '聊天 ›') : '待孵化'}}</text>
            </view>
          </swiper-item>
        </swiper>
        <view wx:if="{{pcPets.length > 1}}" class="pc-picker-dots">
          <view wx:for="{{pcPets}}" wx:key="id" class="pc-picker-dot {{pcPickerIndex === index ? 'pc-dot-active' : ''}}"
            data-index="{{index}}" bindtap="pcPickerDot" role="button" aria-label="查看{{item.name}}"><view></view></view>
        </view>
        <text wx:if="{{pcPets.length > 1}}" class="pc-picker-hint pc-picker-help">左右滑动切换伙伴</text>
        <button wx:if="{{!pcCanChoose}}" class="pc-small pc-picker-link" bindtap="pcForest">去森林看看</button>
        <button wx:if="{{pcUpgrade}}" class="pc-small pc-picker-link" bindtap="pcReload">重新检测聊天服务</button>
      </block>
    </scroll-view>
    <view wx:elif="{{pcLoadError}}" class="pc-state">
      <text>{{pcLoadError}}</text><button class="pc-small" bindtap="pcReload">重新读取</button>
    </view>
    <view wx:elif="{{pcLoading}}" class="pc-state">正在找森林伙伴…</view>
    <block wx:else>
      <view class="pc-head {{pcHeadCollapsed ? 'pc-head-compact' : ''}}" data-region="header"
        bindtouchstart="pcTouchStart" bindtouchmove="pcTouchMove" bindtouchend="pcTouchEnd" bindtouchcancel="pcTouchCancel">
        <button class="pc-small pc-return pc-head-back" bindtap="pcBackToPicker" aria-label="返回选宠页">‹ 返回</button>
        <view class="pc-ident">
          <view class="pc-avatar">
            <view wx:if="{{pcPet.portrait}}" class="pc-rig">
              <pet-portrait id="pc-portrait" active="{{pcAnimate}}" species="{{pcPet.portrait.species}}" form="{{pcPet.portrait.form}}" theme="{{pcPet.portrait.theme}}"
                label="{{pcPet.speciesName}}" color-style="{{pcPet.colorStyle}}" fallback-emoji="{{pcPet.emoji}}" />
            </view>
            <text wx:else>{{pcPet.emoji}}</text>
          </view>
          <view class="pc-ident-text">
            <text class="pc-head-caption" wx:if="{{!pcHeadCollapsed}}">你养大的伙伴</text>
            <button class="pc-name pc-head-name" bindtap="pcExpandHead" aria-label="{{pcHeadCollapsed ? '展开' : ''}}{{pcPet.name}}">{{pcPet.name}}</button>
            <view class="pc-identity-meta">
              <text wx:if="{{!pcHeadCollapsed}}" class="pc-meta">{{pcPet.temperamentName || pcPet.speciesName}} · {{pcPet.stageName}}{{pcPet.distinction ? ' · ' + pcPet.distinction : ''}}</text>
              <button class="pc-small pc-role-link" bindtap="pcRole">角色卡 ›</button>
            </view>
          </view>
        </view>
      </view>
      <scroll-view wx:if="{{pcMeet}}" scroll-y enhanced show-scrollbar="{{false}}" class="pc-messages"
        bindscroll="pcMessageScroll" binddragstart="pcDragStart" binddragging="pcDragging" binddragend="pcDragEnd"
        bindtouchstart="pcTouchStart" bindtouchmove="pcTouchMove" bindtouchend="pcTouchEnd" bindtouchcancel="pcTouchCancel">
        <view class="pc-card pc-meeting">
          <text class="pc-card-title">{{pcMeet === 'restart' ? '重新认识' : '第一次见面'}}</text>
          <text class="pc-copy">{{pcPet.name}}认得你是养大它的人。你想让它怎么称呼你？</text>
          <view class="pc-options pc-meet-options">
            <button class="{{pcMeetAddress === '爸爸' ? 'pc-selected' : ''}}" data-value="爸爸" bindtap="pcMeetAddress">爸爸</button>
            <button class="{{pcMeetAddress === '妈妈' ? 'pc-selected' : ''}}" data-value="妈妈" bindtap="pcMeetAddress">妈妈</button>
            <button class="{{pcMeetAddress === 'custom' ? 'pc-selected' : ''}}" data-value="custom" bindtap="pcMeetAddress">自定义</button>
            <button class="{{pcMeetAddress === '你' ? 'pc-selected' : ''}}" data-value="你" bindtap="pcMeetAddress">先叫「你」</button>
          </view>
          <input wx:if="{{pcMeetAddress === 'custom'}}" class="pc-input" value="{{pcMeetCustom}}" maxlength="12" placeholder="想让它怎么叫你" bindinput="pcMeetCustom" />
          <button class="pc-send pc-use" bindtap="pcBegin" disabled="{{pcSaving}}" loading="{{pcSaving}}">{{pcMeet === 'restart' ? '重新认识' : '和它说第一句话'}}</button>
        </view>
      </scroll-view>
      <block wx:else>
      <scroll-view scroll-y class="pc-messages" scroll-into-view="{{pcAnchor}}" enhanced show-scrollbar="{{false}}"
        bindscroll="pcMessageScroll" binddragstart="pcDragStart" binddragging="pcDragging" binddragend="pcDragEnd"
        bindtouchstart="pcTouchStart" bindtouchmove="pcTouchMove" bindtouchend="pcTouchEnd" bindtouchcancel="pcTouchCancel">
        <view wx:if="{{!pcReady && !pcStatus}}" class="pc-state">正在读取这只宠物的聊天…</view>
        <view wx:if="{{pcFirstLine}}" class="pc-turn">
          <view class="pc-day">{{pcBondGrowth.newborn ? '初次破壳' : '初次相识'}}</view>
          <view class="pc-msg"><text class="pc-bubble">{{pcFirstLine}}</text></view>
        </view>
        <view wx:elif="{{pcReady && !pcTurns.length && !pcPending.length && !pcQueue.length && !pcHeld.length}}" class="pc-state">
          和 {{pcPet.name}} 说说现在想说的事。
        </view>
        <view wx:for="{{pcTurns}}" wx:for-item="turn" wx:for-index="turnIndex" wx:key="id" class="pc-turn">
          <view wx:if="{{turn.dateLabel}}" class="pc-day">{{turn.dateLabel}}</view>
          <view wx:for="{{turn.messages}}" wx:key="index" class="pc-msg pc-mine">
            <text class="pc-bubble" selectable>{{item}}</text>
          </view>
          <view wx:for="{{turn.replies}}" wx:key="index" class="pc-msg {{index > 0 ? 'pc-follow' : ''}}">
            <view wx:if="{{index === 0}}" class="pc-msg-icon">
              <view wx:if="{{pcPet.portrait}}" class="pc-rig">
                <pet-portrait still species="{{pcPet.portrait.species}}" form="{{pcPet.portrait.form}}" label="{{pcPet.speciesName}}" color-style="{{pcPet.colorStyle}}" fallback-emoji="{{pcPet.emoji}}" />
              </view>
              <text wx:else>{{pcPet.emoji}}</text>
            </view>
            <text class="pc-bubble" selectable>{{item}}</text>
          </view>
          <button wx:if="{{pcReady && turn.messages.length && turnIndex === pcTurns.length - 1}}" class="pc-note-link" bindtap="pcOpenNote" data-turn="{{turn.id}}" data-text="{{turn.messages[turn.messages.length - 1]}}">留到下次</button>
        </view>
        <view wx:for="{{pcPending}}" wx:key="index" class="pc-msg pc-mine"><text class="pc-bubble">{{item}}</text></view>
        <view wx:for="{{pcQueue}}" wx:key="index" class="pc-msg pc-mine"><text class="pc-bubble">{{item}}</text></view>
        <view wx:for="{{pcHeld}}" wx:key="index" class="pc-msg pc-mine"><text class="pc-bubble">{{item}}</text></view>
        <view wx:if="{{pcStatus}}" class="pc-state pc-status">
          <text>{{pcStatus}}</text>
          <view class="pc-actions">
            <button wx:if="{{pcCanCheck}}" class="pc-small" bindtap="pcCheck">查看结果</button>
            <button wx:if="{{pcCanRetry}}" class="pc-small" bindtap="pcRetry">重试</button>
            <button wx:if="{{pcCanRevise}}" class="pc-small" bindtap="pcRevise">转回待发</button>
            <button wx:if="{{!pcReady}}" class="pc-small" bindtap="pcReload">重新读取</button>
            <button wx:if="{{pcNeedsConfig}}" class="pc-small" bindtap="pcConfig">去 AI 配置</button>
          </view>
        </view>
        <view id="pc-bottom" style="height:1px"></view><view id="pc-end" style="height:1px"></view>
      </scroll-view>
      <view class="pc-compose">
        <view class="pc-actions pc-compose-actions">
          <button class="pc-small {{pcListen ? 'pc-selected' : ''}}" bindtap="pcToggleListen" disabled="{{!pcReady}}">{{pcListen ? '说完了，请回应' : '先听我说'}}</button>
        </view>
        <view wx:if="{{pcListen}}" class="pc-meta pc-listening">{{pcPet.name}}在听。说完后再一起回应。</view>
        <view class="pc-input-row">
          <input class="pc-input" value="{{pcInput}}" maxlength="320" placeholder="和{{pcPet.name}}说点什么…" confirm-type="send" adjust-position="{{false}}" bindkeyboardheightchange="pcKeyboardChange" bindblur="pcKeyboardClose" bindinput="pcInput" bindconfirm="pcSend" />
          <button class="pc-send" disabled="{{!pcReady || (!pcInput && (!pcQueue.length || pcListen || pcSending || pcStatus))}}" bindtap="pcSend">发送</button>
        </view>
      </view>
      </block>
    </block>
    <button wx:if="{{pcScreen === 'conversation' && (pcLoadError || pcLoading)}}" class="pc-small pc-return pc-state-return" bindtap="pcBackToPicker" aria-label="返回选宠页">返回</button>
  </view>

  <view wx:if="{{mode === 'chat' && pcPanel}}" class="pc-overlay">
    <view class="pc-backdrop" bindtap="pcClose"></view>
    <view class="pc-sheet">
      <view class="pc-handle"></view>
      <view class="pc-sheet-title">
        <text>{{pcPanel === 'role' ? pcPet.name + '的角色卡' : '留到下次'}}</text>
        <button class="pc-small" bindtap="pcClose">关闭</button>
      </view>
      <scroll-view scroll-y class="pc-sheet-body" enhanced show-scrollbar="{{false}}">
        <block wx:if="{{pcPanel === 'role'}}">
          <view class="pc-role-head">
            <view class="pc-avatar pc-role-avatar">
              <view wx:if="{{pcPet.portrait}}" class="pc-rig">
                <pet-portrait active="{{pcAnimate}}" species="{{pcPet.portrait.species}}" form="{{pcPet.portrait.form}}" theme="{{pcPet.portrait.theme}}"
                  label="{{pcPet.speciesName}}" color-style="{{pcPet.colorStyle}}" fallback-emoji="{{pcPet.emoji}}" />
              </view>
              <text wx:else>{{pcPet.emoji}}</text>
            </view>
            <view class="pc-ident-text"><text class="pc-name">{{pcPet.name}}</text>
              <text class="pc-meta">{{pcPet.speciesName}} · {{pcPet.stageName}} · {{pcPet.talentGrade}} 级天赋</text></view>
          </view>
          <view class="pc-tabs">
            <button class="{{pcTab === 'profile' ? 'pc-selected' : ''}}" bindtap="pcTab" data-tab="profile">角色档案</button>
            <button wx:if="{{pcReady}}" class="{{pcTab === 'style' ? 'pc-selected' : ''}}" bindtap="pcTab" data-tab="style">相处设置</button>
          </view>
          <block wx:if="{{pcTab === 'profile'}}">
            <view class="pc-card">
              <text class="pc-card-title">天生的性格</text>
              <text class="pc-copy">{{pcPet.innateLabel}}</text>
              <text wx:if="{{pcPet.forestPersonality}}" class="pc-meta">森林里的性格描述　{{pcPet.forestPersonality}}</text>
              <text wx:if="{{pcPet.originalWish}}" class="pc-meta">森林里的性格期望　{{pcPet.originalWish}}</text>
            </view>
            <view class="pc-card">
              <text class="pc-card-title">陪伴状态</text>
              <text class="pc-copy">宠物心情　{{pcPet.moodName}}　·　亲密度 {{pcPet.bond || 0}} / 1000</text>
            </view>
            <view class="pc-card">
              <button class="pc-disclosure" bindtap="pcGrowth" aria-expanded="{{pcGrowth}}">从蛋到现在 <text>{{pcGrowth ? '收起 −' : '展开 +'}}</text></button>
              <block wx:if="{{pcGrowth}}">
                <text wx:if="{{pcBondGrowth ? pcBondGrowth.bornDate : pcPet.since}}" class="pc-meta">破壳　{{pcBondGrowth ? pcBondGrowth.bornDate : pcPet.since}}</text>
                <text wx:if="{{pcBondGrowth.date}}" class="pc-meta">开始相识　{{pcBondGrowth.date}}</text>
                <text class="pc-card-title pc-learn-title">后来学会的习惯</text>
                <view wx:for="{{pcBondGrowth.habits}}" wx:key="slot" class="pc-learn-item">
                  <view><text class="pc-copy">{{item.label}}</text><text class="pc-meta">{{item.date}} · {{item.sourceCount ? '从日常相处学到' : '由你纠正'}}</text></view>
                  <view class="pc-actions pc-compose-actions">
                    <button class="pc-small" data-slot="{{item.slot}}" data-value="{{item.value}}" bindtap="pcCorrectHabit" disabled="{{pcSaving}}">纠正</button>
                    <button class="pc-small" data-slot="{{item.slot}}" bindtap="pcRemoveHabit" disabled="{{pcSaving}}">撤回</button>
                  </view>
                </view>
                <text wx:if="{{!pcBondGrowth.habits.length}}" class="pc-meta">一起多聊几次，它会慢慢学会怎么陪你。</text>
                <text class="pc-card-title pc-learn-title">身体成长</text>
                <text class="pc-copy">Lv.{{pcPet.level || 1}} · 成长 {{pcPet.growth_value || 0}} · {{pcPet.colorName}} · {{pcPet.talentName}}</text>
                <view class="pc-attributes"><text wx:for="{{pcPet.attrList}}" wx:key="key">{{item.label}} {{item.val}}</text></view>
                <text wx:for="{{pcPet.records}}" wx:key="index" class="pc-meta">{{item.date}} {{item.message}}</text>
              </block>
            </view>
            <view wx:if="{{pcReady}}" class="pc-card">
              <button class="pc-disclosure" bindtap="pcOpenNote">聊天记忆 <text>{{pcNote ? '查看待续 ›' : '添加待续 ›'}}</text></button>
              <text wx:if="{{pcNote}}" class="pc-copy">{{pcNote.text}}</text>
              <text class="pc-meta">展示最近 7 天、最多 20 轮，打开时清理过期记录。发送时使用已保存的 AI 模型配置。</text>
              <button class="pc-link" bindtap="pcClear">清空这只的近期聊天</button>
            </view>
          </block>
          <block wx:elif="{{pcReady}}">
            <view class="pc-card">
              <view class="pc-pref"><text>怎么称呼我</text>
                <input value="{{pcDraft.address}}" bindinput="pcEdit" data-key="address" maxlength="12" placeholder="默认用「你」" /></view>
              <view wx:for="{{pcBasicGroups}}" wx:for-item="group" wx:key="key" class="pc-pref">
                <text>{{group.title}}</text>
                <view class="pc-options"><button wx:for="{{group.values}}" wx:key="value"
                  class="{{pcDraft[group.key] === item.value && (!pcBondGrowth || (group.key !== 'tone' && group.key !== 'comfort') || pcManual[group.key]) ? 'pc-selected' : ''}}" data-key="{{group.key}}" data-value="{{item.value}}" bindtap="pcEdit">{{item.label}}</button></view>
              </view>
              <text wx:if="{{pcBondGrowth}}" class="pc-meta">语气与安慰方式留空时，随它自己的性格和习惯成长。</text>
            </view>
            <view class="pc-card">
              <button class="pc-disclosure" bindtap="pcMore" aria-expanded="{{pcMore}}">更多表达偏好 <text>{{pcMore ? '收起 −' : '长短、动作、记忆 +'}}</text></button>
              <block wx:if="{{pcMore}}">
                <view wx:for="{{pcMoreGroups}}" wx:for-item="group" wx:key="key" class="pc-pref">
                  <text>{{group.title}}</text>
                  <view class="pc-options"><button wx:for="{{group.values}}" wx:key="value"
                    class="{{pcDraft[group.key] === item.value ? 'pc-selected' : ''}}" data-key="{{group.key}}" data-value="{{item.value}}" bindtap="pcEdit">{{item.label}}</button></view>
                </view>
                <textarea value="{{pcDraft.wish}}" bindinput="pcEdit" data-key="wish" maxlength="100" auto-height class="pc-textarea" placeholder="补充偏好，例如：不用每句都问我问题" />
              </block>
            </view>
            <view class="pc-card pc-preview"><text class="pc-card-title">同一句话 · 语气示例</text><text class="pc-copy">{{pcPreview}}</text></view>
          </block>
        </block>
        <block wx:elif="{{pcPanel === 'note'}}">
          <text class="pc-meta">仅 {{pcPet.name}} 可用。保存一条待续事项，30 天后到期。</text>
          <textarea class="pc-textarea" value="{{pcNoteInput}}" bindinput="pcNoteInput" maxlength="140" auto-height placeholder="下次想接着聊什么？" />
          <view class="pc-save-row">
            <button wx:if="{{pcNote}}" class="pc-link" data-remove="{{true}}" bindtap="pcSaveNote" disabled="{{pcSaving}}">删除待续</button>
            <button class="pc-send" bindtap="pcSaveNote" disabled="{{pcSaving || !pcNoteInput}}" loading="{{pcSaving}}">留给下次</button>
          </view>
        </block>
      </scroll-view>
      <view wx:if="{{pcPanel === 'role' && pcTab === 'style' && pcReady}}" class="pc-save-row pc-style-footer">
        <button class="pc-link" bindtap="pcReset" disabled="{{pcSaving}}">恢复默认</button>
        <button class="pc-send" bindtap="pcSave" loading="{{pcSaving}}" disabled="{{pcSaving}}">保存 · 下一轮生效</button>
      </view>
    </view>
  </view>

  <!-- ==================== AI规划师任务发布弹窗 ==================== -->
  <view wx:if="{{showPlanModal}}" class="plan-sheet-mask" catchtouchmove>
    <view class="plan-sheet-backdrop"></view>
    <view class="plan-sheet">
      <view class="plan-sheet-header">
        <view class="plan-sheet-dragbar"></view>
        <view class="plan-sheet-title-row">
          <text class="plan-sheet-title">{{draftSource === 'local_template' ? '本地模板草案' : '成长计划草案'}}</text>
          <text class="plan-sheet-close" bindtap="closePlanModal">×</text>
        </view>
        <text class="plan-sheet-subtitle">确认后会创建目标和按日期安排的任务</text>
        <text wx:if="{{publicationPending}}" class="bs-schedule-hint">{{publicationMessage}}</text>
      </view>
      <view class="plan-sheet-body">
        <scroll-view scroll-y class="plan-sheet-scroll" scroll-into-view="{{planEditAnchor}}">
          <template is="planner-draft-status" data="{{draftCloudState, draftCloudError, draftSource, cloudDraftRevision, draftBackupAvailable, publicationPending, hasDraft: !!plannerState.generatedGoal}}" />
          <view wx:if="{{draftAssumptions.length}}" class="bs-card">
            <view class="bs-card-title">待核对的草案假设</view>
            <text wx:for="{{draftAssumptions}}" wx:key="field" class="planner-draft-caption">{{item.field === 'deadline' ? '建议周期：' : ''}}{{item.value}}</text>
            <text class="bs-schedule-hint">可以随时生成计划；未说明的信息会保留为建议，不会当作你已确认。</text>
          </view>
          <view class="bs-card bs-card-analysis">
            <view class="bs-card-title">📊 需求与草案说明</view>
            <view wx:if="{{plannerState.goalContext.why || plannerState.localAssess}}" class="bs-card-row">
              <text class="bs-card-label">动机</text>
              <text class="bs-card-text">{{plannerState.goalContext.why || plannerState.localAssess}}</text>
            </view>
            <view wx:if="{{plannerState.goalContext.level}}" class="bs-card-row">
              <text class="bs-card-label">基础</text>
              <text class="bs-card-text">{{plannerState.goalContext.level}}</text>
            </view>
            <view wx:if="{{plannerState.localAssess}}" class="bs-card-row">
              <text class="bs-card-label">建议</text>
              <text class="bs-card-text">{{plannerState.localAssess}}</text>
            </view>
          </view>
          <view id="plan-settings" class="bs-card bs-card-goal">
            <view class="bs-card-title">🎯 目标草稿</view>
            <view class="bs-goal-title-row">
              <text class="bs-goal-title-label">目标名称</text>
              <input class="bs-input" value="{{plannerState.generatedGoal.title}}" bindinput="onPlanGoalTitle" placeholder="输入目标名称" disabled="{{publicationPending}}" />
            </view>
            <view wx:if="{{plannerState.goalContext.why}}" class="bs-card-row">
              <text class="bs-card-label">描述</text>
              <text class="bs-card-text">{{plannerState.goalContext.why}}</text>
            </view>
            <view class="bs-card-row">
              <text class="bs-card-label">周期</text>
              <input class="bs-schedule-number" type="number" value="{{planDays}}" bindinput="onPlanDays" disabled="{{publicationPending}}" />
              <text class="bs-card-text">天</text>
            </view>
            <view class="bs-card-row">
              <text class="bs-card-label">开始</text>
              <picker mode="date" value="{{planStartDate}}" bindchange="onPlanStartDate" disabled="{{publicationPending}}">
                <text class="bs-schedule-picker">{{planStartDate}}　选择日期</text>
              </picker>
            </view>
            <view wx:if="{{stewardDraft && !publicationPending}}" class="bs-card-row">
              <text class="bs-card-label">每天最多</text>
              <input class="bs-schedule-number" type="number" maxlength="4" value="{{plannerDailyLimit}}" bindinput="onPlannerDailyLimit" placeholder="可留空" />
              <text class="bs-card-text">分钟</text>
            </view>
            <view wx:if="{{plannerState.generatedGoal.stages && plannerState.generatedGoal.stages.length > 0}}" class="bs-card-row">
              <text class="bs-card-label">阶段</text>
              <view class="bs-stages">
                <view wx:for="{{plannerState.generatedGoal.stages}}" wx:key="index" class="bs-stage-tag">
                  <text class="bs-stage-name">{{item.name}}</text>
                  <text class="bs-stage-dur">{{item.duration}}</text>
                </view>
              </view>
            </view>
          </view>
          <view id="plan-task-list" class="bs-card bs-card-tasks">
            <view class="bs-card-title">📝 计划任务（{{editableTasks.length || 0}}）</view>
            <text class="bs-schedule-hint">请确认日期和时长，一次最多20项。未指定日期按顺序安排。</text>
            <view wx:if="{{editableTasks && editableTasks.length > 0}}">
              <view wx:for="{{editableTasks}}" wx:key="index" id="plan-task-{{index}}" class="bs-task-item {{planEditAnchor === 'plan-task-' + index ? 'bs-task-focused' : ''}}">
                <view class="bs-task-row">
                  <view class="bs-task-info">
                    <input class="bs-task-input" value="{{item.title}}" data-index="{{index}}" bindinput="editPlanTaskTitle" placeholder="输入任务描述" disabled="{{publicationPending}}" />
                    <view class="bs-task-schedule">
                      <picker mode="date" value="{{item.date}}" start="{{planStartDate}}" end="{{planEndDate}}" data-index="{{index}}" bindchange="editPlanTaskDate" disabled="{{publicationPending}}">
                        <text class="bs-schedule-picker">{{item.date}}</text>
                      </picker>
                      <input class="bs-schedule-number" type="number" value="{{item.estimated_minutes}}" data-index="{{index}}" bindinput="editPlanTaskMinutes" disabled="{{publicationPending}}" />
                      <text>分钟 · 阶段{{item.stage || 1}}</text>
                    </view>
                    <view class="bs-xp-row">
                      <text class="bs-xp-label">经验</text>
                      <view wx:for="{{[10, 20, 30]}}" wx:key="*this" wx:for-item="xp"
                            class="bs-xp-chip {{item.xp_reward === xp ? 'bs-xp-active' : ''}}"
                            data-index="{{index}}" data-xp="{{xp}}" bindtap="setPlanTaskXp">{{xp}}</view>
                    </view>
                  </view>
                  <view class="bs-task-delete" data-index="{{index}}" bindtap="deletePlanTask">
                    <text>✕</text>
                  </view>
                </view>
              </view>
            </view>
            <view wx:else class="bs-task-empty">
              <text>暂无任务，点击下方按钮新增</text>
            </view>
            <view class="bs-add-task-btn" bindtap="addPlanTask">
              <text>＋ 新增任务</text>
            </view>
          </view>
          <view style="height:20rpx;"></view>
          <view wx:if="{{stewardDraft && !publicationPending}}" class="bs-card">
            <text class="bs-card-title">协作稿检查</text>
            <text wx:if="{{auditError}}" class="planner-draft-warning">{{auditError}}</text>
            <text wx:if="{{!auditExpired && auditRules && auditRules.binding.draft_id === cloudDraftId}}" class="planner-draft-caption">{{auditRules.rules.error_count ? '还有 ' + auditRules.rules.error_count + ' 项规则问题' : '这一版规则检查已通过'}}</text>
            <view class="planner-draft-actions">
              <button bindtap="runPlannerRules" disabled="{{draftCloudState !== 'saved' || !!auditBusy}}">{{auditBusy === 'rules' ? '检查中…' : '规则复查 · 不调用模型'}}</button>
              <button bindtap="openDraftReview">查看问题与建议</button>
            </view>
          </view>
        </scroll-view>
      </view>
      <view wx:if="{{plannerState.phase !== 'publishing'}}" class="plan-review-shortcut" bindtap="openDraftReview" role="button">🔍 到审核师检查这份草案与安排 ›</view>
      <view class="plan-sheet-footer">
        <button class="plan-sheet-btn plan-sheet-btn-cancel" bindtap="closePlanModal">{{publicationPending ? '稍后确认' : '取消'}}</button>
        <button class="plan-sheet-btn plan-sheet-btn-publish" bindtap="publishPlanTasks" disabled="{{plannerState.phase === 'publishing'}}">
          {{plannerState.phase === 'publishing' ? '发布中...' : (publicationPending ? '继续确认发布' : '确认发布')}}
        </button>
      </view>
    </view>
  </view>

  <!-- ==================== 工具弹窗 Bottom Sheet ==================== -->
  <view wx:if="{{showToolSheet}}" class="tool-sheet-mask" catchtouchmove>
    <view class="tool-sheet-backdrop" bindtap="closeToolSheet"></view>
    <view class="tool-sheet">
      <view class="tool-sheet-header">
        <view class="tool-sheet-dragbar"></view>
        <view class="tool-sheet-title-row">
          <text class="tool-sheet-title">{{toolSheetTitle}}</text>
          <text class="tool-sheet-close" bindtap="closeToolSheet">×</text>
        </view>
      </view>
      <scroll-view scroll-y class="tool-sheet-body">

        <!-- ===== 番茄钟 ===== -->
        <view wx:if="{{activeTool === 'pomodoro'}}" class="tool-content">
          <view class="pomodoro-mode-row">
            <view class="pomodoro-mode-btn {{pomodoroMode === 'focus25' ? 'pomodoro-active' : ''}}" bindtap="setPomodoroMode" data-mode="focus25">
              <text class="pomodoro-mode-icon">🍅</text>
              <text class="pomodoro-mode-name">25分钟</text>
              <text class="pomodoro-mode-desc">深度专注</text>
            </view>
            <view class="pomodoro-mode-btn {{pomodoroMode === 'focus15' ? 'pomodoro-active' : ''}}" bindtap="setPomodoroMode" data-mode="focus15">
              <text class="pomodoro-mode-icon">🌿</text>
              <text class="pomodoro-mode-name">15分钟</text>
              <text class="pomodoro-mode-desc">轻专注</text>
            </view>
            <view class="pomodoro-mode-btn {{pomodoroMode === 'focus5' ? 'pomodoro-active' : ''}}" bindtap="setPomodoroMode" data-mode="focus5">
              <text class="pomodoro-mode-icon">🌱</text>
              <text class="pomodoro-mode-name">5分钟</text>
              <text class="pomodoro-mode-desc">先开始</text>
            </view>
            <view class="pomodoro-mode-btn {{pomodoroMode === 'break5' ? 'pomodoro-active' : ''}}" bindtap="setPomodoroMode" data-mode="break5">
              <text class="pomodoro-mode-icon">☕</text>
              <text class="pomodoro-mode-name">5分钟</text>
              <text class="pomodoro-mode-desc">休息</text>
            </view>
          </view>
          <view class="pomodoro-timer">
            <text class="pomodoro-time">{{pomodoroFormattedTime}}</text>
            <text class="pomodoro-status">{{pomodoroStatus}}</text>
          </view>
          <view wx:if="{{pomodoroTask && pomodoroMode !== 'break5'}}" class="toolbox-task">
            <text class="toolbox-task-caption">{{pomodoroTask.goalTitle || '本轮行动'}}</text>
            <text class="toolbox-task-name">{{pomodoroTask.text}}</text>
            <button wx:if="{{pomodoroTask.id}}" class="toolbox-link" bindtap="openToolTask">{{pomodoroSeconds === 0 ? '去原任务打卡 ›' : '查看原任务 ›'}}</button>
            <button wx:if="{{!pomodoroRunning}}" class="toolbox-link" bindtap="clearPomodoroTask">移除关联</button>
          </view>
          <view class="pomodoro-controls">
            <button wx:if="{{!pomodoroRunning}}" class="btn-leaf" bindtap="startPomodoro">{{pomodoroStatus === '已暂停' ? '继续计时' : pomodoroSeconds === 0 ? '再来一轮' : pomodoroMode === 'break5' ? '开始休息' : '开始专注'}}</button>
            <button wx:else class="btn-wood" bindtap="pausePomodoro">暂停</button>
            <button class="btn-wood" bindtap="resetPomodoro">重置</button>
          </view>
        </view>

        <!-- ===== 今日待办抽签 ===== -->
        <view wx:if="{{activeTool === 'todoDraw'}}" class="tool-content">
          <text wx:if="{{todoStatus === 'loading'}}" class="tool-hint">正在读取今日待办…</text>
          <view wx:elif="{{todoStatus === 'error'}}" class="todo-draw-area">
            <text class="todo-hint">暂时无法读取今日待办</text>
            <button class="btn-leaf" bindtap="loadTodayTodos">重新读取</button>
          </view>
          <view wx:elif="{{todoCount}}" class="todo-draw-area">
            <text class="todo-hint">进行中目标 · {{todoCount}} 项今日待办</text>
            <button wx:if="{{!drawnTodo || !drawnTodo.id}}" class="btn-leaf todo-draw-btn" bindtap="drawTodo">🎲 抽一个真实任务</button>
          </view>
          <view wx:else class="todo-draw-area">
            <text class="todo-hint">今天暂时没有可抽取的目标待办</text>
            <button class="btn-wood" bindtap="openToolGoals">去看我的目标</button>
          </view>
          <view wx:if="{{drawnTodo}}" class="todo-result">
            <text class="toolbox-task-caption">{{drawnTodo.id ? drawnTodo.goalTitle : '森林灵感 · 自选小行动'}}</text>
            <text wx:if="{{drawnTodo.icon}}" class="todo-icon">{{drawnTodo.icon}}</text>
            <text class="todo-task">{{drawnTodo.text}}</text>
            <view wx:if="{{drawnTodo.time || drawnTodo.difficulty}}" class="todo-meta">
              <text wx:if="{{drawnTodo.difficulty}}" class="todo-difficulty">{{drawnTodo.difficulty}}</text>
              <text wx:if="{{drawnTodo.time}}" class="todo-time">{{drawnTodo.time}}</text>
            </view>
            <view class="todo-actions">
              <button class="btn-wood" wx:if="{{drawnTodo.id && todoCount > 1}}" bindtap="drawTodo">换一项</button>
              <button class="btn-leaf" bindtap="focusFromTool" data-source="todo">专注这件事</button>
            </view>
            <button wx:if="{{drawnTodo.id}}" class="toolbox-link" bindtap="openToolTask" data-source="todo">查看原任务 ›</button>
          </view>
          <button wx:if="{{todoStatus !== 'loading'}}" class="toolbox-action" bindtap="drawTodoIdea">{{drawnTodo && !drawnTodo.id ? '换一条灵感' : '抽一条森林灵感'}}</button>
        </view>

        <!-- ===== 专注宣言 ===== -->
        <view wx:if="{{activeTool === 'focusOath'}}" class="tool-content">
          <text class="tool-hint">写下一个能马上开始的小动作。</text>
          <input class="wood-input" maxlength="50" placeholder="例如：背 5 个四级单词" value="{{focusInput}}" bindinput="onFocusInput" />
          <input class="wood-input" maxlength="40" placeholder="可能遇到的阻碍（选填）" value="{{focusObstacle}}" bindinput="onFocusObstacleInput" />
          <button class="btn-leaf" bindtap="generateFocusOath">📜 生成宣言</button>
          <view wx:if="{{focusOath}}" class="oath-result">
            <text class="oath-text">{{focusOath}}</text>
            <view class="oath-actions">
              <button class="btn-wood" bindtap="copyFocusOath">复制</button>
              <button class="btn-leaf" bindtap="saveFocusOath">保存到历史</button>
            </view>
            <button class="toolbox-action" bindtap="focusFromTool" data-text="{{focusInput}}">用这件事开始专注</button>
          </view>
          <view wx:if="{{focusHistory && focusHistory.length > 0}}" class="oath-history">
            <button class="toolbox-action" bindtap="toggleFocusHistory" aria-expanded="{{focusHistoryExpanded}}">{{focusHistoryExpanded ? '收起' : '展开'}}本机历史 · {{focusHistory.length}} 条</button>
            <block wx:if="{{focusHistoryExpanded}}">
            <view wx:for="{{focusHistory}}" wx:key="index" class="oath-history-item">
              <text class="oath-history-text">{{item.content}}</text>
              <text class="oath-history-date">{{item.date}}</text>
            </view>
            </block>
          </view>
        </view>

        <!-- ===== 拖延急救 ===== -->
        <view wx:if="{{activeTool === 'delayHelp'}}" class="tool-content">
          <text class="tool-hint">选择你当前的状态</text>
          <view class="delay-options">
            <view wx:for="{{delayOptions}}" wx:key="value" class="delay-option {{delaySelected === item.value ? 'delay-selected' : ''}}" bindtap="selectDelay" data-value="{{item.value}}">
              <text class="delay-icon">{{item.icon}}</text>
              <text class="delay-label">{{item.label}}</text>
            </view>
          </view>
          <view wx:if="{{delayResult}}" class="delay-result">
            <text class="delay-advice">{{delayResult.advice}}</text>
            <text class="delay-action">{{delayResult.action}}</text>
            <text class="delay-encourage">{{delayResult.encourage}}</text>
            <button class="toolbox-action" bindtap="focusFromTool" data-rest="{{delaySelected === '太累了'}}">{{delaySelected === '太累了' ? '休息 5 分钟' : '先做 5 分钟'}}</button>
          </view>
        </view>

        <!-- ===== 人格测试 ===== -->
        <view wx:if="{{activeTool === 'personality'}}" class="tool-content">
          <text class="personality-disclaimer">娱乐测试，仅供参考</text>
          <view wx:if="{{!personalityResult}}" class="personality-quiz">
            <text class="quiz-question">{{currentPersonalityQuestion.text}}</text>
            <view class="quiz-options">
              <view wx:for="{{currentPersonalityQuestion.options}}" wx:key="index" class="quiz-option" bindtap="answerPersonalityQuestion" data-type="{{item.type}}">
                <text class="quiz-option-icon">{{item.icon}}</text>
                <text class="quiz-option-text">{{item.text}}</text>
              </view>
            </view>
            <text class="quiz-progress">第 {{personalityStep + 1}} / {{personalityQuestions.length}} 题</text>
          </view>
          <view wx:if="{{personalityResult}}" class="personality-result">
            <text class="personality-type-icon">{{personalityResult.icon}}</text>
            <text class="personality-type-name">{{personalityResult.name}}</text>
            <text class="personality-keywords">{{personalityResult.keywords}}</text>
            <text class="personality-method">{{personalityResult.method}}</text>
            <text class="personality-today">{{personalityResult.today}}</text>
            <text class="personality-tools">{{personalityResult.tools}}</text>
            <button class="toolbox-action" bindtap="openTool" data-tool="todoDraw">选一个今日任务试试</button>
            <button class="btn-leaf" bindtap="resetPersonalityTest">再测一次</button>
          </view>
        </view>

        <!-- ===== 自律人格卡 ===== -->
        <view wx:if="{{activeTool === 'disciplineCard'}}" class="tool-content">
          <text class="tool-hint">选择你的自律关键词</text>
          <view class="discipline-tags">
            <view wx:for="{{disciplineTags}}" wx:key="value" class="discipline-tag {{disciplineSelected === item.value ? 'discipline-selected' : ''}}" bindtap="selectDiscipline" data-value="{{item.value}}">
              <text>{{item.label}}</text>
            </view>
          </view>
          <view wx:if="{{disciplineCard}}" class="discipline-card-result">
            <text class="card-title">{{disciplineCard.title}}</text>
            <text class="card-keyword">{{disciplineCard.keyword}}</text>
            <text class="card-advantage">{{disciplineCard.advantage}}</text>
            <text class="card-challenge">{{disciplineCard.challenge}}</text>
            <text class="card-action">{{disciplineCard.action}}</text>
            <button class="toolbox-action" bindtap="copyToolText" data-text="{{disciplineCard.action}}">复制行动建议</button>
          </view>
        </view>

        <!-- ===== 情绪能量检测 ===== -->
        <view wx:if="{{activeTool === 'energyCheck'}}" class="tool-content">
          <text class="tool-hint">选择当前能量值</text>
          <view class="energy-levels">
            <view wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="energy-level {{energyLevel === item ? 'energy-selected' : ''}}" bindtap="setEnergyLevel" data-level="{{item}}">
              <text class="energy-num">{{item}}</text>
              <text class="energy-label">{{energyLabels[item-1]}}</text>
            </view>
          </view>
          <text class="tool-hint" style="margin-top:20rpx;">选择当前情绪</text>
          <view class="emotion-options">
            <view wx:for="{{emotionOptions}}" wx:key="value" class="emotion-option {{emotionSelected === item.value ? 'emotion-selected' : ''}}" bindtap="selectEmotion" data-value="{{item.value}}">
              <text class="emotion-icon">{{item.icon}}</text>
              <text class="emotion-label">{{item.label}}</text>
            </view>
          </view>
          <view wx:if="{{energyResult}}" class="energy-result">
            <text class="energy-status">{{energyResult.status}}</text>
            <text class="energy-do">{{energyResult.do}}</text>
            <text class="energy-not-do">{{energyResult.notDo}}</text>
            <button class="toolbox-action" bindtap="focusFromTool" data-rest="{{energyLevel <= 2}}">{{energyLevel <= 2 ? '给自己 5 分钟休息' : '试试 5 分钟专注'}}</button>
            <button class="toolbox-link" bindtap="openToolMood">去首页记录心情 ›</button>
          </view>
        </view>

      </scroll-view>
      <view class="tool-sheet-footer">
        <button class="tool-sheet-btn" bindtap="closeToolSheet">关闭</button>
      </view>
    </view>
  </view>
</view>
