<template name="planner-review-rules">
  <view wx:if="{{result && result.rules && !expired}}" class="audit-rules-section">
    <text class="partner-source">规则检查 · 云端版本 {{result.binding.revision}}</text>
    <text wx:if="{{!summaryShown}}" class="partner-body-copy">{{result.rules.error_count}} 项字段/日期问题 · {{result.rules.warning_count}} 项安排提醒</text>
    <text class="partner-footnote">{{result.rules.facts.task_count}} 项任务，安排在 {{result.rules.facts.scheduled_days}} 个日期；{{result.rules.facts.daily_budget_minutes ? '明确每日投入 ' + result.rules.facts.daily_budget_minutes + ' 分钟' : '每日投入尚不明确或无法换算'}}</text>
    <view wx:for="{{result.rules.facts.daily_loads}}" wx:key="date" class="audit-load-row"><text>{{item.date}}</text><text>已知预计 {{item.estimated_minutes}} 分钟{{!item.complete ? ' · 时长未填全' : item.over_budget ? ' · 超出投入' : ''}}</text></view>
    <text wx:if="{{!result.rules.findings.length}}" class="partner-footnote">本次规则未发现问题；语义可执行性可继续交给 AI 检查。</text>
    <view wx:for="{{result.rules.findings}}" wx:key="index" class="audit-finding">
      <text class="audit-finding-label">{{item.severity === 'error' ? '需核对' : '安排提醒'}} · {{item.task_id ? item.task_date + ' ' + item.task_title : '整体计划'}}</text>
      <text class="partner-body-copy">{{item.message}}</text><text class="audit-suggestion">建议：{{item.suggestion}}</text>
      <button wx:if="{{result.is_current}}" class="partner-outline" data-review="{{result.id}}" data-task="{{item.task_id}}" data-field="{{item.field}}" bindtap="openReviewFinding">{{item.task_id ? '修改这项' : '查看计划设置'}}</button>
      <block wx:if="{{result.is_current}}">
        <button wx:for="{{item.related_tasks}}" wx:for-item="related" wx:key="id" class="partner-outline" data-review="{{result.id}}" data-task="{{related.id}}" bindtap="openReviewFinding">修改 {{related.title}}</button>
      </block>
    </view>
    <text wx:for="{{result.rules.notes}}" wx:key="*this" class="partner-footnote">{{item}}</text>
  </view>
</template>
<template name="review-rule-summary">
  <view wx:if="{{!expired && result && result.rules}}" class="review-rule-summary">
    <button class="review-disclosure" bindtap="toggleReviewRules">
      <view class="review-disclosure-copy"><text class="review-disclosure-title">规则检查</text><text class="review-disclosure-caption">{{result.rules.error_count}} 项字段/日期问题 · {{result.rules.warning_count}} 项安排提醒</text></view>
      <text class="review-disclosure-action">{{expanded ? '收起 −' : '展开 +'}}</text>
    </button>
    <template wx:if="{{expanded}}" is="planner-review-rules" data="{{result: result, expired: expired, summaryShown: true}}" />
  </view>
</template>
<template name="coach-section-toggle">
  <button class="partner-disclosure {{paper ? 'partner-disclosure-paper' : ''}}" data-section="{{section}}" bindtap="toggleCoachSection" aria-expanded="{{expanded}}">
    <view class="review-disclosure-copy"><text class="review-disclosure-title">{{title}}</text><text wx:if="{{caption}}" class="review-disclosure-caption">{{caption}}</text></view>
    <text class="review-disclosure-action">{{expanded ? '收起 −' : '展开 +'}}</text>
  </button>
</template>
<template name="planner-draft-status">
  <view wx:if="{{!publicationPending}}" class="planner-draft-status">
    <text class="planner-draft-heading">{{draftSource === 'local_template' ? '本地规则模板 · 非模型生成' : draftSource === 'model' ? '模型生成 · 可继续编辑' : '计划草案'}}</text>
    <text class="planner-draft-caption">{{draftCloudState === 'saved' ? '已保存到云端 · 版本 ' + cloudDraftRevision : draftCloudState === 'saving' ? '正在保存，请稍候' : draftCloudState === 'loading' ? '正在读取草案' : draftCloudState === 'dirty' ? '有本机修改，尚未保存到云端' : draftCloudState === 'conflict' ? '版本冲突 · 本机修改已保留' : draftCloudState === 'error' ? '云端状态未确认，请查看提示' : '可恢复云端草案，未发布前不会创建任务'}}</text>
    <text wx:if="{{draftCloudError}}" class="planner-draft-warning">{{draftCloudError}}</text>
    <view class="planner-draft-actions">
      <button wx:if="{{hasDraft}}" bindtap="openPlannerWorkspace">查看草案</button>
      <button wx:if="{{hasDraft}}" bindtap="savePlannerDraft" disabled="{{draftCloudState === 'saving' || draftCloudState === 'loading'}}">{{draftCloudState === 'saved' ? '再存一版' : '保存草案'}}</button>
      <button bindtap="recoverCloudPlannerDraft" disabled="{{draftCloudState === 'saving' || draftCloudState === 'loading'}}">恢复云端稿</button>
      <button wx:if="{{draftBackupAvailable}}" bindtap="recoverPlannerLocalBackup" disabled="{{draftCloudState === 'saving' || draftCloudState === 'loading'}}">恢复本机备份</button>
    </view>
  </view>
</template>
<view class="page">
  <scroll-view wx:if="{{mode !== 'chat'}}" scroll-y class="page-scroll" enhanced show-scrollbar="{{false}}" scroll-into-view="{{scrollIntoView}}">
    <view class="page-inner">

  <!-- 返回按钮 + 生成计划（规划师模式专用） -->
  <view wx:if="{{mode !== 'menu'}}" class="top-bar-row">
    <view class="back-bar" bindtap="switchMode" data-mode="menu">
      <text class="back-icon">🔙</text>
      <text class="back-text">返回 AI 首页</text>
    </view>
    <view wx:if="{{mode === 'plan'}}" class="plan-gen-top-btn" bindtap="generatePlanTasks">
      <text class="plan-gen-top-icon">🎯</text>
      <text class="plan-gen-top-text">生成计划</text>
    </view>
  </view>

  <!-- ==================== 菜单模式（森林工具箱）==================== -->
  <view wx:if="{{mode === 'menu'}}" class="menu-container">
    <view class="steward-entry" bindtap="openForestSteward" role="button" aria-label="打开森林管家工作区">
      <view class="steward-entry-heading"><text class="steward-entry-avatar">🌲</text><view class="steward-entry-copy"><text class="steward-entry-label">你的成长协调伙伴</text><text class="steward-entry-title">森林管家</text></view><text class="steward-entry-arrow">›</text></view>
      <text class="steward-entry-description">从一个目标开始，把计划与执行接起来。</text>
      <view class="steward-entry-bottom"><text>规划 · 执行 · 反馈 · 复盘</text><text class="steward-entry-action">进入工作区 ›</text></view>
    </view>
    <!-- 木纹标题栏 -->
    <view class="wood-title">
      <text class="wood-title-leaf">🌲</text>
      <text class="wood-title-text">🤖 AI 成长伙伴</text>
      <text class="wood-title-leaf">🌲</text>
    </view>

    <!-- 四个专业伙伴常显，工具箱继续使用原三列布局 -->
    <view class="ai-grid partner-grid">
      <view class="ai-grid-item" bindtap="switchMode" data-mode="plan">
        <text class="ai-grid-icon">📋</text>
        <text class="ai-grid-name">AI 规划师</text>
        <text class="partner-description">聊目标，制定计划</text>
      </view>
      <view class="ai-grid-item" bindtap="switchMode" data-mode="review">
        <text class="ai-grid-icon">🔍</text>
        <text class="ai-grid-name">AI 审核师</text>
        <text class="partner-description">看草案，检查安排</text>
      </view>
      <view class="ai-grid-item" bindtap="switchMode" data-mode="coach">
        <text class="ai-grid-icon">🏆</text>
        <text class="ai-grid-name">AI 教练</text>
        <text class="partner-description">看执行，复盘调整</text>
      </view>
      <view class="ai-grid-item" bindtap="switchMode" data-mode="chat">
        <text class="ai-grid-icon">🐾</text>
        <text class="ai-grid-name">宠物聊天</text>
        <text class="partner-description">聊心情，陪你成长</text>
      </view>
    </view>

    <!-- 工具箱和分类默认收起，点击后在原位置向下展开 -->
    <view class="toolbox-header" bindtap="toggleToolbox" role="button" aria-expanded="{{toolboxExpanded}}" aria-label="AI 自律森林工具箱">
      <text class="toolbox-title">🌲 AI 自律森林工具箱 🌲</text>
      <text class="collapse-arrow {{toolboxExpanded ? 'collapse-arrow-open' : ''}}"></text>
    </view>
    <view wx:if="{{toolboxExpanded}}" class="toolbox-content expand-content">
    <button class="toolbox-shortcut" bindtap="openTool" data-tool="{{pomodoroRunning || pomodoroStatus === '已暂停' || pomodoroSeconds === 0 ? 'pomodoro' : 'todoDraw'}}">
      <text>{{pomodoroRunning || pomodoroStatus === '已暂停' || pomodoroSeconds === 0 ? '🍅 回到本轮计时' : '🎲 抽一项今日待办'}}</text>
      <text class="toolbox-shortcut-meta">{{pomodoroRunning || pomodoroStatus === '已暂停' || pomodoroSeconds === 0 ? pomodoroFormattedTime + ' ›' : '从我的目标抽取 ›'}}</text>
    </button>
    <!-- ===== 自律工具 ===== -->
    <view class="section-label tool-category-header" bindtap="toggleToolCategory" data-category="discipline" role="button" aria-expanded="{{toolCategoriesExpanded.discipline}}" aria-label="自律工具">
      <text>💪 自律工具</text>
      <text class="collapse-arrow {{toolCategoriesExpanded.discipline ? 'collapse-arrow-open' : ''}}"></text>
    </view>
    <view wx:if="{{toolCategoriesExpanded.discipline}}" class="ai-grid expand-content">
      <view class="ai-grid-item" bindtap="switchMode" data-mode="goalname">
        <text class="ai-grid-icon">🎯</text>
        <text class="ai-grid-name">目标命名器</text>
      </view>
      <view class="ai-grid-item" bindtap="switchMode" data-mode="translate">
        <text class="ai-grid-icon">🌐</text>
        <text class="ai-grid-name">成长翻译</text>
      </view>
      <view class="ai-grid-item" bindtap="openTool" data-tool="pomodoro">
        <text class="ai-grid-icon">🍅</text>
        <text class="ai-grid-name">番茄钟</text>
      </view>
      <view class="ai-grid-item" bindtap="openTool" data-tool="todoDraw">
        <text class="ai-grid-icon">🎲</text>
        <text class="ai-grid-name">今日待办抽签</text>
      </view>
      <view class="ai-grid-item" bindtap="openTool" data-tool="focusOath">
        <text class="ai-grid-icon">📜</text>
        <text class="ai-grid-name">专注宣言</text>
      </view>
      <view class="ai-grid-item" bindtap="openTool" data-tool="delayHelp">
        <text class="ai-grid-icon">🚑</text>
        <text class="ai-grid-name">拖延急救</text>
      </view>
    </view>

    <!-- ===== 趣味互动 ===== -->
    <view class="section-label tool-category-header" bindtap="toggleToolCategory" data-category="fun" role="button" aria-expanded="{{toolCategoriesExpanded.fun}}" aria-label="趣味互动">
      <text>✨ 趣味互动</text>
      <text class="collapse-arrow {{toolCategoriesExpanded.fun ? 'collapse-arrow-open' : ''}}"></text>
    </view>
    <view wx:if="{{toolCategoriesExpanded.fun}}" class="ai-grid expand-content">
      <view class="ai-grid-item" bindtap="switchMode" data-mode="oracle">
        <text class="ai-grid-icon">📖</text>
        <text class="ai-grid-name">答案之书</text>
      </view>
      <view class="ai-grid-item" bindtap="switchMode" data-mode="fortune">
        <text class="ai-grid-icon">🔮</text>
        <text class="ai-grid-name">今日运势</text>
      </view>
      <view class="ai-grid-item" bindtap="openTool" data-tool="personality">
        <text class="ai-grid-icon">🧠</text>
        <text class="ai-grid-name">人格测试</text>
      </view>
      <view class="ai-grid-item" bindtap="openTool" data-tool="disciplineCard">
        <text class="ai-grid-icon">🪪</text>
        <text class="ai-grid-name">自律人格卡</text>
      </view>
      <view class="ai-grid-item" bindtap="openTool" data-tool="energyCheck">
        <text class="ai-grid-icon">🔋</text>
        <text class="ai-grid-name">情绪能量检测</text>
      </view>
    </view>

    <!-- ===== 创意工坊 ===== -->
    <view class="section-label tool-category-header" bindtap="toggleToolCategory" data-category="creative" role="button" aria-expanded="{{toolCategoriesExpanded.creative}}" aria-label="创意工坊">
      <text>🎨 创意工坊</text>
      <text class="collapse-arrow {{toolCategoriesExpanded.creative ? 'collapse-arrow-open' : ''}}"></text>
    </view>
    <view wx:if="{{toolCategoriesExpanded.creative}}" class="ai-grid expand-content">
      <view class="ai-grid-item" bindtap="switchMode" data-mode="future">
        <text class="ai-grid-icon">📨</text>
        <text class="ai-grid-name">未来来信</text>
      </view>
      <view class="ai-grid-item" bindtap="switchMode" data-mode="capsule">
        <text class="ai-grid-icon">⏳</text>
        <text class="ai-grid-name">时间胶囊</text>
      </view>
      <view class="ai-grid-item" bindtap="switchMode" data-mode="nickname">
        <text class="ai-grid-icon">✨</text>
        <text class="ai-grid-name">昵称生成器</text>
      </view>
      <view class="ai-grid-item" bindtap="switchMode" data-mode="challenge">
        <text class="ai-grid-icon">🎲</text>
        <text class="ai-grid-name">随机挑战</text>
      </view>
    </view>
    </view>
  </view>

  <!-- ==================== 规划师模式（对话式 Agent） ==================== -->
  <view wx:elif="{{mode === 'plan'}}" class="mode-container plan-chat-mode">
    <view class="wood-title">
      <text class="wood-title-leaf">🌿</text><text class="wood-title-text">📋 AI 规划师</text><text class="wood-title-leaf">🌿</text>
      <view wx:if="{{planMessages.length > 0}}" class="plan-reset-btn" bindtap="resetPlanChat">
        <text class="plan-reset-icon">🔄</text>
        <text class="plan-reset-text">重新开始</text>
      </view>
    </view>

    <template is="planner-draft-status" data="{{draftCloudState, draftCloudError, draftSource, cloudDraftRevision, draftBackupAvailable, publicationPending, hasDraft: !!plannerState.generatedGoal}}" />
    <!-- 规划信息卡片 -->
    <view wx:if="{{mode === 'plan' && plannerState.goalContext.what}}" class="plan-info-card">
      <view class="plan-info-row">
        <text wx:if="{{plannerState.goalContext.what}}" class="plan-info-item">🎯 {{plannerState.goalContext.what}}</text>
        <text wx:if="{{plannerState.goalContext.deadline}}" class="plan-info-item">📅 {{plannerState.goalContext.deadline}}</text>
        <text wx:if="{{plannerState.goalContext.dailyTime}}" class="plan-info-item">⏱️ {{plannerState.goalContext.dailyTime}}</text>
        <text wx:if="{{plannerState.goalContext.level}}" class="plan-info-item">📊 {{plannerState.goalContext.level}}</text>
      </view>
      <view wx:if="{{plannerState.missingFields.length > 0}}" class="plan-info-missing">
        <text class="plan-missing-label">⚠️ 待补充：</text>
        <text class="plan-missing-fields">{{plannerState.missingFields.join('、')}}</text>
      </view>
      <view wx:if="{{plannerState.errorMessage}}" class="plan-info-error">{{plannerState.errorMessage}}</view>
    </view>

    <!-- 未生成任务时：对话界面 -->
    <text wx:if="{{plannerAiProvider}}" class="mode-desc">当前模型：{{plannerAiProvider}}</text>
    <text wx:if="{{plannerAiStatus}}" class="mode-desc">{{plannerAiStatus}}</text>
    <view wx:if="{{!plannerState.generatedTasks || plannerState.generatedTasks.length === 0}}" class="card-solid plan-chat-card">

      <!-- 对话消息区 -->
      <scroll-view scroll-y class="plan-chat-messages" enhanced show-scrollbar="{{false}}" scroll-top="{{planScrollTop}}">
        <view wx:for="{{planMessages}}" wx:key="index" class="plan-msg {{item.role === 'user' ? 'plan-msg-user' : 'plan-msg-ai'}}">
          <view wx:if="{{item.role === 'ai'}}" class="plan-msg-avatar">📋</view>
          <view class="plan-msg-bubble {{item.role === 'user' ? 'plan-bubble-user' : 'plan-bubble-ai'}}">
            <text>{{item.content}}</text>
            <text wx:if="{{item.streaming}}" class="typing-cursor">|</text>
          </view>
        </view>
        <!-- AI 正在思考 -->
        <view wx:if="{{plannerState.loading}}" class="plan-msg plan-msg-ai">
          <view class="plan-msg-avatar">📋</view>
          <view class="plan-msg-bubble plan-bubble-ai plan-thinking">思考中...</view>
        </view>
      </scroll-view>

      <!-- 输入区 -->
      <view class="plan-chat-input-row">
        <input class="wood-chat-input" placeholder="说说你的目标..." value="{{planInput}}" maxlength="1200" bindinput="onPlanChatInput" confirm-type="send" bindconfirm="sendPlanMessage" disabled="{{plannerState.loading}}" />
        <button class="plan-send-btn" bindtap="sendPlanMessage" disabled="{{plannerState.loading || !planInput}}">发送</button>
      </view>

      <!-- 生成任务按钮（规划阶段显示） -->
      <view wx:if="{{generationRecoveryAvailable && !plannerState.loading}}" class="plan-generate-area">
        <button class="btn-wood plan-generate-btn" bindtap="resumePlannerGeneration">恢复上次生成</button>
      </view>
      <view wx:if="{{plannerState.readyToGenerate && plannerState.phase !== 'publishing' && !plannerState.generatedTasks}}" class="plan-generate-area">
        <text wx:if="{{planStatus}}" class="plan-generate-status">{{planStatus}}</text>
        <text class="plan-generate-hint">💡 方案确认后，点击下方按钮让 AI 为你生成每日任务！</text>
        <button class="btn-wood plan-generate-btn" bindtap="generatePlanTasks" disabled="{{plannerState.loading}}">
          🎯 生成任务
        </button>
      </view>
    </view>
  </view>

  <!-- ==================== 审核师：版本化规则检查与按需语义建议 ==================== -->
  <view wx:elif="{{mode === 'review'}}" class="mode-container partner-workspace review-workspace">
    <view class="partner-hero review-hero">
      <view class="partner-hero-icon">🔍</view><view class="partner-hero-copy"><text class="partner-kicker">计划确认前，多看一眼</text><text class="partner-title">AI 审核师</text><text class="partner-subtitle">对照你的要求，检查具体的一份草案。</text></view>
    </view>
    <view wx:if="{{draftCloudState === 'loading'}}" class="partner-paper"><text class="partner-muted">正在读取你的草案…</text></view>
    <view wx:elif="{{reviewError}}" class="partner-error"><text>{{reviewError}}</text><button class="partner-link" bindtap="loadReviewDraft">重新读取</button></view>
    <view wx:elif="{{!reviewDraft}}" class="partner-paper partner-empty">
      <text class="partner-empty-icon">📋</text><text class="partner-paper-title">先准备一份计划草案</text>
      <text class="partner-muted">这里读取规划师当前编辑稿，或上次尚待确认的发布原稿。不会自动重新生成计划。</text>
      <button class="partner-primary" bindtap="openPartnerPlanner">到 AI 规划师准备草案 ›</button>
      <button class="partner-link" bindtap="loadReviewDraft">刷新草案状态</button>
    </view>
    <view wx:else class="partner-paper">
      <text class="review-eyebrow">当前草案</text>
      <text class="review-goal-title">{{reviewDraft.title}}</text>
      <text class="partner-source">{{reviewDraft.source}} · {{reviewDraft.versionLabel}} · {{reviewDraft.count}} 项任务</text>
      <text wx:if="{{reviewDraft.locked}}" class="partner-inline-note">这份原稿正等待发布结果确认，保持锁定，避免重复创建。</text>
      <text wx:if="{{!reviewDraft.count}}" class="partner-inline-note">草案里还没有任务，可以先返回规划师补充。</text>
      <view class="review-draft-actions"><button class="partner-link" bindtap="openPartnerPlanner">{{reviewDraft.locked ? '返回确认原稿' : '返回查看 / 修改'}} ›</button><button class="partner-link" bindtap="refreshReviewWorkspace" disabled="{{!!auditBusy}}">读取最新稿</button></view>
    </view>
    <view wx:if="{{reviewDraft}}" class="partner-panel planner-review-panel">
      <view class="partner-heading"><text class="partner-section-title">审核概况</text><text class="partner-small-label">只检查 · 由你决定修改</text></view>
      <text wx:if="{{!auditReady}}" class="partner-inline-note">请先在规划师保存当前稿，再检查这一版；待确认发布的原稿先处理发布结果。</text>
      <text wx:if="{{auditExpired}}" class="partner-inline-note">草案已变化，旧结果已过期。保存并读取最新稿后重新检查。</text>
      <text wx:if="{{auditBusy}}" class="partner-body-copy">{{auditBusy === 'ai' ? '审核师正在阅读这份草案…' : auditBusy === 'rules' ? '正在检查日期与任务用时…' : '正在读取已有审核结果…'}}</text>
      <text wx:if="{{auditError}}" class="partner-inline-note">{{auditError}}</text>
      <view class="review-audit-actions">
        <button class="partner-primary" bindtap="runPlannerRules" disabled="{{!auditReady || !!auditBusy}}">规则检查 · 不调用模型</button>
        <button class="partner-link" bindtap="loadSavedPlannerReviews" disabled="{{!auditReady || !!auditBusy}}">刷新审核结果</button>
      </view>
      <template is="review-rule-summary" data="{{result: auditRules || auditAI, expired: auditExpired, expanded: reviewRulesExpanded}}" />
    </view>
    <view wx:if="{{reviewDraft}}" class="partner-panel planner-review-panel review-fold-panel">
      <button class="review-disclosure" bindtap="toggleReviewAI">
        <view class="review-disclosure-copy"><text class="review-disclosure-title">AI 语义建议</text><text class="review-disclosure-caption">{{auditExpired ? '旧结果已过期' : auditAI && auditAI.status === 'done' ? '已有 ' + auditAI.semantic.findings.length + ' 条建议' : auditAI && auditAI.status === 'running' ? '审核处理中' : auditAI && auditAI.status === 'failed' ? '上次审核失败' : '可选 · 可能产生模型费用'}}</text></view>
        <text class="review-disclosure-action">{{reviewAIExpanded ? '收起 −' : '展开 +'}}</text>
      </button>
      <text wx:if="{{auditAI && auditAI.status === 'running'}}" class="partner-inline-note">审核正在处理。若中断，稍后刷新结果即可查看是否能重试。</text>
      <text wx:elif="{{auditAI && auditAI.status === 'failed'}}" class="partner-inline-note">{{auditAI.error}} {{auditAI.retry_available ? '可检查配置后手动重试。' : '这版草案的失败尝试已达上限。'}}</text>
      <view wx:if="{{reviewAIExpanded}}" class="audit-model-section">
        <text class="partner-footnote">点击时使用当前模型配置，可能产生少量费用。同一版本已有结果会直接读取；不自动改稿或发布。</text>
        <block wx:if="{{auditAI && auditAI.status === 'done' && !auditExpired}}">
          <text class="partner-source">云端版本 {{auditAI.binding.revision}} · {{auditAI.model.provider}} / {{auditAI.model.name}}</text>
          <text class="partner-body-copy">{{auditAI.semantic.summary}}</text>
          <text wx:if="{{!auditAI.semantic.findings.length}}" class="partner-footnote">本次未提出额外语义建议；这不保证现实目标一定达成。</text>
          <view wx:for="{{auditAI.semantic.findings}}" wx:key="code" class="audit-finding">
            <text class="audit-finding-label">{{item.severity === 'warning' ? '建议关注' : '补充建议'}} · {{item.task_id ? item.task_date + ' ' + item.task_title : '整体计划'}}</text>
            <text class="partner-body-copy">{{item.message}}</text><text class="audit-suggestion">建议：{{item.suggestion}}</text>
            <button wx:if="{{auditAI.is_current}}" class="partner-outline" data-review="{{auditAI.id}}" data-task="{{item.task_id}}" bindtap="openReviewFinding">{{item.task_id ? '修改这项' : '查看计划设置'}}</button>
          </view>
        </block>
        <text wx:elif="{{!auditAI || auditExpired}}" class="partner-body-copy">尚未运行这一版的 AI 审核，没有通过结论或问题评分。</text>
        <button class="partner-primary" bindtap="runPlannerAIReview" disabled="{{!auditReady || !!auditBusy || auditExpired || auditUncertain || auditAI && (auditAI.status === 'running' || auditAI.status === 'failed' && !auditAI.retry_available)}}">{{auditAI && auditAI.status === 'done' ? '读取已有 AI 建议' : auditAI && auditAI.status === 'failed' ? '手动重试 AI 审核' : '开始 AI 审核'}}</button>
        <text class="partner-footnote">规则问题与模型建议分开显示；发布仍执行原有校验，最终由你确认。</text>
      </view>
    </view>
    <view class="partner-panel review-fold-panel">
      <button class="review-disclosure" bindtap="toggleReviewTasks">
        <view class="review-disclosure-copy"><text class="review-disclosure-title">草案详情与审核依据</text><text class="review-disclosure-caption">{{reviewDraft ? '任务清单（' + reviewDraft.count + '） · 对话要求' : '了解会检查哪些内容'}}</text></view>
        <text class="review-disclosure-action">{{reviewExpanded ? '收起 −' : '展开 +'}}</text>
      </button>
      <view wx:if="{{reviewExpanded}}" class="review-details">
        <view class="partner-step-row"><text>选择草案</text><text>›</text><text>核对要求</text><text>›</text><text>查看问题</text><text>›</text><text>返回修改</text></view>
        <view wx:if="{{reviewDraft}}" class="partner-paper review-detail-paper">
          <text class="partner-paper-title">任务清单（{{reviewDraft.count}}）</text>
          <text class="partner-source">计划天数 {{reviewDraft.days}} · 开始日期 {{reviewDraft.start}}</text>
          <view wx:for="{{reviewDraft.tasks}}" wx:key="key" class="partner-task-row"><text class="partner-task-number">{{index + 1}}</text><view class="partner-task-copy"><text class="partner-task-title">{{item.title}}</text><text class="partner-task-meta">{{item.date}} · {{item.minutes}}</text></view></view>
        </view>
        <view class="partner-heading"><text class="partner-section-title">审核依据</text><text class="partner-small-label">对话整理 · 待你核对</text></view>
        <block wx:if="{{reviewDraft && reviewDraft.requirements.length}}"><view wx:for="{{reviewDraft.requirements}}" wx:key="label" class="requirement-row"><text class="requirement-label">{{item.label}}</text><text class="requirement-value">{{item.text}}</text></view></block>
        <text wx:else class="partner-body-copy">准备草案后，这里会展示规划对话中已经整理的目标、周期和时间投入。未说明的要求会留空。</text>
        <text wx:if="{{reviewDraft && reviewDraft.requirements.length}}" class="partner-footnote">这些字段从用户消息或主动编辑中提取，仍请核对；模型建议和未明确的信息不作为已确认要求。</text>
        <view class="review-check-grid"><view><text>时间与周期</text><text>任务是否符合明确的日期与投入要求</text></view><view><text>任务可执行性</text><text>检查具体程度、负担与安排冲突</text></view></view>
      </view>
    </view>
  </view>

  <!-- ==================== 教练：真实执行事实 + 主动反馈草稿 ==================== -->
  <view wx:elif="{{mode === 'coach'}}" class="mode-container partner-workspace coach-workspace">
    <view class="partner-hero review-hero"><view class="partner-hero-icon">🏆</view><view class="partner-hero-copy"><text class="partner-kicker">先看发生了什么，再决定怎么调整</text><text class="partner-title">AI 教练</text><text class="partner-subtitle">把真实记录和你的感受放在一起看。</text></view></view>
    <view class="partner-panel coach-context">
      <text class="partner-section-title">这次关注哪一个目标？</text>
      <view wx:if="{{coachGoalsLoading}}" class="partner-body-copy">正在读取目标…</view>
      <view wx:elif="{{coachGoalsError}}" class="partner-error"><text>{{coachGoalsError}}</text><button class="partner-link" bindtap="loadCoachGoals">重新读取</button></view>
      <view wx:elif="{{!coachGoals.length}}" class="partner-body-copy">还没有目标，可以先从规划师开始。</view>
      <picker wx:else mode="selector" range="{{coachGoalLabels}}" value="{{coachGoalIndex >= 0 ? coachGoalIndex : 0}}" disabled="{{coachCloudSaving}}" bindchange="onCoachGoalChange"><view class="coach-picker"><text>{{coachGoalTitle || '请选择一个已有目标'}}</text><text>切换 ›</text></view></picker>
      <view class="coach-date-row"><text>截至日期 / 当日反馈</text><picker mode="date" value="{{coachDate}}" end="{{coachToday}}" disabled="{{coachGoalsLoading || coachCloudSaving}}" bindchange="onCoachDateChange"><view class="coach-date-value">{{coachDate}} ▾</view></picker></view>
      <text wx:if="{{!coachGoalListComplete}}" class="partner-inline-note">目标较多，首版只读取前500条，请先选择已显示的目标。</text>
    </view>
    <view wx:if="{{coachWindow}}" class="partner-paper coach-window">
      <view class="partner-heading"><text class="partner-paper-title">近7天执行概况</text><text class="partner-badge">{{coachWindow.start}} — {{coachWindow.end}}</text></view>
      <text class="partner-source">{{coachWindow.complete ? '来自当前云端任务记录' : '读取未完整 · 以下仅为已读取记录'}} · 有安排的日期 {{coachWindow.scheduled_days}} 天</text>
      <view class="coach-fact-grid"><view><text class="coach-fact-value">{{coachWindow.past.total}}</text><text>已结束日期任务</text></view><view><text class="coach-fact-value green-value">{{coachWindow.past.completed}}</text><text>登记完成</text></view><view><text class="coach-fact-value">{{coachWindow.past.pending}}</text><text>未登记完成</text></view></view>
      <text class="coach-window-rate">{{coachWindow.past.rate !== null ? '已结束日期的登记完成比例：' + coachWindow.past.rate + '%' : coachWindow.past.total ? '状态缺失或记录未读全，暂不计算完整比例' : '已结束日期没有任务，不计算完成比例'}}</text>
      <text wx:if="{{coachWindow.past.unknown}}" class="partner-muted">{{coachWindow.past.unknown}}项完成状态缺失，保留为未知。</text>
      <text wx:if="{{coachWindow.today}}" class="coach-today-note">今日尚未结束：{{coachWindow.today.total}}项安排，已登记{{coachWindow.today.completed}}项，待完成{{coachWindow.today.pending}}项。</text>
      <view class="coach-fold">
        <template is="coach-section-toggle" data="{{section: 'days', title: '逐日记录与统计说明', expanded: coachSections.days, paper: true}}" />
        <block wx:if="{{coachSections.days}}">
          <view wx:for="{{coachWindow.daily}}" wx:key="date" class="coach-day-row"><text>{{item.date}}{{item.is_today ? ' · 今日' : ''}}</text><text>{{item.total}}项 · 完成{{item.completed}}{{item.unknown ? ' · 状态缺失' : ''}}</text></view>
          <text class="partner-muted">{{coachWindow.feedback_days}}天有用户反馈；{{coachWindow.self_reported_minutes !== null ? coachWindow.self_reported_minutes_days + '天自述用时合计' + coachWindow.self_reported_minutes + '分钟，其余未知' : '实际用时尚未自述，不用预计时长代替'}}</text>
          <text wx:for="{{coachWindow.notes}}" wx:key="*this" class="partner-muted coach-evidence-note">{{item}}</text>
        </block>
      </view>
    </view>
    <view class="partner-paper">
      <template is="coach-section-toggle" data="{{section: 'tasks', title: '当日执行记录', caption: coachDate, expanded: coachSections.tasks, paper: true}}" />
      <view wx:if="{{coachGoalsLoading || coachTasksLoading}}" class="partner-empty"><text>正在读取真实任务记录…</text></view>
      <view wx:elif="{{coachGoalsError}}" class="partner-empty"><text>目标读取成功后，再查看执行记录。</text></view>
      <view wx:elif="{{!coachGoalId}}" class="partner-empty"><text class="partner-empty-icon">🌱</text><text class="partner-paper-title">先选一个目标</text><text class="partner-muted">只查看你选择的记录，不自动替你判断表现。</text></view>
      <view wx:elif="{{coachTasksError}}" class="partner-empty"><text>{{coachTasksError}}</text><button class="partner-outline" bindtap="loadCoachTasks">重试任务读取</button></view>
      <block wx:elif="{{coachFacts && coachSections.tasks}}">
        <text class="partner-source">来自目标任务记录 · 仅所选日期</text>
        <view class="coach-fact-grid"><view><text class="coach-fact-value">{{coachFacts.total}}</text><text>安排任务</text></view><view><text class="coach-fact-value green-value">{{coachFacts.completed}}</text><text>已完成</text></view><view><text class="coach-fact-value">{{coachFacts.pending}}</text><text>待完成记录</text></view></view>
        <view wx:if="{{coachFacts.total && coachFacts.rate !== null}}" class="coach-progress"><view class="coach-progress-heading"><text>当前登记完成比例</text><text>{{coachFacts.rate}}%</text></view><view class="coach-progress-track"><view class="coach-progress-fill" style="width: {{coachFacts.rate}}%;"></view></view></view>
        <view wx:elif="{{coachFacts.total}}" class="partner-muted">部分状态缺失或读取未完整，暂不计算比例。</view>
        <view wx:else class="partner-empty small-empty"><text>这一天没有任务安排，不计算完成比例，也不据此判断你是否自律。</text></view>
        <view wx:for="{{coachTasks}}" wx:key="key" class="partner-task-row"><text class="coach-task-mark {{item.completed === true ? 'completed-mark' : ''}}">{{item.completed === true ? '✓' : '·'}}</text><text class="partner-task-title partner-task-copy">{{item.title}}</text><text class="partner-task-meta">{{item.completed === true ? '已完成' : item.completed === false ? '待完成' : '状态未记录'}}</text></view>
        <button class="partner-link coach-refresh" bindtap="loadCoachTasks">刷新这一天的记录</button>
      </block>
    </view>
    <view class="partner-panel coach-feedback-panel">
      <template is="coach-section-toggle" data="{{section: 'feedback', title: '补充当日反馈', caption: coachCloudConflict ? '反馈版本冲突，待核对' : coachCloudSaving ? '正在同步反馈…' : coachCloudDirty ? '本机反馈待同步' : '主动反馈 · 可不填', expanded: coachSections.feedback}}" />
      <text wx:if="{{!coachSections.feedback && (coachFeedbackError || coachCloudError)}}" class="partner-feedback-error">{{coachFeedbackError || coachCloudError}}</text>
      <view hidden="{{!coachSections.feedback}}" class="coach-fold-body">
      <text class="partner-body-copy">补充{{coachDate}}这一天的感受，作为复盘时的用户自述；可不填，也不会影响奖励。</text>
      <view wx:if="{{coachGoalId && coachFeedbackReadError}}" class="partner-error"><text>{{coachFeedbackError}}</text><button class="partner-link" bindtap="restoreCoachFeedback">重新读取本机反馈</button></view>
      <block wx:elif="{{coachGoalId && !coachGoalsError && !coachGoalsLoading}}">
        <view class="coach-reason-list"><button wx:for="{{coachReasons}}" wx:key="*this" class="coach-reason {{coachReason === item ? 'reason-selected' : ''}}" disabled="{{coachEvidenceLoading || coachCloudSaving}}" data-reason="{{item}}" bindtap="onCoachReason">{{item}}</button></view>
        <text class="partner-footnote">主观难度</text><view class="coach-reason-list"><button wx:for="{{coachDifficulties}}" wx:key="*this" class="coach-reason {{coachDifficulty === item ? 'reason-selected' : ''}}" disabled="{{coachEvidenceLoading || coachCloudSaving}}" data-difficulty="{{item}}" bindtap="onCoachDifficulty">{{item}}</button></view>
        <view class="coach-actual-row"><text>这一天自述投入</text><input type="number" value="{{coachActualMinutes}}" disabled="{{coachEvidenceLoading || coachCloudSaving}}" placeholder="未知可留空" bindinput="onCoachActualMinutes" bindblur="saveCoachFeedback" /><text>分钟</text></view>
        <textarea class="partner-note-input" value="{{coachNote}}" disabled="{{coachEvidenceLoading || coachCloudSaving}}" maxlength="500" placeholder="比如：今天加班，原定 30 分钟只做了 10 分钟…" placeholder-class="partner-input-placeholder" bindinput="onCoachNote" bindblur="saveCoachFeedback" auto-height cursor-spacing="32" />
        <view class="coach-note-footer"><text>{{coachNote.length}} / 500</text><button class="partner-link" bindtap="saveCoachFeedback">保存到本机</button></view>
        <text wx:if="{{coachFeedbackStatus}}" class="partner-feedback-state">{{coachFeedbackStatus}}</text>
        <text wx:if="{{coachFeedbackError}}" class="partner-feedback-error">{{coachFeedbackError}}</text>
        <view class="partner-action-row"><button class="partner-primary" bindtap="saveCoachCloudFeedback" disabled="{{coachEvidenceLoading || coachCloudSaving || coachCloudRevision === null || coachCloudConflict || coachFeedbackReadError}}">{{coachCloudSaving ? '正在保存…' : '保存反馈到云端'}}</button><button class="partner-outline" bindtap="loadCoachEvidence" disabled="{{coachCloudSaving || coachEvidenceLoading}}">刷新记录</button></view>
        <text wx:if="{{coachCloudMessage}}" class="partner-feedback-state">{{coachCloudMessage}}</text><text wx:if="{{coachCloudError}}" class="partner-feedback-error">{{coachCloudError}}</text>
        <view wx:if="{{coachCloudDirty || coachCloudConflict || coachCloudError || coachCloudBackup}}" class="coach-backup-actions"><button class="partner-link" bindtap="restoreCoachCloudFeedback" disabled="{{coachCloudSaving || coachEvidenceLoading}}">备份本机稿并读取云反馈</button><button wx:if="{{coachCloudBackup}}" class="partner-link" bindtap="restoreCoachLocalBackup" disabled="{{coachCloudSaving || coachEvidenceLoading}}">恢复本机副本</button></view>
      </block>
      <text wx:else class="partner-footnote">选择目标后再填写，反馈会对应到目标和日期。</text>
      <text class="partner-footnote">输入先存本机；主动点“保存反馈到云端”才同步。AI只在你发起复盘时读取云端反馈，任务与奖励不会随之改动。</text>
      </view>
    </view>
    <view class="partner-panel coach-feedback-panel">
      <view class="partner-heading"><text class="partner-section-title">复盘与下一轮建议</text><text class="partner-small-label">主动发起</text></view>
      <text class="partner-body-copy">按当前模型配置，可能产生少量费用；同一份任务与反馈已有结果会直接读取。</text>
      <text wx:if="{{coachCloudDirty || coachCloudConflict}}" class="partner-inline-note">本机反馈尚未同步，请先保存或核对云端反馈，避免复盘漏掉你的新想法。</text>
      <text wx:if="{{coachReportExpired}}" class="partner-inline-note">反馈已有本机修改，旧复盘不作为当前结论。</text>
      <text wx:if="{{coachReportBusy}}" class="partner-body-copy">教练正在阅读执行记录和反馈…</text>
      <text wx:if="{{coachReportError}}" class="partner-error">{{coachReportError}}</text>
      <text wx:if="{{coachReport && coachReport.status === 'running'}}" class="partner-inline-note">复盘正在处理。若中断，稍后刷新记录即可查看是否能重试。</text>
      <text wx:elif="{{coachReport && coachReport.status === 'failed' && !coachReportExpired}}" class="partner-inline-note">{{coachReport.error}} {{coachReport.retry_hint}} {{coachReport.retry_available ? '可手动重试，可能产生模型费用。' : '相同证据的失败尝试已达上限。'}}</text>
      <block wx:elif="{{coachReport && coachReport.status === 'done' && !coachReportExpired}}">
        <text class="partner-body-copy">{{coachReport.result.summary}}</text>
      </block>
      <text wx:else class="partner-body-copy">尚未生成当前记录的AI复盘，没有表现评分。</text>
      <button class="partner-primary" bindtap="runCoachReview" disabled="{{!coachWindow || !coachWindow.complete || !coachWindow.has_evidence || coachCloudDirty || coachCloudConflict || coachEvidenceLoading || coachCloudSaving || coachReportBusy || coachReportUncertain || coachFeedbackReadError || coachReport && (coachReport.status === 'running' || coachReport.status === 'failed' && !coachReport.retry_available)}}">{{coachReport && coachReport.status === 'done' ? '读取已有复盘' : coachReport && coachReport.status === 'failed' ? '手动重试 AI 复盘' : '生成 AI 复盘'}}</button>
      <button class="partner-link coach-refresh" bindtap="loadCoachEvidence" disabled="{{coachCloudSaving || coachEvidenceLoading || coachReportBusy}}">刷新记录与复盘（不调用模型）</button>
      <view wx:if="{{coachReport && coachReport.status === 'done' && !coachReportExpired}}" class="coach-fold">
        <template is="coach-section-toggle" data="{{section: 'report', title: '建议、观察与依据', caption: coachReport.result.suggestions.length + ' 条建议 · ' + coachReport.result.observations.length + ' 条观察', expanded: coachSections.report}}" />
        <block wx:if="{{coachSections.report}}">
          <text class="partner-source">{{coachWindow.start}} — {{coachWindow.end}} · {{coachReport.model.provider}} / {{coachReport.model.name}}</text>
          <view wx:for="{{coachReport.result.observations}}" wx:key="index" class="coach-insight"><text class="coach-insight-title">观察</text><text>{{item.message}}</text><text wx:for="{{item.evidence}}" wx:for-item="ref" wx:key="id" class="coach-citation">依据：{{ref.label}}</text></view>
          <view wx:for="{{coachReport.result.suggestions}}" wx:key="index" class="coach-insight"><text class="coach-insight-title">可尝试</text><text>{{item.message}}</text><text>{{item.action}}</text><text wx:for="{{item.evidence}}" wx:for-item="ref" wx:key="id" class="coach-citation">依据：{{ref.label}}</text><button class="partner-outline" data-index="{{index}}" bindtap="openCoachInSteward">用于本轮调整 ›</button></view>
          <text wx:for="{{coachReport.result.uncertainties}}" wx:key="*this" class="partner-footnote">仍不确定：{{item}}</text>
        </block>
        <button class="partner-outline coach-steward-link" bindtap="openCoachInSteward">到森林管家查看本次复盘 ›</button>
      </view>
      <text class="partner-footnote">复盘对应读取时的记录与云端反馈；记录变化后需重新查看，不自动修改任何任务。</text>
    </view>
    <text class="partner-footnote coach-scope-note">统计所选日期及之前6天；反馈对应所选的这一天。今天的待完成记录单列，不把签到当作任务完成。</text>
  </view>

  <!-- ==================== 答案之书 ==================== -->
  <view wx:elif="{{mode === 'oracle'}}" class="mode-container">
    <view class="wood-title">
      <text class="wood-title-leaf">📖</text><text class="wood-title-text">答案之书</text>
      <text class="wood-title-leaf">📖</text>
    </view>
    <view class="card-solid oracle-card">
      <text class="mode-desc">写一个低风险的小问题，随机翻一张灵感卡，换个角度想一想。</text>
      <view class="oracle-question-area">
        <text class="oracle-hint">在心中默念你的问题...</text>
        <input class="wood-input oracle-input" placeholder="输入你的问题，例如：我要不要报名这个比赛？" value="{{oracleQuestion}}" bindinput="onOracleInput" />
        <button class="btn-wood btn-oracle" bindtap="askOracle" disabled="{{oracleAnimating}}">
          {{oracleAnimating ? '🔄 答案正在浮现...' : '🔮 翻开答案之书'}}
        </button>
      </view>

      <!-- 翻牌动画 -->
      <view wx:if="{{oracleAnimating}}" class="oracle-flip-area">
        <view class="oracle-card-flip {{oracleAnimating ? 'flipping' : ''}}"></view>
      </view>

      <!-- 结果展示 -->
      <view wx:if="{{oracleResult && !oracleAnimating}}" class="oracle-result">
        <text class="oracle-q">❝ {{oracleResult.question}}</text>
        <view class="oracle-answer-box">
          <text class="oracle-answer-label">随机灵感</text>
          <text class="oracle-answer-text" style="color: {{oracleResult.color}}">{{oracleResult.answer}}</text>
        </view>
        <text class="tool-hint">想试一试？写下一个可撤回、5 分钟内能开始的小动作。</text>
        <button class="toolbox-action" bindtap="openTool" data-tool="focusOath">写一条专注宣言</button>
        <view class="oracle-explain-box">
          <text class="oracle-explain-label">解释</text>
          <text class="oracle-explain-text">{{oracleResult.explanation}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ==================== 今日运势 ==================== -->
  <view wx:elif="{{mode === 'fortune'}}" class="mode-container">
    <view class="wood-title">
