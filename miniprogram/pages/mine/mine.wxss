/* ===== Mine 页面 - 动森森林治愈风格 ===== */

/* 页面根容器 */
.page { min-height: 100vh; background: radial-gradient(ellipse at center top, #355447 0%, #2D4A3E 70%); }
/* 滚动容器 */
.page-scroll { height: 100vh; }
/* 内容区内边距 */
.page-inner { max-width: 720rpx; margin: 0 auto; padding: 20rpx 24rpx 150rpx; box-sizing: border-box; }

/* ===== 用户英雄区（木纹渐变横幅） ===== */
.user-hero { position: relative; min-height: 380rpx; margin-bottom: 20rpx; overflow: hidden; border-radius: 0 0 48rpx 48rpx; }

/* 木纹渐变背景 */
.hero-bg { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: linear-gradient(180deg, #8B6914 0%, #B8860B 50%, #DAA520 100%); border-radius: 0 0 48rpx 48rpx; }

/* 英雄区内容 */
.hero-content { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; padding-top: 44rpx; padding-bottom: 24rpx; }

/* 头像圆圈 — 木纹边框（可点击） */
.avatar-circle { width: 120rpx; height: 120rpx; border-radius: 50%; background: rgba(45,74,62,0.3); border: 5rpx solid #F5E6C8; display: flex; align-items: center; justify-content: center; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.2); position: relative; overflow: hidden; }
.avatar-circle:active { transform: scale(0.95); transition: transform 0.15s ease; }
.avatar-img { width: 100%; height: 100%; border-radius: 50%; }
.avatar-letter { font-size: 48rpx; color: #F5E6C8; font-weight: 800; }
.avatar-edit-hint { position: absolute; bottom: 0; right: 0; width: 36rpx; height: 36rpx; background: #7CB342; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 2rpx solid #F5E6C8; }
.avatar-edit-icon { font-size: 18rpx; }

/* 用户名 — 奶油米黄 */
.user-name { font-size: 36rpx; font-weight: 700; color: #F5E6C8; margin-top: 12rpx; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15); }

/* 等级徽章 — 叶子绿芯片 */
.level-chip { margin-top: 10rpx; padding: 6rpx 22rpx; background: linear-gradient(135deg, #7CB342, #689F38); border: 2rpx solid #AED581; border-radius: 999rpx; box-shadow: 0 3rpx 10rpx rgba(124,179,66,0.3); }
.level-text { font-size: 22rpx; color: #FFFFFF; font-weight: 700; }
/* OpenID 调试用 */
.openid-text { font-size: 18rpx; color: rgba(245,230,200,0.6); margin-top: 8rpx; padding: 4rpx 16rpx; background: rgba(0,0,0,0.15); border-radius: 8rpx; word-break: break-all; max-width: 90%; text-align: center; }

/* 数据概览行 */
.user-stats-row { display: flex; gap: 24rpx; margin-top: 16rpx; justify-content: center; }
.stat-mini { display: flex; flex-direction: column; align-items: center; gap: 2rpx; padding: 8rpx 20rpx; background: rgba(0,0,0,0.2); border-radius: 12rpx; border: 1rpx solid rgba(184,134,11,0.25); }
.stat-mini .stat-num { font-size: 26rpx; font-weight: 800; color: #FFAB40; }
.stat-mini .stat-label { font-size: 18rpx; color: #AED581; }

/* ===== 宠物快捷预览（英雄区内） ===== */
.pet-preview-row { display: flex; align-items: center; gap: 12rpx; margin-top: 14rpx; padding: 10rpx 24rpx; background: rgba(0,0,0,0.2); border-radius: 20rpx; border: 1rpx solid rgba(184,134,11,0.25); }
.pet-preview-row:active { background: rgba(0,0,0,0.3); transform: scale(0.98); transition: all 0.15s ease; }
.pet-preview-emoji { font-size: 36rpx; }
.pet-preview-info { flex: 1; display: flex; flex-direction: column; gap: 2rpx; }
.pet-preview-name { font-size: 24rpx; color: #F5E6C8; font-weight: 600; }
.pet-preview-stage { font-size: 18rpx; color: #AED581; }
.pet-preview-arrow { font-size: 28rpx; color: #DAA520; }

/* ===== 菜单列表容器 ===== */
.menu-list { margin-bottom: 16rpx; }

/* ===== 虚线边框卡片 ===== */
.card { background: rgba(61,98,84,0.55); border: 2rpx dashed rgba(184,134,11,0.45); border-radius: 28rpx; overflow: hidden; margin-bottom: 12rpx; transition: all 0.25s ease; backdrop-filter: blur(6rpx); }
.card:active { background: rgba(74,115,97,0.65); transform: scale(0.985); }

/* 菜单项 */
.menu-card-item { display: flex; align-items: center; padding: 26rpx 30rpx; gap: 18rpx; }
.menu-contact { width: 100%; box-sizing: border-box; margin: 0 0 12rpx; line-height: normal; text-align: left; }

/* 菜单图标（更大更装饰） */
.menu-icon { font-size: 38rpx; width: 46rpx; text-align: center; flex-shrink: 0; }

/* 菜单文字 */
.menu-label { flex: 1; font-size: 28rpx; color: #F5E6C8; font-weight: 500; }

/* 菜单箭头 */
.menu-arrow { font-size: 36rpx; color: #DAA520; font-weight: 300; flex-shrink: 0; }

/* 菜单徽章（宠物状态等） */
.menu-badge { font-size: 20rpx; color: #AED581; background: rgba(124,179,66,0.2); padding: 2rpx 12rpx; border-radius: 999rpx; flex-shrink: 0; }

/* ===== 底部区域 ===== */
.bottom-area { margin-top: 8rpx; }

/* ===== 退出登录 — 警告色 ===== */
.item-logout .menu-label { color: #FFAB40; }
.label-warn { color: #FFAB40 !important; }
.arrow-warn { color: rgba(255,171,64,0.6) !important; }

/* ===== 管理员入口 — 金色高亮 ===== */
.item-admin { border: 2px solid rgba(255,213,79,0.35) !important; background: rgba(255,213,79,0.08) !important; }
.label-admin { color: #FFD54F !important; font-weight: 600 !important; }
.arrow-admin { color: #FFD54F !important; }

/* ======================================== */
/*  宠物图鉴弹窗                                  */
/* ======================================== */

/* 遮罩层 */
.collection-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.6);
  z-index: 3000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: colOverlayIn 0.25s ease;
}
@keyframes colOverlayIn { from{opacity:0} to{opacity:1} }

/* 弹窗主体 */
.collection-modal {
  width: 90%;
  max-width: 650rpx;
  max-height: 82vh;
  background: linear-gradient(180deg, #2D4A3E 0%, #233B30 100%);
  border-radius: 32rpx;
  border: 3rpx solid rgba(184,134,11,0.4);
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.5);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: colModalSlideUp 0.3s cubic-bezier(0.22,1,0.36,1);
}
@keyframes colModalSlideUp { from{transform:translateY(60rpx);opacity:0} to{transform:translateY(0);opacity:1} }

/* 标题栏 */
.collection-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 2rpx solid rgba(184,134,11,0.25);
  flex-shrink: 0;
}
.collection-title { font-size: 32rpx; font-weight: 800; color: #FFD54F; letter-spacing: 2rpx; }
.collection-close {
  width: 52rpx; height: 52rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%; background: rgba(255,171,64,0.15);
  color: #FFAB40; font-size: 26rpx; font-weight: 700;
}
.collection-close:active { transform: scale(0.9); }

/* ===== 统计概览区 ===== */
.collection-stats {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  gap: 0;
  flex-shrink: 0;
}
.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.stat-num-lg { font-size: 38rpx; font-weight: 800; color: #FFD54F; line-height: 1.1; }
.stat-label-sm { font-size: 20rpx; color: var(--text-secondary, #90A4AE); }
.stat-divider {
  width: 1rpx; height: 48rpx;
  background: rgba(184,134,11,0.3);
  flex-shrink: 0;
}

/* ===== 最稀有宠物展示 ===== */
.rarest-showcase {
  margin: 0 24rpx 12rpx;
  padding: 14rpx 18rpx;
  background: linear-gradient(135deg, rgba(255,213,79,0.08), rgba(255,160,0,0.05));
  border: 1.5rpx solid rgba(255,213,79,0.25);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}
.rarest-label { font-size: 22rpx; color: #FFD54F; font-weight: 700; white-space: nowrap; }
.rarest-card {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.rarest-emoji { font-size: 40rpx; }
.rarest-info { flex: 1; }
.rarest-name { font-size: 25rpx; color: #F5E6C8; font-weight: 700; }
.rarest-tags { display: flex; gap: 8rpx; margin-top: 4rpx; }
.rarity-tag {
  font-size: 18rpx; font-weight: 600;
  padding: 2rpx 10rpx; border-radius: 999rpx;
  border-style: solid; border-width: 1rpx;
}
.stage-tag {
  font-size: 18rpx; color: #AED581;
  background: rgba(124,179,66,0.15);
  padding: 2rpx 10rpx; border-radius: 999rpx;
}
.awaken-mini { font-size: 20rpx; margin-left: 4rpx; }

/* ===== Tab 切换 ===== */
.collection-tabs {
  display: flex;
  padding: 0 24rpx;
  gap: 16rpx;
  flex-shrink: 0;
  margin-top: 8rpx;
}
.col-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 25rpx;
  color: #90A4AE;
  border-bottom: 3rpx solid transparent;
  transition: all 0.2s ease;
}
.col-tab-active {
  color: #FFD54F;
  font-weight: 700;
  border-bottom-color: #FFD54F;
}

/* ===== 宠物列表 ===== */
.collection-list {
  max-height: 42vh;
  padding: 0 20rpx 20rpx;
}

/* 空状态 */
.empty-collection {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 32rpx;
  gap: 12rpx;
}
.empty-icon { font-size: 56rpx; }
.empty-text { font-size: 25rpx; color: #78909C; text-align: center; line-height: 1.5; }
.go-pets-btn {
  margin-top: 12rpx;
  padding: 14rpx 36rpx;
  font-size: 25rpx;
}

/* 宠物卡片 */
.pet-col-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  margin-top: 10rpx;
  background: rgba(61,98,84,0.45);
  border: 2rpx dashed rgba(184,134,11,0.3);
  border-radius: 20rpx;
  gap: 12rpx;
  transition: all 0.2s ease;
}
.pet-col-card:active { background: rgba(74,115,97,0.55); transform: scale(0.98); }
.is-egg-card { border-style: dashed; border-color: rgba(218,165,32,0.35) !important; }

/* 历史卡片（灰色） */
.released-card { opacity: 0.65; }
.faded-text { color: #78909C !important; }
.faded-emoji { filter: grayscale(0.7); opacity: 0.65; }

.pet-col-left { display: flex; align-items: center; gap: 14rpx; flex: 1; min-width: 0; }
.pet-col-emoji { font-size: 44rpx; flex-shrink: 0; }
.pet-col-info { flex: 1; min-width: 0; }
.pet-col-name { font-size: 27rpx; color: #F5E6C8; font-weight: 700; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.pet-col-meta { display: flex; align-items: center; gap: 4rpx; margin-top: 4rpx; flex-wrap: wrap; }
.meta-rarity { font-size: 20rpx; font-weight: 600; }
.meta-dot { font-size: 18rpx; color: #5D6D70; }
.meta-stage { font-size: 20rpx; color: #AED581; }
.meta-hatch { font-size: 20rpx; color: #FFD54F; }

.pet-col-sub { display: flex; align-items: center; gap: 4rpx; margin-top: 4rpx; font-size: 20rpx; color: #90A4AE; }

/* 操作按钮组 */
.pet-col-actions { display: flex; gap: 8rpx; flex-shrink: 0; }
.col-action-btn {
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}
.col-view-btn {
  background: rgba(74,144,126,0.4);
  color: #80CBC4;
  border: 1.5rpx solid rgba(129,199,196,0.3);
}
.col-view-btn:active { background: rgba(74,144,126,0.6); }
.col-delete-btn {
  background: rgba(239,83,80,0.15);
  color: #EF5350;
  border: 1.5rpx solid rgba(239,83,80,0.3);
}
.col-delete-btn:active { background: rgba(239,83,80,0.3); }

.release-date { flex-shrink: 0; }
.release-date-text { font-size: 19rpx; color: #607D8B; white-space: nowrap; }

/* ===== 放行确认弹窗 ===== */
.delete-confirm-modal {
  width: 85%; max-width: 560rpx;
  background: linear-gradient(180deg, #2D4A3E, #233B30);
  border-radius: 28rpx;
  border: 3rpx solid rgba(239,83,80,0.4);
  padding: 32rpx 28rpx 24rpx;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.5);
}
.delete-confirm-header { display: flex; align-items: center; gap: 10rpx; margin-bottom: 16rpx; }
.delete-confirm-icon { font-size: 40rpx; }
.delete-confirm-title { font-size: 30rpx; font-weight: 800; color: #EF5350; }
.delete-confirm-msg { display: block; font-size: 26rpx; color: #ECEFF1; line-height: 1.6; margin-bottom: 10rpx; }
.delete-confirm-hint { display: block; font-size: 22rpx; color: #78909C; line-height: 1.5; margin-bottom: 24rpx; }
.delete-confirm-actions { display: flex; gap: 16rpx; }
.delete-cancel-btn { flex: 1; }
.btn-danger {
  flex: 1;
  background: linear-gradient(135deg, #EF5350, #C62828) !important;
  color: #FFF !important;
  font-weight: 700 !important;
  border: none !important;
  box-shadow: 0 4rpx 16rpx rgba(239,83,80,0.35);
}
.btn-danger:active { transform: scale(0.95); }
