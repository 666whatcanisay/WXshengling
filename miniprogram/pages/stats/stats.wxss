/* ========== 数据统计 - 动森森林主题样式 ========== */

/* 页面容器 */
.page-container {
  min-height: 100vh;
  background: #2D4A3E;
  padding: 30rpx 24rpx;
  box-sizing: border-box;
}

/* ---------- 木纹标题栏 ---------- */
.wood-title {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background: linear-gradient(135deg, #8B6914, #B8860B);
  border-radius: 50rpx;
  margin-bottom: 30rpx;
  gap: 16rpx;
}
.title-icon {
  font-size: 28rpx;
}
.title-text {
  color: #F5E6C8;
  font-size: 34rpx;
  font-weight: bold;
}

/* ---------- 等级卡片（木纹渐变）---------- */
.level-card {
  background: linear-gradient(135deg, #8B6914, #B8860B, #DAA520);
  border-radius: 28rpx;
  padding: 6rpx;
  margin-bottom: 26rpx;
}
.level-card-inner {
  background: rgba(53,84,71,0.95);
  border-radius: 24rpx;
  padding: 26rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.level-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.level-badge {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFAB40, #DAA520);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.level-num {
  font-size: 30rpx;
  color: #2D4A3E;
  font-weight: bold;
}
.level-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.pet-name {
  font-size: 28rpx;
  color: #F5E6C8;
  font-weight: bold;
}
.xp-text {
  font-size: 24rpx;
  color: #C4B89A;
}
.xp-bar-wrap {
  width: 200rpx;
  height: 12rpx;
  background: rgba(45,74,62,0.6);
  border-radius: 6rpx;
  overflow: hidden;
}
.xp-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #7CB342, #AED581);
  border-radius: 6rpx;
  transition: width 0.3s;
}
.level-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.streak-fire {
  font-size: 32rpx;
  font-weight: bold;
  color: #F5E6C8;
}

/* ---------- 虚线边框卡片 ---------- */
.card {
  background: rgba(61,98,84,0.6);
  border: 2rpx dashed rgba(165,190,140,0.4);
  border-radius: 28rpx;
  padding: 26rpx;
  margin-bottom: 26rpx;
}

/* ---------- 实边小卡片 ---------- */
.card-solid-sm {
  background: rgba(61,98,84,0.65);
  border: 2rpx solid #8B6914;
  border-radius: 20rpx;
  padding: 20rpx 14rpx;
  text-align: center;
}

/* ---------- 区块内联标题 ---------- */
.section-title-inline {
  font-size: 28rpx;
  color: #F5E6C8;
  font-weight: bold;
  margin-bottom: 18rpx;
}
.section-title {
  font-size: 28rpx;
  color: #F5E6C8;
  margin: 30rpx 0 16rpx;
  padding-left: 10rpx;
}

/* ---------- 周柱状图 ---------- */
.week-bar-chart {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 240rpx;
  padding-top: 10rpx;
}
.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.bar-value {
  font-size: 22rpx;
  color: #DAA520;
  font-weight: bold;
}
.bar-outer {
  width: 44rpx;
  height: 180rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(45,74,62,0.35);
  border-radius: 10rpx 10rpx 0 0;
}
.bar-inner {
  width: 36rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: linear-gradient(180deg, #7CB342, #AED581);
  transition: height 0.3s;
}
.bar-day-label {
  font-size: 20rpx;
  color: #8B9A7D;
}

/* ---------- 核心指标网格 ---------- */
.core-metrics {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 26rpx;
}
.metric-icon {
  font-size: 32rpx;
  display: block;
  margin-bottom: 6rpx;
}
.metric-val {
  display: block;
  font-size: 30rpx;
  color: #F5E6C8;
  font-weight: bold;
}
.metric-lbl {
  display: block;
  font-size: 20rpx;
  color: #C4B89A;
  margin-top: 4rpx;
}

/* ---------- 目标列表 ---------- */
.goal-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx dashed rgba(165,190,140,0.15);
}
.goal-row:last-child {
  border-bottom: none;
}
.goal-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.goal-status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.doing { background: #7CB342; }
.goal-title-text {
  font-size: 27rpx;
  color: #F5E6C8;
}
.goal-tag-doing {
  font-size: 22rpx;
  color: #AED581;
  background: rgba(124,179,66,0.15);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(124,179,66,0.3);
}

/* 空状态 */
.empty-mini {
  text-align: center;
  padding: 30rpx 0;
  font-size: 26rpx;
  color: #8B9A7D;
}
