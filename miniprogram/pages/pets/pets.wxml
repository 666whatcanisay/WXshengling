<view class="page">
  <!-- ===== 骨架屏：数据加载中显示 ===== -->
  <view wx:if="{{loading}}" class="skeleton-wrap">
    <view class="sk-hero"></view>
    <view class="sk-actions"></view>
    <view class="sk-bottom"></view>
  </view>

  <!-- ===== 正常内容 ===== -->
  <scroll-view wx:else scroll-y class="pets-scroll" enhanced show-scrollbar="{{false}}">
    <view class="pets-inner">

      <!-- 1. 木纹标题栏 -->
      <view class="wood-title">
        <text class="leaf-icon-left">🏕️</text>
        <text class="wood-title-text">宠物营地</text>
        <text class="leaf-icon-right">🏕️</text>
      </view>

      <!-- 2. 宠物英雄区（大居中区域） -->
      <view class="card-solid pet-camp-hero" wx:if="{{activePet}}">
        <!-- 宠物光晕背景 -->
        <view class="camp-glow-bg"></view>

        <!-- 巨型宠物 emoji + 浮动动画 -->
        <view class="pet-giant-area">
          <view class="pet-emoji-giant {{interacting ? 'interact-bounce' : ''}} {{petStatusClass}}">
            <text class="pet-emoji-xl">{{petEmoji}}</text>
          </view>
        </view>

        <!-- 宠物名字（木纹小标题风格 + 重命名入口） -->
        <view class="wood-title-mini camp-name-tag" bindtap="showRenameModal">
          <text>{{activePet.name}}</text>
          <text class="rename-hint-icon">✏️</text>
        </view>

        <!-- 状态徽章 -->
        <view class="status-badge status-{{activePet.status}}">
          <text>{{statusTextVal}} {{activePet.status === 'happy' ? '😊' : activePet.status === 'normal' ? '😐' : '😔'}}</text>
        </view>

        <!-- XP 进度条（木框 + 叶子填充） -->
        <view class="xp-camp-bar" wx:if="{{activePet}}">
          <view class="xp-camp-info">
            <text class="xp-lv-text">Lv.{{activePet.level}}</text>
            <text class="xp-pct-text">{{xpPercent}}%</text>
          </view>
          <view class="xp-track-wood">
            <view class="xp-fill-green" style="width:{{xpPercent}}%"></view>
          </view>
          <text class="xp-hint">{{activePet.experience || activePet.xp_progress || 0}} / {{stageMaxXp}} XP</text>
        </view>
      </view>

      <!-- 无宠物时显示领养提示 -->
      <view wx:if="{{!activePet && pets.length < 3}}" class="card adopt-section" bindtap="createPet">
        <text class="adopt-emoji">🐾</text>
        <text class="adopt-text">还没有宠物伙伴，点击领养一只吧！</text>
        <view class="btn-leaf adopt-action-btn">＋ 领养宠物</view>
      </view>

      <!-- 3. 操作按钮行（4个木纹按钮） -->
      <view class="card action-row-card" wx:if="{{activePet}}">
        <view class="action-grid">
          <view class="btn-wood action-cell" bindtap="petInteract" data-type="feed">
            <text class="action-emoji">🍖</text>
            <text class="action-name">喂食</text>
          </view>
          <view class="btn-wood action-cell" bindtap="petInteract" data-type="play">
            <text class="action-emoji">🎾</text>
            <text class="action-name">玩耍</text>
          </view>
          <view class="btn-wood action-cell" bindtap="petInteract" data-type="pet">
            <text class="action-emoji">👋</text>
            <text class="action-name">抚摸</text>
          </view>
          <view class="btn-wood action-cell" bindtap="goAIChat">
            <text class="action-emoji">💬</text>
            <text class="action-name">聊天</text>
          </view>
        </view>
      </view>

      <!-- 4. 底部区域（三个 Tab 切换） -->
      <view class="bottom-camp-section" wx:if="{{activePet}}">
        <!-- 木片风格 Tab 切换 -->
        <view class="wood-chip-tabs">
          <view
            class="wood-chip {{activeSection === 'info' ? 'chip-active' : ''}}"
            data-section="info"
            bindtap="switchSection"
          >
            <text>📜 信息</text>
          </view>
          <view
            class="wood-chip {{activeSection === 'backpack' ? 'chip-active' : ''}}"
            data-section="backpack"
            bindtap="switchSection"
          >
            <text>🎒 背包</text>
          </view>
          <view
            class="wood-chip {{activeSection === 'diary' ? 'chip-active' : ''}}"
            data-section="diary"
            bindtap="switchSection"
          >
            <text>📔 日记</text>
          </view>
        </view>

        <!-- ===== 信息视图：日记精选（引用卡片） ===== -->
        <view wx:if="{{activeSection === 'info'}}" class="tab-content">
          <view wx:if="{{diary.length > 0}}" class="quote-card info-diary-card">
            <text class="quote-accent">📝</text>
            <view class="quote-body">
              <text class="diary-date-label">{{diary[0].date}}</text>
              <text class="quote-text">{{diary[0].content}}</text>
            </view>
          </view>
          <view wx:else class="card empty-diary-card">
            <text class="empty-emoji">🌿</text>
            <text class="empty-msg">还没有日记记录，快和{{activePet.name}}互动吧～</text>
          </view>
        </view>

        <!-- ===== 背包视图：2×2 物品网格（木框卡片） ===== -->
        <view wx:if="{{activeSection === 'backpack'}}" class="tab-content">
          <!-- [中优先级修复] 背包空状态 -->
          <view wx:if="{{!backpack || backpack.length === 0}}" class="card empty-diary-card">
            <text class="empty-emoji">🎒</text>
            <text class="empty-msg">背包空空如也，完成目标获取奖励吧～</text>
          </view>
          <view wx:else class="backpack-grid">
            <view
              wx:for="{{backpack}}"
              wx:key="index"
              class="wood-item-card {{item.count <= 0 ? 'item-empty' : ''}}"
              data-index="{{index}}"
              bindtap="useItem"
            >
              <text class="item-icon">{{item.icon}}</text>
              <text class="item-name">{{item.name}}</text>
              <text class="item-count">×{{item.count}}</text>
              <text class="item-desc">{{item.desc}}</text>
            </view>
          </view>
        </view>

        <!-- ===== 日记视图：列表（虚线卡片） ===== -->
        <view wx:if="{{activeSection === 'diary'}}" class="tab-content">
          <view wx:if="{{diary.length === 0}}" class="card empty-diary-card">
            <text class="empty-emoji">📔</text>
            <text class="empty-msg">暂无日记记录</text>
          </view>
          <view wx:else class="diary-list-camp">
            <view wx:for="{{diary}}" wx:key="index" class="card diary-entry-card">
              <view class="diary-entry-top">
                <text class="diary-date-badge">{{item.date}}</text>
                <text class="diary-mood-emoji">
                  {{item.mood === 'happy' ? '😊' : item.mood === 'normal' ? '😐' : '😔'}}
                </text>
              </view>
              <text class="diary-entry-text">{{item.content}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 底部留白 -->
      <view class="pets-bottom-space"></view>

    </view>
  </scroll-view>

  <!-- ===== 重命名弹窗（木纹弹窗） ===== -->
  <view wx:if="{{showRenameModal}}" class="rename-overlay" bindtap="cancelRenameModal">
    <view class="rename-modal-wood" catchtap>
      <view class="rename-header-wood">
        <text class="rename-icon-wood">✏️</text>
        <text class="rename-title-wood">给宠物改名</text>
      </view>
      <input
        class="rename-input-wood"
        placeholder="输入新名字..."
        value="{{renameInput}}"
        bindinput="onRenameInput"
        maxlength="8"
      />
      <view class="rename-actions-wood">
        <button class="btn-wood rename-cancel-btn" bindtap="cancelRenameModal">取消</button>
        <button class="btn-leaf rename-confirm-btn" bindtap="renamePet">确定</button>
      </view>
    </view>
  </view>
</view>
