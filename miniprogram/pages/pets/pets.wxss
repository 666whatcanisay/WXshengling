/* ============================================ */
/*  Pet V4 - 产品级视觉系统                      */
/*  配色: 深墨绿底 + 木纹柜 + 奶油米黄 + 叶子绿  */
/* ============================================ */

/* ===== 页面根容器 ===== */
.page {
  --bg-deep: #2D4A3E;
  --bg-main: #355447;
  --bg-card: #3D6254;
  --bg-card-light: #4A7361;
  --wood-dark: #8B6914;
  --wood: #B8860B;
  --wood-light: #DAA520;
  --cream: #F5E6C8;
  --cream-soft: #E8D9BB;
  --leaf-green: #7CB342;
  --leaf-light: #AED581;
  --accent-orange: #FFAB40;
  --text-primary: #F5E6C8;
  --text-secondary: #C4B89A;
  --text-muted: #8B9A7D;
  --card-radius: 28rpx;

  min-height: 100vh;
  background: radial-gradient(ellipse at center top, var(--bg-main) 0%, var(--bg-deep) 70%);
  background-attachment: fixed;
}

.pets-scroll { height: 100vh; }
.pets-inner { max-width: 720rpx; margin: 0 auto; padding: 24rpx 20rpx 180rpx; }

/* ===== 骨架屏（拆分多行，避免超长）===== */
.skeleton-wrap { padding: 24rpx; }
.sk-hero {
  height: 560rpx;
  background: linear-gradient(90deg, rgba(61,98,84,0.5) 25%, rgba(74,115,97,0.4) 50%, rgba(61,98,84,0.5) 75%);
  background-size: 200% 100%;
  animation: skShimmer 1.5s infinite;
  border-radius: 32rpx;
  margin-bottom: 22rpx;
}
.sk-actions {
  height: 160rpx;
  background: linear-gradient(90deg, rgba(61,98,84,0.5) 25%, rgba(74,115,97,0.4) 50%, rgba(61,98,84,0.5) 75%);
  background-size: 200% 100%;
  animation: skShimmer 1.5s infinite;
  border-radius: 28rpx;
  margin-bottom: 22rpx;
}
.sk-bottom {
  height: 300rpx;
  background: linear-gradient(90deg, rgba(61,98,84,0.5) 25%, rgba(74,115,97,0.4) 50%, rgba(61,98,84,0.5) 75%);
  background-size: 200% 100%;
  animation: skShimmer 1.5s infinite;
  border-radius: 28rpx;
}
@keyframes skShimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ===== 标题栏 ===== */
.wood-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: linear-gradient(135deg, var(--wood-dark), var(--wood));
  border-radius: 50rpx;
  padding: 18rpx 48rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.3), inset 0 2rpx 4rpx rgba(255,255,255,0.1);
}
.leaf-icon-left,
.leaf-icon-right {
  font-size: 32rpx;
  animation: leafSway 3s ease-in-out infinite;
}
.leaf-icon-right { animation-delay: -1.5s; }
.wood-title-text {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--cream);
  letter-spacing: 4rpx;
}
@keyframes leafSway {
  0%,100% { transform: rotate(0deg); }
  25% { transform: rotate(10deg); }
  75% { transform: rotate(-10deg); }
}

/* ===== 卡片通用 ===== */
.card {
  background: rgba(61,98,84,0.6);
  border: 2rpx dashed rgba(165,190,140,0.4);
  border-radius: 28rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 22rpx;
  backdrop-filter: blur(8rpx);
}
.card-solid {
  background: linear-gradient(135deg, var(--bg-card), var(--bg-card-light));
  border: 3rpx solid var(--wood);
  border-radius: 28rpx;
  padding: 0;
  margin-bottom: 22rpx;
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.25);
  text-align: center;
  position: relative;
  overflow: hidden;
}

/* V6: 宠物轮播容器 */
.pet-carousel {
  width: 100%;
  position: relative;
}
/* 营地swiper轮播 */
.camp-swiper {
  width: 100%;
  height: 1500rpx;
}
.camp-swiper swiper-item {
  overflow-y: auto;
}
/* 营地swiper内部滚动容器 */
.camp-scroll {
  height: 100%;
  box-sizing: border-box;
}

/* 轮播指示点 */
.carousel-dots {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0 8rpx;
}

.carousel-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  transition: all 0.3s ease;
}

.carousel-dot.dot-active {
  width: 32rpx;
  border-radius: 8rpx;
  background: #FFD54F;
}

/* 宠物主卡头部 */
.pet-hero-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 营地页左侧领新蛋按钮（浮动在卡片左边缘） */
.camp-new-egg-btn {
  position: absolute;
  left: -8rpx;
  top: 24rpx;
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  background: linear-gradient(135deg, #7CB342, #558B2F);
  border-radius: 0 20rpx 20rpx 0;
  box-shadow: 2rpx 4rpx 12rpx rgba(124,179,66,0.35);
  z-index: 10;
}
.camp-new-egg-btn:active { transform: scale(0.94); opacity: 0.85; }
.camp-new-egg-icon { font-size: 22rpx; }
.camp-new-egg-text { font-size: 20rpx; color: #fff; font-weight: 600; }

.pet-card-header {
  position: relative;
  width: 100%;
  padding: 32rpx 28rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 稀有度徽章 */
.rarity-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.3);
  z-index: 2;
}
.rarity-badge-text {
  font-size: 22rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 2rpx;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.4);
}

/* V8.0 天赋标记 */
.talent-badge {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 12rpx;
  margin-left: 12rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 700;
}
.talent-icon { font-size: 22rpx; }
.talent-name { font-size: 18rpx; }

/* S级天赋金色闪烁 */
.talent-badge[style*="FFD700"] .talent-icon {
  animation: talent-gold-pulse 2s ease-in-out infinite;
}

@keyframes talent-gold-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.15); }
}

/* V7 颜色档次标记 */
.color-tier-tag {
  font-size: 24rpx;
  margin-left: 6rpx;
}
.color-tier-tag.rare-tag {
  animation: rare-pulse 2s ease-in-out infinite;
}

@keyframes shiny-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.6; transform: scale(1.2); }
}

@keyframes rare-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.7; transform: scale(1.15); }
}

/* V7 异色宠物容器增强 */
.shiny-pet .pet-display-area {
  box-shadow: 0 0 20rpx rgba(255, 215, 0, 0.3);
}

/* V7.1 稀有档宠物容器 */
.rare-pet .pet-display-area {
  box-shadow: 0 0 16rpx rgba(68, 138, 255, 0.25);
}

.shiny-shimmer {
  animation: shimmer 2s ease-in-out infinite;
}

@keyframes shimmer {
  0% { filter: brightness(1) hue-rotate(0deg); }
  50% { filter: brightness(1.3) hue-rotate(15deg); }
  100% { filter: brightness(1) hue-rotate(0deg); }
}

/* 宠物名称 */
.pet-name-section {
  width: 100%;
  text-align: center;
  margin-bottom: 8rpx;
}
.pet-name-text {
  font-size: 38rpx;
  font-weight: 900;
  color: var(--cream);
  letter-spacing: 3rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

/* 称号标签行 */
.pet-title-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10rpx;
  margin-top: 4rpx;
}
.title-tag {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  background: rgba(255,255,255,0.06);
  border: 1rpx solid rgba(255,255,255,0.1);
  border-radius: 999rpx;
  letter-spacing: 1rpx;
}

/* 宠物展示区 */
.camp-glow-bg {
  position: absolute;
  top: 15%;
  left: 50%;
  width: 360rpx;
  height: 360rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}

.pet-display-area {
  position: relative;
  z-index: 1;
  margin-bottom: 10rpx;
  margin-top: 10rpx;
}

/* 增强展示区 */
.pet-display-enhanced {
  width: 320rpx;
  height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pet-emoji-wrap {
  position: relative;
  animation: campFloat 3s ease-in-out infinite;
  text-align: center;
}

.pet-image-enhanced {
  width: 260rpx;
  height: 260rpx;
}
/* 云存储图片叠加层（绝对定位在emoji上方） */
.pet-image-overlay {
  position: absolute;
  width: 260rpx;
  height: 260rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}
.pet-image-lg {
  width: 240rpx;
  height: 240rpx;
}
.pet-emoji-enhanced {
  font-size: 140rpx;
  line-height: 1.2;
}
.pet-emoji-xl {
  font-size: 160rpx;
  line-height: 1.2;
}

@keyframes campFloat {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}

/* 互动弹跳 */
.interact-bounce {
  animation: interactBounce 0.5s ease !important;
}
@keyframes interactBounce {
  0% { transform: scale(1) translateY(0); }
  30% { transform: scale(1.15) translateY(-20rpx); }
  60% { transform: scale(0.95) translateY(0); }
  100% { transform: scale(1) translateY(0); }
}

/* 粒子层 */
.particle-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
  overflow: hidden;
}
.particle-dust::before,
.particle-sparkle::before,
.particle-flow::before,
.particle-star-burst::before {
  content: '';
  position: absolute;
  inset: 0;
}

/* ===== 稀有度视觉特效 ===== */
.rarity-rare .camp-glow-bg {
  animation: rareGlowPulse 4s ease-in-out infinite;
}
@keyframes rareGlowPulse {
  0%,100% { opacity: 0.15; }
  50% { opacity: 0.35; }
}

.rarity-epic .camp-glow-bg {
  animation: epicGlowPulse 3s ease-in-out infinite;
}
@keyframes epicGlowPulse {
  0%,100% { opacity: 0.25; filter: blur(20rpx); }
  50% { opacity: 0.55; filter: blur(35rpx); }
}

.rarity-legendary .camp-glow-bg {
  animation: legendaryBreathGlow 2.5s ease-in-out infinite;
}
@keyframes legendaryBreathGlow {
  0%,100% { opacity: 0.2; transform: scale(0.95); filter: blur(30rpx); }
  50% { opacity: 0.65; transform: scale(1.08); filter: blur(55rpx); }
}

/* 标签切换栏 */
.section-tabs {
  display: flex;
  width: 100%;
  padding: 0 28rpx;
  margin-top: 6rpx;
  border-bottom: 1rpx solid rgba(184,134,11,0.2);
}
.section-tab {
  flex: 1;
  padding: 18rpx 0 14rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-muted);
  position: relative;
  transition: color 0.3s;
}
.section-tab.tab-active {
  color: var(--wood-light);
}
.section-tab.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 15%;
  width: 70%;
  height: 4rpx;
  background: var(--wood-light);
  border-radius: 2rpx;
}

/* 面板内容区 */
.section-content {
  width: 100%;
  padding: 20rpx 28rpx 28rpx;
  text-align: left;
}
.panel-section {
  background: rgba(0,0,0,0.12);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.panel-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 14rpx;
}
.panel-title-icon { font-size: 28rpx; }
.panel-title-text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--cream);
  letter-spacing: 1rpx;
}

/* 五维属性面板 */
.attr-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.attr-item {
  background: rgba(255,255,255,0.03);
  border-radius: 12rpx;
  padding: 8rpx 12rpx;
  transition: background 0.3s;
}
.attr-item.attr-top {
  background: rgba(255,215,0,0.06);
  border: 1rpx solid rgba(255,215,0,0.15);
}
.attr-header {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 6rpx;
}
.attr-icon {
  font-size: 22rpx;
  width: 32rpx;
  text-align: center;
}
.attr-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  width: 48rpx;
  font-weight: 500;
}
.attr-value-num {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--cream);
  margin-left: auto;
}
.attr-top-badge {
  font-size: 18rpx;
  font-weight: 700;
  color: #FFD700;
  margin-left: 6rpx;
}
.attr-bar-track {
  height: 12rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 6rpx;
  overflow: hidden;
}
.attr-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.8s ease;
}

/* 亲密度面板 */
.bond-panel { padding: 4rpx 0; }
.bond-level-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 10rpx;
}
.bond-icon { font-size: 32rpx; }
.bond-level-name {
  font-size: 28rpx;
  font-weight: 800;
}
.bond-bar-track {
  height: 14rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 7rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}
.bond-bar-fill {
  height: 100%;
  border-radius: 7rpx;
  transition: width 0.8s ease;
}
.bond-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.bond-value {
  font-size: 22rpx;
  color: var(--text-secondary);
}
.bond-remaining {
  font-size: 22rpx;
  color: var(--text-muted);
}
.bond-max {
  color: var(--wood-light);
  font-weight: 600;
}

/* 心情气泡 */
.mood-bubble-wrap {
  display: flex;
  justify-content: center;
  padding: 10rpx 0;
}
.mood-bubble-inner {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.mood-emoji {
  font-size: 56rpx;
  animation: moodFloat 2.5s ease-in-out infinite;
}
@keyframes moodFloat {
  0%,100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-8rpx) scale(1.05); }
}
.mood-bubble {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  border: 1.5rpx solid;
  backdrop-filter: blur(4rpx);
  position: relative;
  animation: moodBubblePop 0.4s ease-out;
}
.mood-bubble::before {
  content: '';
  position: absolute;
  left: -10rpx;
  top: 50%;
  transform: translateY(-50%);
  border: 10rpx solid transparent;
  border-right-color: inherit;
}
.mood-bubble-text {
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  white-space: nowrap;
}
@keyframes moodBubblePop {
  0% { transform: scale(0.6); opacity: 0; }
  70% { transform: scale(1.08); }
  100% { transform: scale(1); opacity: 1; }
}

/* 蛋阶段（神秘蛋模式） */
.egg-hero-card {
  padding: 40rpx 28rpx 32rpx;
}
.egg-name-section {
  margin-bottom: 10rpx;
  z-index: 1;
  position: relative;
}
.egg-mystery-name {
  font-size: 48rpx;
  font-weight: 900;
  color: var(--cream);
  letter-spacing: 8rpx;
  text-shadow: 0 0 20rpx rgba(218,165,32,0.3);
  animation: eggMysteryPulse 2s ease-in-out infinite;
}
@keyframes eggMysteryPulse {
  0%,100% { opacity: 0.5; letter-spacing: 8rpx; }
  50% { opacity: 1; letter-spacing: 12rpx; }
}
.egg-hidden-badges {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
  z-index: 1;
  position: relative;
}
.egg-hidden-tag {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-muted);
  background: rgba(0,0,0,0.15);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  letter-spacing: 1rpx;
}
.egg-display-area {
  width: 280rpx;
  height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 10rpx;
}
.egg-shake-wrap {
  animation: eggShakeIntense 1.2s ease-in-out infinite;
}
.egg-image {
  width: 200rpx;
  height: 200rpx;
}
.egg-emoji {
  font-size: 160rpx;
}
@keyframes eggShakeIntense {
  0%,100% { transform: rotate(0deg) translateX(0); }
  15% { transform: rotate(-6deg) translateX(-4rpx); }
  30% { transform: rotate(5deg) translateX(3rpx); }
  45% { transform: rotate(-3deg) translateX(-2rpx); }
  60% { transform: rotate(2deg) translateX(1rpx); }
  75% { transform: rotate(-1deg); }
}

/* 蛋光晕 */
.egg-glow-bg {
  position: absolute;
  top: 15%;
  left: 50%;
  width: 320rpx;
  height: 320rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}
.egg-shake-glow {
  animation: eggGlowPulse 1.5s ease-in-out infinite;
}
@keyframes eggGlowPulse {
  0%,100% { opacity: 0.4; transform: translateX(-50%) scale(1); }
  50% { opacity: 0.8; transform: translateX(-50%) scale(1.1); }
}

/* 孵化进度 */
.hatch-progress-section {
  width: 100%;
  margin-top: 8rpx;
  z-index: 1;
  position: relative;
}
.hatch-info-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.hatch-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.hatch-pct {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--accent-orange);
}
.hatch-track {
  height: 16rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}
.hatch-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--accent-orange), var(--wood-light));
  border-radius: 8rpx;
  transition: width 0.6s ease;
}
.egg-hint {
  font-size: 22rpx;
  color: var(--text-muted);
  display: block;
}
.egg-tip {
  font-size: 20rpx;
  color: var(--text-muted);
  display: block;
  margin-top: 8rpx;
  line-height: 1.5;
}

/* 成长面板 */
.xp-panel { padding: 4rpx 0; }
.xp-level-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.xp-lv-label {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--cream);
}
.xp-pct-text {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--accent-orange);
}
.xp-bar-track {
  height: 14rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 7rpx;
  overflow: hidden;
  margin-bottom: 6rpx;
}
.xp-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--leaf-green), var(--leaf-light));
  border-radius: 7rpx;
  transition: width 0.6s ease;
}
.xp-hint {
  font-size: 20rpx;
  color: var(--text-muted);
}

/* 互动按钮 */
.interact-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.btn-interact {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 20rpx 0;
  border-radius: 20rpx;
  border: none;
  background: rgba(255,255,255,0.05);
  transition: all 0.2s;
}
.btn-interact:active {
  transform: scale(0.92);
}
.interact-feed {
  background: rgba(124,179,66,0.15);
  border: 1rpx solid rgba(124,179,66,0.25);
}
.interact-play {
  background: rgba(66,165,245,0.15);
  border: 1rpx solid rgba(66,165,245,0.25);
}
.interact-pat {
  background: rgba(239,83,80,0.15);
  border: 1rpx solid rgba(239,83,80,0.25);
}
.interact-icon { font-size: 44rpx; }
.interact-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--cream);
}

/* 额外操作按钮 */
.action-row-extra {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.action-btn {
  flex: 1;
  min-width: 120rpx;
  font-size: 22rpx !important;
  padding: 14rpx 10rpx !important;
}

/* 图鉴入口卡片 */
.dex-entry-card {
  background: rgba(0,0,0,0.08);
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  position: relative;
  cursor: pointer;
  transition: background 0.3s;
}
.dex-entry-card:active {
  background: rgba(0,0,0,0.15);
}
.dex-entry-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}
.dex-entry-icon { font-size: 28rpx; }
.dex-entry-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--cream);
}
.dex-entry-right {
  position: absolute;
  right: 20rpx;
  top: 16rpx;
  text-align: right;
}
.dex-entry-count {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--wood-light);
  display: block;
}
.dex-entry-pct {
  font-size: 20rpx;
  color: var(--text-muted);
}
.dex-bar-track {
  height: 8rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 4rpx;
  overflow: hidden;
}
.dex-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--wood), var(--wood-light));
  border-radius: 4rpx;
  transition: width 0.8s ease;
}

/* 空状态 */
.empty-pet-card {
  padding: 60rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty-pet-emoji {
  font-size: 120rpx;
  margin-bottom: 16rpx;
}
.empty-pet-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--cream);
  margin-bottom: 8rpx;
}
.empty-pet-desc.empty-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 24rpx;
}
.empty-action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}
.empty-action-row .btn-leaf,
.empty-action-row .btn-wood {
  flex: 1;
}
.btn-leaf {
  background: linear-gradient(135deg, var(--leaf-green), var(--leaf-light));
  color: #1B3A2D;
  font-size: 26rpx;
  font-weight: 700;
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  border: none;
}
.btn-leaf:active { opacity: 0.8; }
.btn-wood {
  background: linear-gradient(135deg, var(--wood-dark), var(--wood));
  color: var(--cream);
  font-size: 24rpx;
  font-weight: 600;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  border: none;
}
.btn-wood:active { opacity: 0.8; }

/* 背包 */
.backpack-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}
.wood-item-card {
  background: rgba(0,0,0,0.1);
  border-radius: 16rpx;
  padding: 16rpx;
  text-align: center;
  border: 1rpx solid rgba(184,134,11,0.15);
}
.wood-item-card:active { opacity: 0.7; }
.wood-item-card.item-empty { opacity: 0.4; }
.item-icon {
  font-size: 40rpx;
  display: block;
  margin-bottom: 4rpx;
}
.item-name {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--cream);
  display: block;
}
.item-count {
  font-size: 20rpx;
  color: var(--text-muted);
  display: block;
}
.item-desc {
  font-size: 18rpx;
  color: var(--text-muted);
  display: block;
  margin-top: 2rpx;
}
.empty-diary-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  justify-content: center;
}
.empty-emoji { font-size: 48rpx; }
.empty-msg {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 浮动反馈层 */
.floating-feedback-overlay {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 999;
}
.floating-feedback-bubble {
  position: absolute;
  transform: translate(-50%, -50%);
  animation: floatUpFade 1.5s ease-out forwards;
}
.floating-feedback-text {
  font-size: 32rpx;
  font-weight: 900;
  color: #FFD700;
  text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.6), 0 0 20rpx rgba(255,215,0,0.3);
  text-align: center;
  white-space: pre-line;
  line-height: 1.4;
}
@keyframes floatUpFade {
  0% { opacity: 1; transform: translate(-50%, -50%) scale(0.6); }
  20% { opacity: 1; transform: translate(-50%, -60%) scale(1.1); }
  40% { opacity: 1; transform: translate(-50%, -70%) scale(1); }
  100% { opacity: 0; transform: translate(-50%, -100%) scale(0.8); }
}

/* 孵化揭晓弹窗 */
.reveal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 500;
  backdrop-filter: blur(8rpx);
}
.reveal-modal {
  background: linear-gradient(180deg, #2D4A3E, #1B2E25);
  border: 3rpx solid rgba(255,213,79,0.5);
  border-radius: 32rpx;
  padding: 28rpx 24rpx 24rpx;
  width: 88%;
  max-width: 620rpx;
  position: relative;
  overflow: hidden;
  animation: revealModalIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  box-shadow: 0 24rpx 72rpx rgba(0,0,0,0.6), 0 0 60rpx rgba(255,213,79,0.15);
}
@keyframes revealModalIn {
  0% { transform: scale(0.5) translateY(60rpx); opacity: 0; }
  70% { transform: scale(1.02); }
  100% { transform: scale(1) translateY(0); opacity: 1; }
}
.reveal-header {
  text-align: center;
  margin-bottom: 20rpx;
}
.reveal-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #FFD54F;
  letter-spacing: 2rpx;
}
.reveal-content { padding: 8rpx 0; }
.reveal-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(184,134,11,0.15);
}
.reveal-label {
  font-size: 24rpx;
  color: #90A4AE;
  font-weight: 500;
}
.reveal-value {
  font-size: 28rpx;
  font-weight: 800;
}
.species-value { color: #F5E6C8; }

.reveal-actions {
  margin-top: 24rpx;
  text-align: center;
}
.reveal-confirm-btn {
  padding: 16rpx 48rpx;
  font-size: 27rpx;
  font-weight: 700;
}

/* 揭晓属性条 */
.reveal-attrs {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed rgba(184,134,11,0.2);
}
.reveal-attr-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 0;
}
.ra-icon {
  font-size: 22rpx;
  width: 36rpx;
  text-align: center;
}
.ra-label {
  font-size: 20rpx;
  color: #90A4AE;
  width: 56rpx;
}
.ra-bar {
  flex: 1;
  height: 10rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 5rpx;
  overflow: hidden;
}
.ra-fill {
  height: 100%;
  border-radius: 5rpx;
  transition: width 0.8s ease;
}
.ra-val {
  font-size: 20rpx;
  font-weight: 700;
  width: 48rpx;
  text-align: right;
  color: var(--cream);
}

/* 弹窗通用 */
.rename-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 500;
  backdrop-filter: blur(6rpx);
}
.rename-modal-wood {
  background: linear-gradient(135deg, var(--bg-card), var(--bg-card-light));
  border: 3rpx solid var(--wood);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  width: 75%;
  max-width: 520rpx;
  text-align: center;
}
.rename-header-wood {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}
.rename-icon-wood { font-size: 32rpx; }
.rename-title-wood {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--cream);
}
.rename-input-wood {
  width: 100%;
  padding: 16rpx 0;
  font-size: 28rpx;
  background: rgba(0,0,0,0.15);
  border: 2rpx solid rgba(184,134,11,0.3);
  border-radius: 16rpx;
  text-align: center;
  color: var(--cream);
  box-sizing: border-box;
  margin-bottom: 24rpx;
}
.rename-input-wood::placeholder { color: var(--text-muted); }
.rename-actions-wood {
  display: flex;
  gap: 16rpx;
  justify-content: center;
}
.rename-cancel-btn {
  background: rgba(0,0,0,0.2) !important;
  color: var(--text-muted) !important;
}
.rename-confirm-btn {
  padding: 14rpx 40rpx;
  font-size: 26rpx;
  font-weight: 700;
}

/* 觉醒预览 */
.awaken-preview {
  text-align: center;
  padding: 16rpx 0;
}
.awaken-from {
  font-size: 28rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 8rpx;
}
.awaken-arrow {
  font-size: 28rpx;
  color: var(--wood-light);
  display: block;
  margin-bottom: 8rpx;
}
.awaken-to {
  font-size: 34rpx;
  font-weight: 900;
  color: #FFD54F;
  display: block;
  text-shadow: 0 0 16rpx rgba(255,213,79,0.3);
}
.awaken-desc {
  font-size: 22rpx;
  color: var(--text-muted);
  display: block;
  margin-top: 12rpx;
  line-height: 1.5;
}
.awaken-confirm-btn {
  padding: 14rpx 40rpx;
  font-size: 26rpx;
  font-weight: 700;
}

/* 图鉴弹窗 */
.dex-overlay {
  align-items: flex-start;
  padding-top: 10vh;
}
.dex-modal {
  background: linear-gradient(135deg, var(--bg-card), var(--bg-card-light));
  border: 3rpx solid var(--wood);
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  width: 85%;
  max-width: 600rpx;
  max-height: 75vh;
  display: flex;
  flex-direction: column;
}
.dex-modal-header { margin-bottom: 16rpx; }
.dex-modal-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--cream);
  display: block;
  margin-bottom: 8rpx;
  text-align: center;
}
.dex-modal-summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.dex-modal-count {
  font-size: 22rpx;
  color: var(--text-secondary);
}
.dex-modal-pct {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--wood-light);
}
.dex-species-list {
  flex: 1;
  overflow-y: auto;
}
.dex-species-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 6rpx;
}
.dex-owned {
  background: rgba(124,179,66,0.08);
}
.dex-unowned {
  background: rgba(0,0,0,0.08);
  opacity: 0.6;
}
.dex-sp-icon {
  font-size: 32rpx;
  width: 48rpx;
  text-align: center;
}
.dex-sp-name {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--cream);
  flex: 1;
}
.dex-sp-status {
  font-size: 20rpx;
  color: var(--text-muted);
}
.dex-close-area {
  text-align: center;
  margin-top: 16rpx;
}
.dex-close-btn {
  padding: 12rpx 40rpx;
  font-size: 24rpx;
}

/* 底部间距 */
.pets-bottom-space { height: 60rpx; }

/* ===== V4 新增样式 ===== */

/* 名称行：稀有度 + 名字 + 档案按钮 */
.name-row-v3 {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
}
.rename-hint-icon {
  font-size: 20rpx;
  opacity: 0.5;
}
.profile-btn {
  font-size: 28rpx;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  background: rgba(255,255,255,0.05);
}
.awaken-tag {
  font-size: 22rpx;
  margin-left: 4rpx;
}

/* 物种+属性标签行 */
.attr-row {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin-top: 6rpx;
}
.attr-chip {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 600;
  border-style: solid;
  border-width: 1rpx;
}
.species-chip {
  background: rgba(245,230,200,0.08);
  border-color: rgba(245,230,200,0.2);
  color: var(--cream);
}
.type-chip {
  background: rgba(124,179,66,0.1);
  border-color: rgba(124,179,66,0.25);
  color: var(--leaf-green);
}
.attr-icon { font-size: 20rpx; }

/* 心情+对话气泡 */
.mood-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  margin-top: 10rpx;
}
.mood-speech {
  font-size: 21rpx;
  color: var(--text-secondary);
  font-style: italic;
  line-height: 1.4;
  text-align: center;
}

/* XP进度条（V4格式）*/
.xp-camp-bar {
  width: 100%;
  margin-top: 10rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
}
.xp-camp-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}
.stage-lv-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.stage-tag {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--cream-soft);
  padding: 2rpx 12rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 8rpx;
}
.xp-lv-text {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--accent-orange);
}
.xp-pct-text {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--accent-orange);
}
.xp-track-wood {
  height: 14rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 7rpx;
  overflow: hidden;
  margin-bottom: 4rpx;
}
.xp-fill-green {
  height: 100%;
  background: linear-gradient(90deg, var(--leaf-green), var(--leaf-light));
  border-radius: 7rpx;
  transition: width 0.6s ease;
}
.xp-hint {
  font-size: 19rpx;
  color: var(--text-muted);
  text-align: right;
}
.stage-arrow {
  font-size: 20rpx;
  color: var(--text-muted);
}
.stage-next-tag {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--accent-orange);
  padding: 2rpx 12rpx;
  background: rgba(255,165,0,0.08);
  border-radius: 8rpx;
}
.xp-hint-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 4rpx;
}
.xp-hint-sub {
  font-size: 18rpx;
  color: var(--text-dim);
}

/* 亲密度条（V4格式）*/
.bond-section {
  width: 100%;
  margin-top: 8rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
}
.bond-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
}
.bond-icon { font-size: 24rpx; }
.bond-name {
  font-size: 22rpx;
  font-weight: 700;
}
.bond-value {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-left: auto;
}
.bond-track {
  height: 10rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 5rpx;
  overflow: hidden;
  margin-bottom: 4rpx;
}
.bond-fill {
  height: 100%;
  border-radius: 5rpx;
  transition: width 0.8s ease;
}

/* 性格标签区 */
.personality-tag-area {
  margin: 16rpx 20rpx;
}
.personality-main-tag {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 22rpx;
  border-radius: 18rpx;
  border-style: solid;
  border-width: 1.5rpx;
}
.perso-icon { font-size: 30rpx; }
.perso-name { font-size: 26rpx; font-weight: 700; }
.perso-desc { font-size: 20rpx; color: #90A4AE; margin-left: auto; }

/* 称号展示区 */
.titles-area {
  margin: 12rpx 20rpx;
}
.section-header { margin-bottom: 8rpx; }
.section-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--cream);
}
.title-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 8rpx;
}
.title-chip {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  border-style: solid;
  border-width: 1rpx;
  font-size: 21rpx;
  font-weight: 600;
  background: rgba(255,255,255,0.05);
}

/* 五维属性面板（V4）*/
.attributes-section {
  margin: 12rpx 20rpx;
}
.attrs-grid {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 8rpx;
}

/* 操作按钮行 */
.action-row-card {
  padding: 20rpx 24rpx;
}
.action-grid {
  display: flex;
  gap: 12rpx;
}
.action-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 18rpx 0;
}
.action-emoji { font-size: 42rpx; }
.action-name { font-size: 22rpx; font-weight: 600; color: var(--cream); }

/* 触发觉醒按钮 */
.awaken-trigger-btn {
  margin-top: 16rpx;
  padding: 14rpx 0;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #FFD54F;
  background: linear-gradient(135deg, rgba(255,213,79,0.1), rgba(255,213,79,0.05));
  border: 2rpx solid rgba(255,213,79,0.3);
  border-radius: 20rpx;
}

/* 互动反馈浮层 */
.feedback-toast {
  position: fixed;
  top: 30%;
  left: 50%;
  transform: translateX(-50%);
  z-index: 900;
  background: linear-gradient(135deg, rgba(45,74,62,0.96), rgba(61,98,84,0.96));
  border: 2rpx solid var(--wood);
  border-radius: 20rpx;
  padding: 20rpx 32rpx;
  max-width: 500rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.4);
  animation: feedbackToastIn 0.3s ease-out;
}
.feedback-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--cream);
  line-height: 1.5;
  white-space: pre-line;
}
@keyframes feedbackToastIn {
  from { opacity: 0; transform: translateX(-50%) translateY(-20rpx) scale(0.9); }
  to   { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }
}

/* 木纹Tab切换 */
.wood-chip-tabs {
  display: flex;
  gap: 8rpx;
  padding: 0 20rpx;
  margin-top: 12rpx;
}
.wood-chip {
  flex: 1;
  padding: 14rpx 0;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-muted);
  background: rgba(0,0,0,0.1);
  border-radius: 16rpx;
  border: 1rpx solid transparent;
  transition: all 0.2s;
}
.wood-chip.chip-active {
  color: var(--cream);
  background: rgba(139,105,20,0.2);
  border-color: var(--wood);
}

/* 时间轴 */
.timeline-wrap {
  position: relative;
  padding-left: 36rpx;
  margin-top: 12rpx;
}
.timeline-line {
  position: absolute;
  left: 12rpx;
  top: 0;
  bottom: 0;
  width: 3rpx;
  background: rgba(184,134,11,0.2);
  border-radius: 2rpx;
}
.timeline-item {
  position: relative;
  margin-bottom: 16rpx;
}
.timeline-dot {
  position: absolute;
  left: -30rpx;
  top: 8rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 3rpx solid var(--wood);
  background: var(--bg-card);
  z-index: 1;
}
.dot-default { background: #7CB342; border-color: #7CB342; }
.dot-feed { background: #FFAB40; border-color: #FFAB40; }
.dot-play { background: #42A5F5; border-color: #42A5F5; }
.dot-pet { background: #EF5350; border-color: #EF5350; }
.dot-hatch { background: #FFD54F; border-color: #FFD54F; }
.dot-awaken { background: #E040FB; border-color: #E040FB; }
.timeline-card {
  background: rgba(0,0,0,0.1);
  border-radius: 14rpx;
  padding: 14rpx 16rpx;
}
.timeline-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}
.timeline-time {
  font-size: 19rpx;
  color: var(--text-muted);
}
.timeline-source {
  font-size: 19rpx;
  font-weight: 700;
  color: var(--leaf-green);
}
.timeline-reason {
  font-size: 22rpx;
  color: var(--cream);
  line-height: 1.4;
}

/* 蛋阶段徽章 */
.egg-stage-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 6rpx;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  color: var(--accent-orange);
  background: rgba(255,171,64,0.12);
}

/* 觉醒光环 */
.awaken-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}
.awaken-ring::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 3rpx solid var(--aura-color);
  animation: awakenRingPulse 2s ease-in-out infinite;
}
.awaken-ring::after {
  content: '';
  position: absolute;
  inset: 20rpx;
  border-radius: 50%;
  border: 1.5rpx solid rgba(255,215,0,0.3);
  animation: awakenRingPulse 2s ease-in-out infinite reverse;
}
@keyframes awakenRingPulse {
  0%,100% { transform: scale(0.9); opacity: 0.4; }
  50% { transform: scale(1.1); opacity: 0.9; }
}

/* 性格动画 */
.personality-anim-bouncy { animation: persoBouncy 2.5s ease-in-out infinite; }
.personality-anim-calm { animation: persoCalm 4s ease-in-out infinite; }
.personality-anim-lazy { animation: persoLazy 5s ease-in-out infinite; }
.personality-anim-nervous { animation: persoNervous 1.8s ease-in-out infinite; }
.personality-anim-proud { animation: persoProud 3s ease-in-out infinite; }
@keyframes persoBouncy {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}
@keyframes persoCalm {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-4rpx); }
}
@keyframes persoLazy {
  0%,100% { transform: translateY(0) rotate(0deg); }
  33% { transform: translateY(2rpx) rotate(1deg); }
  66% { transform: translateY(-1rpx) rotate(-1deg); }
}
@keyframes persoNervous {
  0%,100% { transform: translateX(0); }
  25% { transform: translateX(-4rpx); }
  75% { transform: translateX(4rpx); }
}
@keyframes persoProud {
  0%,100% { transform: scaleY(1); }
  50% { transform: scaleY(1.03); }
}

/* 蛋阶段动画 */
.pet-display-egg.egg-stage-crack .pet-emoji-wrap { animation: eggCrackShake 2s ease-in-out infinite; }
.pet-display-egg.egg-stage-glow .pet-emoji-wrap { animation: eggGlowFloat 3s ease-in-out infinite; }
.pet-display-egg.egg-stage-shake .pet-emoji-wrap { animation: eggShakeIntense 0.8s ease-in-out infinite; }
@keyframes eggCrackShake {
  0%,100% { transform: rotate(0deg); }
  25% { transform: rotate(-3deg); }
  75% { transform: rotate(3deg); }
}
@keyframes eggGlowFloat {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

/* ===== V5 新增样式：BUFF标签行 ===== */
.buff-tag-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
}
.buff-chip {
