/* ============================================ */
/*  动森森林治愈风格 - 宠物页样式表              */
/*  配色: 深墨绿底 + 木纹棕 + 奶油米黄 + 叶子绿   */
/* ============================================ */

/* ----- 页面根容器（与首页共享配色体系） ----- */
.page {
  --bg-deep: #2D4A3E;
  --bg-main: #355447;
  --bg-card: #3D6254;
  --bg-card-light: #4A7361;
  --wood-dark: #8B6914;
  --wood: #B8860B;
  --wood-light: #DAA520;
  --cream: #F5E6C8;
  --cream-soft: #E8D9BB;
  --leaf-green: #7CB342;
  --leaf-light: #AED581;
  --accent-orange: #FFAB40;
  --text-primary: #F5E6C8;
  --text-secondary: #C4B89A;
  --text-muted: #8B9A7D;

  min-height: 100vh;
  background: radial-gradient(ellipse at center top, var(--bg-main) 0%, var(--bg-deep) 70%);
  background-attachment: fixed;
}

/* 滚动容器 */
.pets-scroll {
  height: 100vh;
}
.pets-inner {
  max-width: 720rpx;
  margin: 0 auto;
  padding: 24rpx 20rpx 180rpx;
}

/* ===== 骨架屏 ===== */
.skeleton-wrap {
  padding: 24rpx;
}
.sk-hero {
  height: 560rpx;
  background: linear-gradient(90deg, rgba(61,98,84,0.5) 25%, rgba(74,115,97,0.4) 50%, rgba(61,98,84,0.5) 75%);
  background-size: 200% 100%;
  animation: skShimmer 1.5s infinite;
  border-radius: 32rpx;
  margin-bottom: 22rpx;
}
.sk-actions {
  height: 160rpx;
  background: linear-gradient(90deg, rgba(61,98,84,0.5) 25%, rgba(74,115,97,0.4) 50%, rgba(61,98,84,0.5) 75%);
  background-size: 200% 100%;
  animation: skShimmer 1.5s infinite;
  border-radius: 28rpx;
  margin-bottom: 22rpx;
}
.sk-bottom {
  height: 300rpx;
  background: linear-gradient(90deg, rgba(61,98,84,0.5) 25%, rgba(74,115,97,0.4) 50%, rgba(61,98,84,0.5) 75%);
  background-size: 200% 100%;
  animation: skShimmer 1.5s infinite;
  border-radius: 28rpx;
}
@keyframes skShimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ===== 1. 木纹标题栏（复用首页风格） ===== */
.wood-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: linear-gradient(135deg, var(--wood-dark), var(--wood));
  border-radius: 50rpx;
  padding: 18rpx 48rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.3), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.1);
}
.leaf-icon-left,
.leaf-icon-right {
  font-size: 32rpx;
  animation: leafSway 3s ease-in-out infinite;
}
.leaf-icon-right {
  animation-delay: -1.5s;
}
.wood-title-text {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--cream);
  letter-spacing: 4rpx;
}
@keyframes leafSway {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(10deg); }
  75% { transform: rotate(-10deg); }
}

/* ===== 虚线边框卡片（通用） ===== */
.card {
  background: rgba(61, 98, 84, 0.6);
  border: 2rpx dashed rgba(165, 190, 140, 0.4);
  border-radius: 28rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 22rpx;
  backdrop-filter: blur(8rpx);
}
.card:active {
  opacity: 0.85;
  transform: scale(0.99);
  transition: all 0.15s ease;
}

/* ===== 实边卡片（木色边框） ===== */
.card-solid {
  background: linear-gradient(135deg, var(--bg-card), var(--bg-card-light));
  border: 3rpx solid var(--wood);
  border-radius: 28rpx;
  padding: 36rpx 28rpx 32rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.25), inset 0 1rpx 2rpx rgba(255, 255, 255, 0.05);
  text-align: center;
  position: relative;
  overflow: hidden;
}

/* ===== 小木纹标题 ===== */
.wood-title-mini {
  display: inline-flex;
  align-items: center;
  background: linear-gradient(135deg, var(--wood-dark), var(--wood));
  border-radius: 999rpx;
  padding: 8rpx 26rpx;
  box-shadow: 0 3rpx 10rpx rgba(0, 0, 0, 0.2);
}
.wood-title-mini text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--cream);
  letter-spacing: 2rpx;
}

/* ===== 状态徽章 ===== */
.status-badge {
  display: inline-block;
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 500;
  backdrop-filter: blur(4rpx);
  margin-top: 10rpx;
}
.status-happy {
  background: rgba(124, 179, 66, 0.25);
  color: var(--leaf-light);
  border: 1rpx solid rgba(124, 179, 66, 0.45);
}
.status-normal {
  background: rgba(174, 213, 129, 0.2);
  color: var(--cream-soft);
  border: 1rpx solid rgba(174, 213, 129, 0.35);
}
.status-sad {
  background: rgba(255, 171, 64, 0.2);
  color: var(--accent-orange);
  border: 1rpx solid rgba(255, 171, 64, 0.35);
}

/* ===== 2. 宠物英雄区（营地风格） ===== */
.pet-camp-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
}
/* 宠物背后的光晕效果（叶子绿微光） */
.camp-glow-bg {
  position: absolute;
  top: 12%;
  left: 50%;
  width: 300rpx;
  height: 300rpx;
  transform: translateX(-50%);
  background: radial-gradient(circle, rgba(124, 179, 66, 0.2) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}
/* 宠物巨型区域 */
.pet-giant-area {
  position: relative;
  z-index: 1;
  margin-bottom: 14rpx;
  margin-top: 16rpx;
}
.pet-emoji-giant {
  animation: campFloat 3s ease-in-out infinite;
  text-align: center;
}
.pet-emoji-giant.happy {
  animation: campFloat 2.5s ease-in-out infinite, campBounce 1.2s ease infinite;
}
.pet-emoji-giant.normal {
  animation: campFloat 3s ease-in-out infinite, campBreathe 4s ease-in-out infinite;
}
.pet-emoji-giant.sad {
  animation: campFloat 4s ease-in-out infinite, campPulse 3s ease-in-out infinite;
}
.pet-emoji-giant.interact-bounce {
  animation: campPopIn 0.5s ease !important;
}
.pet-emoji-xl {
  font-size: 160rpx;
  display: block;
  line-height: 1.15;
  filter: drop-shadow(0 8rpx 28rpx rgba(124, 179, 66, 0.4));
}
/* 名字标签（可点击重命名） */
.camp-name-tag {
  margin-bottom: 8rpx;
  display: flex; align-items: center; gap: 6rpx;
}
.rename-hint-icon { font-size: 22rpx; opacity: 0.5; }

/* XP 进度条（营地木框风格） */
.xp-camp-bar {
  width: 100%;
  max-width: 520rpx;
  margin-top: 18rpx;
  z-index: 1;
}
.xp-camp-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.xp-lv-text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--cream);
  background: linear-gradient(135deg, var(--wood-dark), var(--wood));
  padding: 3rpx 18rpx;
  border-radius: 999rpx;
}
.xp-pct-text {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--leaf-light);
}
.xp-track-wood {
  height: 20rpx;
  background: rgba(139, 105, 20, 0.3);
  border: 2rpx solid var(--wood-dark);
  border-radius: 999rpx;
  overflow: hidden;
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}
.xp-fill-green {
  height: 100%;
  background: linear-gradient(90deg, var(--leaf-green), var(--leaf-light));
  border-radius: 999rpx;
  transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  position: relative;
}
.xp-fill-green::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.25) 50%, transparent 100%);
  animation: woodBarShine 2.5s ease-in-out infinite;
}
@keyframes woodBarShine {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}
.xp-hint {
  display: block;
  font-size: 21rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

/* 宠物动画关键帧 */
@keyframes campFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}
@keyframes campBounce {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  25% { transform: translateY(-10rpx) rotate(4deg); }
  75% { transform: translateY(-10rpx) rotate(-4deg); }
}
@keyframes campBreathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.04); }
}
@keyframes campPulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.65; transform: scale(0.96); }
}
@keyframes campPopIn {
  0% { transform: scale(0.8); opacity: 0.5; }
  50% { transform: scale(1.15); }
  100% { transform: scale(1); opacity: 1; }
}

/* ===== 领养区 ===== */
.adopt-section {
  text-align: center;
  padding: 40rpx 30rpx;
}
.adopt-emoji {
  font-size: 72rpx;
  display: block;
  margin-bottom: 16rpx;
}
.adopt-text {
  font-size: 27rpx;
  color: var(--cream-soft);
  line-height: 1.6;
  display: block;
  margin-bottom: 24rpx;
}
.adopt-action-btn {
  display: inline-block;
  padding: 14rpx 48rpx;
  font-size: 28rpx;
}

/* ===== 3. 操作按钮行 ===== */
.action-row-card {
  text-align: center;
}
.action-grid {
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
}
.action-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 18rpx 8rpx;
  flex: 1;
  border-radius: 20rpx;
  overflow: hidden;
}
.action-cell:active {
  transform: scale(0.92);
  opacity: 0.85;
}
.action-emoji {
  font-size: 44rpx;
}
.action-name {
  font-size: 24rpx;
  color: var(--cream);
  font-weight: 600;
}

/* ===== 4. 底部 Tab 区域 ===== */
.bottom-camp-section {
  margin-top: 8rpx;
}

/* 木片风格 Tab 切换 */
.wood-chip-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 18rpx;
}
.wood-chip {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--text-secondary);
  border-radius: 18rpx;
  background: rgba(61, 98, 84, 0.5);
  border: 2rpx solid rgba(139, 105, 20, 0.25);
  transition: all 0.25s ease;
  font-weight: 500;
}
.wood-chip:active {
  opacity: 0.8;
}
.wood-chip.chip-active {
  background: linear-gradient(135deg, var(--wood-dark), var(--wood));
  color: var(--cream);
  border-color: var(--wood-light);
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.2);
}

/* Tab 内容区 */
.tab-content {
  animation: tabFadeIn 0.25s ease;
}
@keyframes tabFadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===== 引用悬浮卡片（信息视图） ===== */
.quote-card {
  background: linear-gradient(135deg, rgba(74, 115, 97, 0.8), rgba(61, 98, 84, 0.7));
  border-left: 5rpx solid var(--leaf-green);
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 14rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}
.quote-accent {
  font-size: 32rpx;
  flex-shrink: 0;
  line-height: 1.4;
}
.quote-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.diary-date-label {
  font-size: 21rpx;
  color: var(--text-muted);
  font-weight: 500;
}
.quote-text {
  font-size: 26rpx;
  color: var(--cream-soft);
  line-height: 1.6;
}

/* 空状态 */
.empty-diary-card {
  text-align: center;
  padding: 40rpx 20rpx;
}
.empty-emoji {
  font-size: 56rpx;
  display: block;
  margin-bottom: 14rpx;
}
.empty-msg {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* ===== 背包视图：木框物品卡片网格 ===== */
.backpack-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}
.wood-item-card {
  background: linear-gradient(145deg, var(--bg-card), var(--bg-card-light));
  border: 3rpx solid var(--wood-dark);
  border-radius: 22rpx;
  padding: 28rpx 16rpx 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.2), inset 0 1rpx 2rpx rgba(255, 255, 255, 0.04);
  transition: all 0.2s ease;
}
.wood-item-card:active {
  transform: scale(0.95);
  border-color: var(--leaf-green);
}
.wood-item-card.item-empty {
  opacity: 0.35;
  border-style: dashed;
}
.item-icon {
  font-size: 56rpx;
  display: block;
  margin-bottom: 10rpx;
}
.item-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--cream);
  display: block;
  margin-bottom: 6rpx;
}
.item-count {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--leaf-light);
  display: block;
  margin-bottom: 6rpx;
}
.item-desc {
  font-size: 21rpx;
  color: var(--text-muted);
  display: block;
}

/* ===== 日记视图：卷轴/纸张风格列表 ===== */
.diary-list-camp {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.diary-entry-card {
  padding: 24rpx 26rpx;
}
.diary-entry-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.diary-date-badge {
  font-size: 21rpx;
  color: var(--text-muted);
  background: rgba(139, 105, 20, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 500;
}
.diary-mood-emoji {
  font-size: 32rpx;
}
.diary-entry-text {
  font-size: 26rpx;
  color: var(--cream-soft);
  line-height: 1.65;
}

/* ===== 木纹按钮 ===== */
.btn-wood {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 36rpx;
  background: linear-gradient(135deg, var(--wood-dark), var(--wood));
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--cream);
  border: none;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.25);
  transition: all 0.2s ease;
}
.btn-wood:active {
  transform: scale(0.95);
  opacity: 0.85;
}

/* ===== 绿叶按钮 ===== */
.btn-leaf {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 36rpx;
  background: linear-gradient(135deg, var(--leaf-green), #689F38);
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #fff;
  border: none;
  box-shadow: 0 4rpx 14rpx rgba(124, 179, 66, 0.35);
  transition: all 0.2s ease;
}
.btn-leaf:active {
  transform: scale(0.95);
  opacity: 0.85;
}

/* ===== 重命名弹窗（木纹弹窗） ===== */
.rename-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(45, 74, 62, 0.82);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  backdrop-filter: blur(6rpx);
}
.rename-modal-wood {
  width: 580rpx;
  background: linear-gradient(160deg, var(--bg-card), var(--bg-card-light));
  border: 4rpx solid var(--wood);
  border-radius: 36rpx;
  padding: 40rpx 36rpx 36rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.4), inset 0 1rpx 2rpx rgba(255, 255, 255, 0.05);
  animation: woodModalSlideUp 0.3s ease;
}
@keyframes woodModalSlideUp {
  0% { opacity: 0; transform: translateY(40rpx) scale(0.95); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}
.rename-header-wood {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 26rpx;
}
.rename-icon-wood {
  font-size: 40rpx;
}
.rename-title-wood {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--cream);
  letter-spacing: 2rpx;
}
.rename-input-wood {
  width: 100%;
  height: 88rpx;
  background: rgba(45, 74, 62, 0.5);
  border: 2rpx solid var(--wood-dark);
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--cream);
  box-sizing: border-box;
}
.rename-input-wood:focus {
  border-color: var(--leaf-green);
  box-shadow: 0 0 0 4rpx rgba(124, 179, 66, 0.15);
}
.rename-input-wood::placeholder {
  color: var(--text-muted);
}
.rename-actions-wood {
  display: flex;
  gap: 16rpx;
  margin-top: 30rpx;
}
.rename-cancel-btn,
.rename-confirm-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  text-align: center;
  padding: 0;
}

/* ===== 底部留白（避开自定义TabBar） ===== */
.pets-bottom-space {
  height: 180rpx;
}
