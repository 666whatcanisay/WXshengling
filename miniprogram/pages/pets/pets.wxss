/* ===== 经验泉水系统 ===== */
.fountain-section {
  padding: 0 24rpx 30rpx;
  margin-top: -10rpx;
}

.fountain-card {
  background: linear-gradient(135deg, #1A3A2F, #0D2818);
  border: 2rpx solid rgba(100,200,220,0.25);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  position: relative;
  overflow: hidden;
}
.fountain-card::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle at center, rgba(100,200,220,0.06) 0%, transparent 60%);
  pointer-events: none;
}
.fountain-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 泉水动画区 */
.fountain-visual {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  position: relative;
}
.fountain-water {
  position: relative;
  width: 80rpx;
  height: 60rpx;
}
.fountain-drop {
  position: absolute;
  font-size: 20rpx;
  opacity: 0;
  animation: fountainDrop 2s ease-in-out infinite;
}
.drop-1 { left: 10%; animation-delay: 0s; }
.drop-2 { left: 45%; animation-delay: 0.6s; }
.drop-3 { left: 80%; animation-delay: 1.2s; }
@keyframes fountainDrop {
  0%   { opacity: 0; transform: translateY(-15rpx) scale(0.5); }
  40%  { opacity: 1; transform: translateY(0) scale(1); }
  100% { opacity: 0; transform: translateY(25rpx) scale(0.3); }
}
.fountain-icon {
  font-size: 48rpx;
  margin-top: -4rpx;
  filter: drop-shadow(0 0 12rpx rgba(100,200,220,0.4));
}

/* 泉水信息 */
.fountain-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.fountain-title {
  font-size: 22rpx;
  color: #7EC8CA;
  letter-spacing: 4rpx;
}
.fountain-value {
  font-size: 52rpx;
  font-weight: 900;
  color: #64D8DC;
  text-shadow: 0 0 20rpx rgba(100,216,220,0.35);
  line-height: 1.1;
}
.fountain-unit {
  font-size: 20rpx;
  color: #5ABFBF;
}

/* 操作提示 */
.fountain-action-hint {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  background: rgba(100,216,220,0.08);
  border-radius: 999rpx;
  border: 1rpx solid rgba(100,216,220,0.15);
}
.fountain-hint-text {
  font-size: 18rpx;
  color: #7EC8CA;
}
.fountain-arrow {
  font-size: 18rpx;
  color: #64D8DC;
  animation: arrowPulse 1.5s ease-in-out infinite;
}
@keyframes arrowPulse {
  0%, 100% { transform: translateX(0); opacity: 0.5; }
  50%      { transform: translateX(6rpx); opacity: 1; }
}

/* 空状态 */
.fountain-empty {
  justify-content: center;
  background: linear-gradient(135deg, #1A2018, #121812);
  border-color: rgba(150,130,70,0.15);
}
.fountain-empty-icon { font-size: 36rpx; margin-bottom: 6rpx; }
.fountain-empty-text {
  font-size: 26rpx;
  color: var(--text-muted);
  font-weight: 700;
}
.fountain-empty-hint {
  font-size: 18rpx;
  color: var(--text-secondary);
  display: block;
  margin-top: 4rpx;
}

/* ===== 分配弹窗 ===== */
.fountain-overlay { align-items: flex-end; }
.fountain-modal {
  background: linear-gradient(160deg, #1B3D32, #12261E);
  border: 2rpx solid rgba(100,200,220,0.3);
  border-radius: 28rpx 28rpx 0 0;
  padding: 24rpx 20rpx calc(120rpx + env(safe-area-inset-bottom));
  width: 100%;
  max-height: 70vh;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
}
.fountain-modal-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 24rpx;
  position: relative;
}
.fountain-modal-icon { font-size: 36rpx; }
.fountain-modal-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #64D8DC;
}
.fountain-modal-pool {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  font-size: 20rpx;
  color: #7EC8CA;
  background: rgba(100,200,220,0.08);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

/* 目标选择区 */
.fountain-target-section {
  margin-bottom: 20rpx;
}
.fountain-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
  display: block;
}
.fountain-target-list {
  max-height: 280rpx;
  min-height: 100rpx;
  background: rgba(0,0,0,0.15);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255,255,255,0.05);
}
.fountain-target-item {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
  transition: background 0.15s;
}
.fountain-target-item:last-child { border-bottom: none; }
.fountain-target-item:active { background: rgba(100,200,220,0.08); }
.target-selected {
  background: rgba(100,200,220,0.1) !important;
  border-left: 4rpx solid #64D8DC;
}
.ft-emoji { font-size: 34rpx; width: 56rpx; text-align: center; }
.ft-info { flex: 1; display: flex; flex-direction: column; gap: 2rpx; }
.ft-name {
  font-size: 26rpx;
  color: var(--cream);
  font-weight: 700;
}
.ft-stage {
  font-size: 18rpx;
  color: var(--text-secondary);
}
.ft-check {
  font-size: 28rpx;
  color: #64D8DC;
  font-weight: 900;
  width: 44rpx;
  text-align: right;
}

/* 数量输入区 */
.fountain-amount-section {
  margin-bottom: 24rpx;
}
.fountain-input-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(0,0,0,0.2);
  border-radius: 14rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid rgba(100,200,220,0.15);
}
.fountain-amount-input {
  flex: 1;
  font-size: 30rpx;
  font-weight: 800;
  color: #64D8DC;
  text-align: center;
  background: transparent;
}
.fountain-max-btn {
  font-size: 22rpx;
  color: #FFD54F;
  font-weight: 700;
  padding: 6rpx 16rpx;
  background: rgba(255,213,79,0.1);
  border-radius: 8rpx;
  border: 1rpx solid rgba(255,213,79,0.2);
}
.fountain-slash {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* ===== 快捷投入按钮 ===== */
.quick-add-buttons {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  justify-content: center;
}
.quick-btn {
  min-width: 100rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: rgba(100,200,220,0.12);
  border: 1rpx solid rgba(100,200,220,0.25);
  border-radius: 28rpx;
  color: #80DEEA;
  font-size: 24rpx;
  font-weight: 600;
  padding: 0 20rpx;
}
.quick-btn:active {
