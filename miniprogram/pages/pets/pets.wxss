}
.quick-btn-all {
  background: rgba(255,213,79,0.15);
  border-color: rgba(255,213,79,0.3);
  color: #FFD54F;
}

/* 按钮 */
.fountain-actions {
  display: flex;
  gap: 16rpx;
  margin-top: auto;
  padding-top: 16rpx;
}
.fountain-cancel-btn {
  background: rgba(0,0,0,0.2) !important;
  color: var(--text-muted) !important;
}
.fountain-confirm-btn {
  flex: 1;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  font-weight: 800;
}

/* ===== 蛋花纹系统 ===== */
.egg-pattern-overlay {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  border-radius: 50%;
  pointer-events: none;
}
.ep-char {
  position: absolute;
  font-size: 22rpx;
  opacity: 0.25;
  animation: epFloat 3s ease-in-out infinite;
}
.ep-c1 { top: 12%; left: 15%; animation-delay: 0s; }
.ep-c2 { top: 8%; right: 18%; animation-delay: 0.8s; }
.ep-c3 { bottom: 20%; left: 10%; animation-delay: 1.6s; }
.ep-c4 { bottom: 12%; right: 14%; animation-delay: 2.2s; }
.ep-c5 { top: 45%; left: -2%; animation-delay: 1s; }
@keyframes epFloat {
  0%, 100% { transform: translateY(0) rotate(0deg); opacity: 0.25; }
  50%      { transform: translateY(-8rpx) rotate(10deg); opacity: 0.5; }
}

/* 蛋额外操作行（花纹描述 + 刷新按钮）*/
.egg-extra-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 8rpx;
}
.egg-pattern-desc {
  font-size: 18rpx;
  color: var(--text-muted);
  font-style: italic;
}
.egg-refresh-btn {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 18rpx;
  background: rgba(255,255,255,0.06);
  border: 1rpx solid rgba(255,255,255,0.12);
  border-radius: 999rpx;
  transition: all 0.2s;
}
.egg-refresh-btn:active {
  transform: scale(0.95);
  background: rgba(255,255,255,0.1);
}
.refresh-icon { font-size: 20rpx; }
.refresh-text {
  font-size: 20rpx;
  color: var(--text-secondary);
  font-weight: 600;
}
.egg-new-btn {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 18rpx;
  background: rgba(124,179,66,0.15);
  border: 1rpx solid rgba(124,179,66,0.35);
  border-radius: 999rpx;
  transition: all 0.2s;
}
.egg-new-btn:active {
  transform: scale(0.95);
  background: rgba(124,179,66,0.28);
}
.egg-new-icon { font-size: 20rpx; }
.egg-new-text {
  font-size: 20rpx;
  color: #7CB342;
  font-weight: 600;
}

/* ===== 新手礼包卡片 ===== */
.starter-gift-card {
  position: relative;
  margin: 20rpx 24rpx 0;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #3D2B00, #5D4000);
  border: 2rpx solid rgba(255,193,7,0.35);
  border-radius: 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  overflow: hidden;
}
.sg-glow {
  position: absolute;
  top: -50%; left: -50%;
  width: 200%; height: 200%;
  background: radial-gradient(circle at center, rgba(255,193,7,0.08) 0%, transparent 60%);
  pointer-events: none;
  animation: sgPulse 2.5s ease-in-out infinite;
}
@keyframes sgPulse {
  0%, 100% { opacity: 0.5; }
  50%      { opacity: 1; }
}
.sg-icon { font-size: 44rpx; z-index: 1; }
.sg-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-left: 16rpx;
  z-index: 1;
}
.sg-title {
  font-size: 28rpx;
  font-weight: 900;
  color: #FFD54F;
}
.sg-desc {
  font-size: 20rpx;
  color: #BCAAA4;
}
.sg-arrow {
  font-size: 26rpx;
  color: #FFD54F;
  z-index: 1;
  animation: arrowPulse 1.5s ease-in-out infinite;
}

/* ===== 蛋刷新弹窗 ===== */
.refresh-modal {
  background: linear-gradient(160deg, #1B3A2A, #12261E);
  border: 2rpx solid rgba(124,179,66,0.3);
  border-radius: 28rpx;
  padding: 32rpx 28rpx 36rpx;
  width: 80%;
  max-width: 520rpx;
}
.refresh-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
}
.refresh-icon-big { font-size: 36rpx; }
.refresh-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #AED581;
}
.refresh-subtitle {
  font-size: 22rpx;
  color: var(--text-secondary);
  text-align: center;
  margin-bottom: 24rpx;
  display: block;
}

/* 刷新选项列表 */
.refresh-options {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.refresh-option {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  border-style: solid;
  border-width: 2rpx;
  transition: all 0.15s;
  position: relative;
}
.refresh-option:active { transform: scale(0.98); }
.ropt-selected {
  border-width: 2.5rpx !important;
  box-shadow: 0 0 16rpx rgba(174,213,129,0.2);
}
.ropt-emoji { font-size: 34rpx; width: 56rpx; text-align: center; }
.ropt-name {
  flex: 1;
  font-size: 26rpx;
  font-weight: 800;
  margin-left: 8rpx;
}
.ropt-check {
  position: absolute;
  right: 16rpx;
  font-size: 30rpx;
  font-weight: 900;
}
.ropt-desc {
  position: absolute;
  right: 48rpx;
  bottom: 4rpx;
  font-size: 16rpx;
  color: var(--text-muted);
}

/* 快捷操作行 */
.refresh-actions-row {
  margin-bottom: 16rpx;
}
.refresh-random-btn {
  width: 100% !important;
  padding: 14rpx !important;
  font-size: 24rpx !important;
}

/* 按钮 */
.refresh-actions {
  display: flex;
  gap: 16rpx;
}
.refresh-cancel-btn {
  background: rgba(0,0,0,0.2) !important;
  color: var(--text-muted) !important;
}
.refresh-confirm-btn {
  flex: 1;
  padding: 14rpx 32rpx;
  font-size: 26rpx;
  font-weight: 800;
}

/* ===== P3：成长记录区域 ===== */
.growth-records-section {
  margin-top: 16rpx;
  background: rgba(0,0,0,0.2);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255,255,255,0.06);
  overflow: hidden;
}
.gr-header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
}
.gr-title { font-size: 26rpx; color: #AED581; font-weight: 600; }
.gr-count { font-size: 22rpx; color: #888; margin-left: 12rpx; }
.gr-arrow { font-size: 20rpx; color: #666; margin-left: auto; }
.gr-list { padding: 12rpx 16rpx; }
.gr-item {
  display: flex;
  align-items: center;
  padding: 14rpx 8rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.03);
}
.gr-item:last-child { border-bottom: none; }
.gr-stage {
  width: 120rpx;
  font-size: 22rpx;
  color: #FFD54F;
  font-weight: 600;
  flex-shrink: 0;
}
.gr-msg {
  flex: 1;
  font-size: 24rpx;
  color: #E0E0E0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.gr-time {
  font-size: 20rpx;
  color: #666;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* ===== P4：性格期望弹窗 ===== */
.personality-prompt-modal {
  max-width: 90vw;
}
.personality-prompt-input {
  width: 100%;
  min-height: 160rpx;
  background: rgba(0,0,0,0.25);
  border: 1rpx solid rgba(255,255,255,0.1);
  border-radius: 12rpx;
  padding: 20rpx;
  color: #E0E0E0;
  font-size: 28rpx;
  line-height: 1.6;
  margin-top: 20rpx;
  box-sizing: border-box;
}
.modal-header {
  text-align: center;
  margin-bottom: 16rpx;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #FFD54F;
}
.modal-body {
  margin-bottom: 20rpx;
}
.modal-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  line-height: 1.5;
  margin-bottom: 8rpx;
}
.input-hint {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #666;
  margin-top: 8rpx;
}
.modal-actions {
  display: flex;
  gap: 16rpx;
  justify-content: center;
}
.btn-cancel {
  background: rgba(0,0,0,0.2) !important;
  color: var(--text-muted) !important;
  font-size: 24rpx !important;
  padding: 14rpx 32rpx !important;
  border-radius: 999rpx !important;
  border: none !important;
}
.btn-confirm {
  background: linear-gradient(135deg, var(--leaf-green), var(--leaf-light)) !important;
  color: #1B3A2D !important;
  font-size: 26rpx !important;
  font-weight: 700 !important;
  padding: 14rpx 40rpx !important;
  border-radius: 999rpx !important;
  border: none !important;
}

/* ===== 宠物陪伴事件系统（V6 Phase 6）===== */

/* 未读事件提示条 */
.unread-events-bar {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, rgba(255,193,7,0.15), rgba(255,152,0,0.1));
  border: 1rpx solid rgba(255,193,7,0.3);
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
}
.ue-icon { font-size: 32rpx; margin-right: 12rpx; }
.ue-text { flex: 1; font-size: 26rpx; color: #FFD54F; font-weight: 500; }
.ue-badge {
  min-width: 36rpx; height: 36rpx; line-height: 36rpx;
  text-align: center; background: #FF9800; color: #fff;
  border-radius: 18rpx; font-size: 20rpx; font-weight: 700;
  padding: 0 10rpx;
}

/* 事件详情弹窗 */
.event-detail-modal {
  width: 90vw;
  max-height: 70vh;
  background: linear-gradient(160deg, #1B3D32, #12261E);
  border: 2rpx solid rgba(255,213,79,0.3);
  border-radius: 24rpx;
  padding: 36rpx 28rpx;
  overflow-y: auto;
}
.event-type-badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-bottom: 16rpx;
}
.event-type-badge.letter { background: rgba(156,204,101,0.2); color: #AED581; }
.event-type-badge.title { background: rgba(255,213,79,0.2); color: #FFD54F; }
.event-type-badge.memory { background: rgba(100,181,246,0.2); color: #64B5F6; }
.event-type-badge.record { background: rgba(240,98,146,0.2); color: #F06292; }

.event-title {
  font-size: 34rpx; color: #FFF; font-weight: 700;
  margin-bottom: 24rpx; text-align: center;
}
.event-content { margin-bottom: 28rpx; }
.event-line {
  display: block; font-size: 27rpx; color: #E0E0E0;
  line-height: 1.8; white-space: pre-wrap;
}

/* ===== P7：完整档案弹窗 ===== */
.profile-overlay { align-items: flex-start; padding-top: 8vh; }
.profile-modal {
  background: linear-gradient(160deg, #1E3A2F, #152820);
  border: 3rpx solid rgba(218,165,32,0.4);
  border-radius: 28rpx;
  width: 88%;
  max-width: 620rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.5), 0 0 40rpx rgba(218,165,32,0.1);
}
.profile-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx 24rpx 20rpx;
  border-bottom: 2rpx solid rgba(218,165,32,0.2);
  flex-shrink: 0;
}
.profile-title-icon { font-size: 36rpx; }
.profile-title-text {
  font-size: 32rpx;
  font-weight: 900;
  color: #FFD54F;
  letter-spacing: 2rpx;
}
.profile-content {
  flex: 1;
  overflow-y: auto;
  padding: 8rpx 0;
}
.profile-section {
  background: rgba(0,0,0,0.15);
  border-radius: 16rpx;
  margin: 12rpx 20rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid rgba(255,255,255,0.05);
}
.profile-section-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 10rpx;
}
.ps-title-icon { font-size: 26rpx; }
.ps-title-text {
  font-size: 26rpx;
  font-weight: 800;
  color: #AED581;
  letter-spacing: 1rpx;
}
.ps-count {
  font-size: 20rpx;
  color: #888;
  margin-left: 8rpx;
}
.ps-arrow {
  font-size: 18rpx;
  color: #666;
  margin-left: auto;
}
.ps-divider {
  height: 1rpx;
  background: rgba(218,165,32,0.2);
  margin-bottom: 14rpx;
}
/* 信息行（label-value 左右布局）*/
.ps-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.03);
}
.ps-info-row:last-child { border-bottom: none; }
.ps-label {
  font-size: 24rpx;
  color: #90A4AE;
  font-weight: 500;
  min-width: 120rpx;
}
.ps-value {
  font-size: 26rpx;
  color: #F5E6C8;
  font-weight: 700;
  text-align: right;
  flex: 1;
  margin-left: 20rpx;
}
.ps-value-name {
  color: #FFD54F;
  font-size: 28rpx;
}
.ps-value-level {
  color: #FFAB40;
  font-size: 28rpx;
}
/* 四维属性进度条 */
.ps-attr-item {
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.03);
}
.ps-attr-item:last-child { border-bottom: none; }
.ps-attr-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
}
.ps-attr-icon {
  font-size: 24rpx;
  width: 36rpx;
  text-align: center;
}
.ps-attr-label {
  font-size: 24rpx;
  font-weight: 600;
  min-width: 60rpx;
}
.ps-attr-val {
  font-size: 24rpx;
  font-weight: 800;
  color: #F5E6C8;
  margin-left: auto;
}
.ps-attr-bar-track {
  height: 12rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 6rpx;
  overflow: hidden;
  margin-left: 44rpx;
}
.ps-attr-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.8s ease;
}
/* 性格设定 */
.ps-personality-box {
  background: rgba(255,213,79,0.05);
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
  border-left: 4rpx solid rgba(255,213,79,0.3);
}
.ps-personality-text {
  font-size: 24rpx;
  color: #CFD8DC;
  line-height: 1.6;
  font-style: italic;
}
/* BUFF标签 */
.ps-buff-tag {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 16rpx;
  background: rgba(255,179,0,0.08);
  border-radius: 12rpx;
  border: 1rpx solid rgba(255,179,0,0.2);
}
.ps-buff-label {
  font-size: 24rpx;
  font-weight: 800;
  color: #FFB300;
}
.ps-buff-desc {
  font-size: 22rpx;
  color: #90A4AE;
}
/* 关闭按钮 */
.profile-actions {
  text-align: center;
  padding: 20rpx 24rpx 28rpx;
  border-top: 2rpx solid rgba(218,165,32,0.15);
  flex-shrink: 0;
}
.profile-close-btn {
  padding: 14rpx 60rpx;
  font-size: 26rpx;
  font-weight: 700;
}
