<!-- AI 成长报告 - 动森森林风格 -->
<view class="page">
  <scroll-view scroll-y class="page-scroll" enhanced show-scrollbar="{{false}}">
    <view class="page-inner">

    <!-- 木纹标题栏 -->
    <view class="wood-title">
      <text class="title-icon">🌿</text>
      <text class="title-text">📋 AI 成长报告</text>
      <text class="title-icon">🌿</text>
    </view>

    <view class="week-label">
      <text class="week-text">{{loading ? '正在读取本周记录…' : loadError ? '周报读取失败' : weeklyReport.weekLabel}}</text>
      <button class="refresh-btn" bindtap="onRefresh" disabled="{{loading}}">{{loadError ? '重试' : '🔄 刷新'}}</button>
    </view>

    <block wx:if="{{!loading && !loadError && weeklyReport}}">
      <view class="weekly-stats-grid">
        <view class="stat-card wood-border-sm">
          <text class="sc-icon">✅</text>
          <text class="sc-num">{{weeklyReport.totalTasks ? weeklyReport.completedTasks + '/' + weeklyReport.totalTasks : '暂无任务'}}</text>
          <text class="sc-label">本周任务 · 截至今天</text>
          <view wx:if="{{weeklyReport.totalTasks}}" class="sc-bar-wrap">
            <view class="sc-bar-fill" style="width: {{weeklyReport.completionRate}}%"></view>
          </view>
        </view>
        <view class="stat-card wood-border-sm">
          <text class="sc-icon">⭐</text>
          <text class="sc-num">{{weeklyReport.xpEarned === null ? '暂无记录' : weeklyReport.xpEarned}}</text>
          <text class="sc-label">本周成长日志 XP</text>
        </view>
        <view class="stat-card wood-border-sm">
          <text class="sc-icon">🔥</text>
          <text class="sc-num">{{weeklyReport.streakDays === null ? '暂无记录' : weeklyReport.streakDays + ' 天'}}</text>
          <text class="sc-label">连续签到</text>
        </view>
        <view class="stat-card wood-border-sm">
          <text class="sc-icon">📖</text>
          <text class="sc-num">{{weeklyReport.topGoal ? weeklyReport.topGoal.title : '暂无记录'}}</text>
          <text class="sc-label">本周最勤目标</text>
          <text wx:if="{{weeklyReport.topGoal}}" class="sc-sub">{{weeklyReport.topGoal.count}} 次完成</text>
        </view>
      </view>

      <view class="card analysis-section">
        <view class="section-title-inline">🧠 成长分析</view>
        <text class="ai-text-sub">最佳时段和擅长领域暂缺可用依据。</text>
        <view class="suggestion-box quote-card">
          <view class="quote-bar"></view>
          <view class="quote-content">
            <text class="suggestion-label">💡 建议</text>
            <text class="suggestion-text">{{weeklyReport.totalTasks ? '回看本周任务，给下一次安排留一点余量。' : '等有任务记录后再回看本周进度。'}}</text>
          </view>
        </view>
      </view>

      <view class="card emotion-trend-card">
        <view class="section-title-inline">🌸 本周心情记录</view>
        <view class="trend-chart">
          <view wx:for="{{weeklyReport.moods}}" wx:key="date" class="trend-col">
            <text class="trend-day">{{item.day}}</text>
            <text class="trend-score">{{item.label}}</text>
          </view>
        </view>
      </view>
    </block>

    </view>
  </scroll-view>
</view>
