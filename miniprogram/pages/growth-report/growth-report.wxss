/* ========== AI 成长报告 - 动森森林主题样式 ========== */

/* 页面容器 */
.page-container {
  min-height: 100vh;
  background: #2D4A3E;
  padding: 30rpx 24rpx;
  box-sizing: border-box;
}

/* ---------- 木纹标题栏 ---------- */
.wood-title {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background: linear-gradient(135deg, #8B6914, #B8860B);
  border-radius: 50rpx;
  margin-bottom: 24rpx;
  gap: 16rpx;
}
.title-icon {
  font-size: 28rpx;
}
.title-text {
  color: #F5E6C8;
  font-size: 34rpx;
  font-weight: bold;
}

/* ---------- 周期标签 ---------- */
.week-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.week-text {
  font-size: 26rpx;
  color: #C4B89A;
}
.refresh-btn {
  padding: 8rpx 24rpx !important;
  font-size: 24rpx !important;
  background: rgba(124,179,66,0.2) !important;
  color: #AED581 !important;
  border-radius: 30rpx !important;
  border: none !important;
  line-height: 1.6 !important;
  height: auto !important;
}

/* ---------- 周报统计网格 ---------- */
.weekly-stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 26rpx;
}
.stat-card {
  background: rgba(61,98,84,0.6);
  border: 2rpx solid #8B6914;
  border-radius: 22rpx;
  padding: 20rpx 16rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.sc-icon {
  font-size: 32rpx;
}
.sc-num {
  font-size: 28rpx;
  color: #F5E6C8;
  font-weight: bold;
}
.sc-label {
  font-size: 22rpx;
  color: #C4B89A;
}
.sc-sub {
  font-size: 20rpx;
  color: #8B9A7D;
}
.sc-bar-wrap {
  width: 100%;
  height: 10rpx;
  background: rgba(45,74,62,0.5);
  border-radius: 5rpx;
  overflow: hidden;
  margin-top: 4rpx;
}
.sc-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #7CB342, #AED581);
  border-radius: 5rpx;
  transition: width 0.3s;
}

/* ---------- 虚线边框卡片 ---------- */
.card {
  background: rgba(61,98,84,0.6);
  border: 2rpx dashed rgba(165,190,140,0.4);
  border-radius: 28rpx;
  padding: 26rpx;
  margin-bottom: 26rpx;
}

/* ---------- 区块内联标题 ---------- */
.section-title-inline {
  font-size: 28rpx;
  color: #F5E6C8;
  font-weight: bold;
  margin-bottom: 18rpx;
}
.section-title {
  font-size: 28rpx;
  color: #F5E6C8;
  margin: 30rpx 0 16rpx;
  padding-left: 10rpx;
}

/* ---------- 分析列表 ---------- */
.analysis-list {
  margin-bottom: 20rpx;
}
.analysis-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed rgba(165,190,140,0.15);
}
.analysis-item:last-child {
  border-bottom: none;
}
.ai-icon {
  font-size: 32rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}
.ai-text-wrap {
  flex: 1;
}
.ai-text-main {
  display: block;
  font-size: 26rpx;
  color: #F5E6C8;
  font-weight: bold;
  margin-bottom: 4rpx;
}
.ai-text-sub {
  display: block;
  font-size: 23rpx;
  color: #C4B89A;
}

/* ---------- 引用悬浮卡 ---------- */
.quote-card {
  position: relative;
  background: rgba(74,115,97,0.5);
  border-radius: 20rpx;
  padding: 20rpx 20rpx 20rpx 28rpx;
  overflow: hidden;
}
.quote-bar {
  position: absolute;
  left: 0;
  top: 16rpx;
  bottom: 16rpx;
  width: 6rpx;
  background: #7CB342;
  border-radius: 0 4rpx 4rpx 0;
}
.quote-content {
  position: relative;
  z-index: 1;
}
.suggestion-label {
  display: block;
  font-size: 24rpx;
  color: #AED581;
  font-weight: bold;
  margin-bottom: 8rpx;
}
.suggestion-text {
  display: block;
  font-size: 25rpx;
  color: #E8D9BB;
  line-height: 1.6;
}

/* ---------- 情绪趋势图 ---------- */
.trend-chart {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 240rpx;
  padding-top: 10rpx;
}
.trend-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.trend-bar-wrap {
  width: 40rpx;
  height: 180rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.trend-bar {
  width: 36rpx;
  border-radius: 8rpx 8rpx 0 0;
  transition: height 0.3s;
}
.bar-high { background: linear-gradient(180deg, #7CB342, #AED581); }
.bar-mid { background: linear-gradient(180deg, #DAA520, #FFAB40); }
.bar-low { background: linear-gradient(180deg, #FF6B6B, #FFAB40); }
.trend-day {
  font-size: 20rpx;
  color: #8B9A7D;
}
.trend-score {
  font-size: 20rpx;
  color: #C4B89A;
  font-weight: bold;
}
