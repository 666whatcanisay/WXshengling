/* ========== 管理员控制台 - AI自律森林风格 v2 ========== */

/* ===== 基础布局 ===== */
.page { height: 100vh; background: #1a2e1f; }
.admin-scroll { height: 100vh; }
.admin-inner {
  padding: 24rpx; padding-bottom: 120rpx; min-height: 100vh;
}

/* ===== 无权限 ===== */
.no-permission {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; padding-top: 200rpx;
}
.no-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.no-title { font-size: 36rpx; color: #c9a227; font-weight: bold; margin-bottom: 12rpx; }
.no-desc { font-size: 26rpx; color: #7a9182; margin-bottom: 40rpx; }
.btn-back {
  background: linear-gradient(135deg, #4a7c59, #3d6b4f); color: #fff;
  border-radius: 40rpx; padding: 16rpx 60rpx; font-size: 28rpx;
}
.btn-back::after { border: none; }

/* ===== 加载中 ===== */
.loading-wrap {
  display: flex; align-items: center; justify-content: center; padding-top: 300rpx;
}
.loading-text { color: #8ba89a; font-size: 28rpx; }

/* ===== 顶部标题栏 ===== */
.admin-header {
  text-align: center; margin-bottom: 32rpx; padding: 24rpx 0;
  background: linear-gradient(180deg, rgba(139,105,20,0.15) 0%, transparent 100%);
  border-radius: 20rpx;
}
.header-top { display: flex; align-items: center; justify-content: center; gap: 16rpx; }
.admin-title {
  font-size: 38rpx; font-weight: bold; color: #d4af37;
  text-shadow: 0 2rpx 8rpx rgba(212,175,55,0.3);
}
.header-badge {
  background: rgba(212,175,55,0.2); color: #d4af37;
  font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 20rpx;
}
.admin-subtitle {
  display: block; font-size: 23rpx; color: #7a9182; margin-top: 10rpx;
}

/* ===== 统计卡片（6格）===== */
.stats-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; margin-bottom: 20rpx;
}
.stat-card {
  background: linear-gradient(145deg, #243829, #1e3024);
  border-radius: 20rpx; padding: 24rpx 12rpx;
  display: flex; flex-direction: column; align-items: center;
  border: 1rpx solid rgba(255,255,255,0.05);
}
.stat-icon { font-size: 36rpx; margin-bottom: 8rpx; }
.stat-num {
  font-size: 42rpx; font-weight: bold; color: #e8d5a3;
  line-height: 1.2;
}
.stat-label { font-size: 21rpx; color: #7a9182; margin-top: 6rpx; }

.stat-users { border-left: 4rpx solid #5dade2; }
.stat-goals { border-left: 4rpx solid #f5b041; }
.stat-pets { border-left: 4rpx solid #58d68d; }
.stat-feedbacks { border-left: 4rpx solid #af7ac5; }
.stat-signins { border-left: 4rpx solid #58d68d; }
.stat-tasks { border-left: 4rpx solid #f1948a; }

/* 平台总XP */
.platform-xp-bar {
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(90deg, rgba(212,175,55,0.08), rgba(212,175,55,0.2), rgba(212,175,55,0.08));
  border-radius: 12rpx; padding: 16rpx 24rpx; margin-bottom: 28rpx;
}
.xp-label { font-size: 25rpx; color: #a89050; }
.xp-value { font-size: 32rpx; font-weight: bold; color: #d4af37; margin-left: 12rpx; }

/* ===== Tab 切换栏 ===== */
.section-tabs {
  display: flex; gap: 8rpx; margin-bottom: 24rpx;
  overflow-x: auto; white-space: nowrap; -webkit-overflow-scrolling: touch;
}
.tab-item {
  flex-shrink: 0; padding: 16rpx 24rpx; border-radius: 30rpx;
  font-size: 24rpx; color: #7a9182; background: #1e3024;
  border: 1rpx solid rgba(255,255,255,0.06); transition: all 0.2s;
}
.tab-active {
  background: linear-gradient(135deg, #8b6914, #a0781a); color: #fff;
  border-color: transparent; font-weight: bold; box-shadow: 0 4rpx 16rpx rgba(139,105,20,0.3);
}

/* ===== Tab 内容区通用 ===== */
.tab-content { animation: fadeInUp 0.3s ease; }
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===== 区块标题 ===== */
.section-title-row {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 16rpx;
}
.section-title { font-size: 28rpx; font-weight: bold; color: #c9a227; }
.section-count { font-size: 23rpx; color: #7a9182; }

/* ===== 快捷操作入口 ===== */
.quick-actions {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx;
  margin-top: 32rpx;
}
.quick-btn {
  display: flex; flex-direction: column; align-items: center; gap: 8rpx;
  background: #1e3024; border-radius: 16rpx; padding: 24rpx 12rpx;
  border: 1rpx solid rgba(255,255,255,0.05); font-size: 23rpx; color: #a8bfaa;
}
.quick-icon { font-size: 36rpx; }

/* ===== 最近用户（迷你列表）===== */
.mini-user-list { display: flex; flex-direction: column; gap: 12rpx; }
.mini-user-item {
  display: flex; align-items: center; gap: 16rpx;
  background: #1e3024; border-radius: 14rpx; padding: 16rpx 20rpx;
  border: 1rpx solid rgba(255,255,255,0.04);
}
.mini-avatar {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: #2d4a37; flex-shrink: 0;
}
.mini-avatar-letter {
  width: 64rpx; height: 64rpx; line-height: 64rpx; text-align: center;
  border-radius: 50%; background: linear-gradient(135deg, #3d6b4f, #2d4a37);
  color: #d4af37; font-size: 28rpx; font-weight: bold; flex-shrink: 0;
}
.mini-info { flex: 1; min-width: 0; }
.mini-name { font-size: 27rpx; color: #e8e0d0; font-weight: 500; display: block; }
.mini-meta { font-size: 21rpx; color: #7a9182; display: block; margin-top: 4rpx; }

/* ===== 角色标签 ===== */
.role-tag {
  padding: 4rpx 14rpx; border-radius: 8rpx; font-size: 20rpx; flex-shrink: 0;
}
.role-admin { background: rgba(212,175,55,0.2); color: #d4af37; }
.role-user { background: rgba(93,173,226,0.15); color: #5dade2; }

.status-tag {
  padding: 4rpx 14rpx; border-radius: 8rpx; font-size: 20rpx; flex-shrink: 0;
}
.status-banned { background: rgba(192,57,43,0.2); color: #e74c3c; }

/* ===== 用户管理 - 搜索筛选 ===== */
.filter-bar {
  display: flex; gap: 12rpx; margin-bottom: 16rpx;
}
.search-input {
  flex: 1; height: 72rpx; background: #1e3024; border-radius: 14rpx;
  padding: 0 24rpx; font-size: 26rpx; color: #e8e0d0;
  border: 1rpx solid rgba(255,255,255,0.06);
}
.role-filter-btn {
  height: 72rpx; line-height: 72rpx; padding: 0 20rpx;
  background: #1e3024; border-radius: 14rpx;
  font-size: 24rpx; color: #a8bfaa; white-space: nowrap;
  border: 1rpx solid rgba(255,255,255,0.06);
}

.list-info-bar {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 16rpx; padding: 0 4rpx;
}
.list-info { font-size: 23rpx; color: #7a9182; }
.page-nav { display: flex; align-items: center; gap: 12rpx; }
.page-btn {
  width: 48rpx; height: 48rpx; line-height: 48rpx; text-align: center;
  background: #1e3024; border-radius: 10rpx; font-size: 24rpx; color: #a8bfaa;
}
.page-btn.disabled { color: #4a5a50; opacity: 0.4; }
.page-info { font-size: 23rpx; color: #7a9182; }

/* ===== 用户卡片列表 ===== */
.user-list { display: flex; flex-direction: column; gap: 16rpx; }
.user-card {
  display: flex; align-items: center; gap: 16rpx;
  background: #1e3024; border-radius: 18rpx; padding: 20rpx;
  border: 1rpx solid rgba(255,255,255,0.04);
  transition: border-color 0.2s;
}
.user-card:active { border-color: rgba(212,175,55,0.2); }
.card-banned { opacity: 0.6; border-color: rgba(231,76,60,0.2) !important; }

.user-avatar-wrap { flex-shrink: 0; position: relative; }
.user-avatar-img {
  width: 88rpx; height: 88rpx; border-radius: 50%; background: #2d4a37;
}
.user-avatar-letter {
  width: 88rpx; height: 88rpx; line-height: 88rpx; text-align: center;
  border-radius: 50%; background: linear-gradient(135deg, #3d6b4f, #2d4a37);
  color: #d4af37; font-size: 34rpx; font-weight: bold;
}
.user-info { flex: 1; min-width: 0; }
.user-name-row { display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; }
.user-nickname { font-size: 28rpx; color: #e8e0d0; font-weight: 600; }
.user-meta {
  font-size: 22rpx; color: #7a9182; display: block; margin-top: 6rpx;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.user-time { font-size: 20rpx; color: #5a6d5f; display: block; margin-top: 4rpx; }

/* 操作按钮组 */
.user-actions { display: flex; flex-direction: column; gap: 8rpx; flex-shrink: 0; }
.action-btn {
  padding: 8rpx 18rpx; border-radius: 8rpx; font-size: 21rpx;
  text-align: center; white-space: nowrap;
}
.action-btn::after { border: none; }
.btn-role.btn-promote { background: rgba(212,175,55,0.15); color: #d4af37; }
.btn-role.btn-demote { background: rgba(149,165,166,0.15); color: #95a5a6; }
.btn-status.btn-ban { background: rgba(231,76,60,0.15); color: #e74c3c; }
.btn-status.btn-unban { background: rgba(46,204,113,0.15); color: #2ecc71; }
.btn-pwd { background: rgba(230,126,34,0.15); color: #e67e22; }
.btn-delete { background: rgba(192,57,43,0.2); color: #c0392b; border: 1rpx solid rgba(192,57,43,0.3); }

/* ===== 宠物管理 ===== */
.pet-list { display: flex; flex-direction: column; gap: 14rpx; }
.pet-card {
  display: flex; align-items: center; gap: 16rpx;
  background: #1e3024; border-radius: 16rpx; padding: 20rpx;
  border: 1rpx solid rgba(255,255,255,0.04);
}
.pet-emoji-wrap { flex-shrink: 0; text-align: center; width: 80rpx; }
.pet-emoji { font-size: 48rpx; display: block; }
.pet-lv { font-size: 18rpx; color: #d4af37; display: block; margin-top: 2rpx; }
.pet-info { flex: 1; min-width: 0; }
.pet-name { font-size: 28rpx; color: #e8e0d0; font-weight: 600; display: block; }
.pet-owner { font-size: 22rpx; color: #7a9182; display: block; margin-top: 4rpx; }
.pet-tags { display: flex; gap: 8rpx; margin-top: 8rpx; }
.stage-tag, .status-tag {
  padding: 4rpx 12rpx; border-radius: 8rpx; font-size: 20rpx;
}
.stage-baby   { background: rgba(189,195,199,0.2); color: #bdc3c7; }
.stage-child  { background: rgba(46,204,113,0.15); color: #2ecc71; }
.stage-teen   { background: rgba(52,152,219,0.15); color: #3498db; }
.stage-adult  { background: rgba(155,89,182,0.15); color: #9b59b6; }
.stage-elder  { background: rgba(212,175,55,0.2); color: #d4af37; }
.status-happy    { background: rgba(46,204,113,0.15); color: #2ecc71; }
.status-normal   { background: rgba(149,165,166,0.15); color: #95a5a6; }
.status-sad      { background: rgba(52,152,219,0.15); color: #3498db; }
.status-sleeping { background: rgba(142,68,173,0.15); color: #bb8fce; }
.status-sick     { background: rgba(231,76,60,0.15); color: #e74c3c; }
.pet-exp { font-size: 20rpx; color: #7a9182; display: block; margin-top: 6rpx; }
.pet-edit-btn {
  padding: 10rpx 22rpx; background: rgba(212,175,55,0.12);
  border-radius: 10rpx; font-size: 23rpx; color: #d4af37; flex-shrink: 0;
}
.pet-edit-btn::after { border: none; }

/* ===== 反馈审核 ===== */
.fb-filter {
  display: flex; gap: 12rpx; margin-bottom: 20rpx; overflow-x: auto; white-space: nowrap;
}
.fb-filter-chip {
  flex-shrink: 0; padding: 12rpx 24rpx; border-radius: 24rpx;
  font-size: 24rpx; color: #7a9182; background: #1e3024;
  border: 1rpx solid rgba(255,255,255,0.06);
}
.chip-active {
  background: linear-gradient(135deg, #8b6914, #a0781a); color: #fff; border-color: transparent;
}

.feedback-list { display: flex; flex-direction: column; gap: 16rpx; }
.feedback-card {
  background: #1e3024; border-radius: 16rpx; padding: 24rpx;
  border: 1rpx solid rgba(255,255,255,0.04);
}
.feedback-card.fb-resolved { opacity: 0.65; border-color: rgba(46,204,113,0.15); }

.fb-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; flex-wrap: wrap; }
.fb-type-badge {
  padding: 4rpx 14rpx; border-radius: 8rpx; font-size: 20rpx; flex-shrink: 0;
}
.fb-suggestion { background: rgba(52,152,219,0.15); color: #3498db; }
.fb-bug { background: rgba(231,76,60,0.15); color: #e74c3c; }
.fb-other { background: rgba(149,165,166,0.15); color: #95a5a6; }
.fb-resolved-tag {
  background: rgba(46,204,113,0.15); color: #2ecc71;
  padding: 4rpx 14rpx; border-radius: 8rpx; font-size: 20rpx;
}
.fb-time { font-size: 20rpx; color: #5a6d5f; margin-left: auto; }
.fb-title { font-size: 28rpx; color: #e8e0d0; font-weight: 600; display: block; margin-bottom: 8rpx; }
.fb-desc { font-size: 24rpx; color: #a8bfaa; display: block; line-height: 1.5; margin-bottom: 8rpx; }
.fb-contact { font-size: 22rpx; color: #7a9182; margin-bottom: 12rpx; }
.fb-reply {
  background: rgba(46,204,113,0.08); border-radius: 10rpx; padding: 12rpx 16rpx; margin-bottom: 12rpx;
}
.reply-label { font-size: 22rpx; color: #2ecc71; font-weight: 600; }
.reply-text { font-size: 24rpx; color: #a8bfaa; }

.fb-actions { display: flex; gap: 12rpx; margin-top: 12rpx; }
.fb-action-btn {
  padding: 10rpx 24rpx; border-radius: 10rpx; font-size: 23rpx;
}
.fb-action-btn::after { border: none; }
.fb-resolve { background: rgba(46,204,113,0.15); color: #2ecc71; }
.fb-delete { background: rgba(231,76,60,0.12); color: #e74c3c; }

/* ===== 系统工具 ===== */
.tool-section {
  background: #1e3024; border-radius: 18rpx; padding: 28rpx;
  border: 1rpx solid rgba(255,255,255,0.04); margin-bottom: 24rpx;
}
.tool-section.danger-zone {
  border-color: rgba(231,76,60,0.15); background: rgba(231,76,60,0.04);
}
.tool-title { font-size: 30rpx; font-weight: bold; color: #c9a227; display: block; margin-bottom: 20rpx; }
.danger-title { color: #e74c3c !important; }
.danger-desc { font-size: 23rpx; color: #a85454; display: block; margin-bottom: 20rpx; }

.tool-input {
  height: 76rpx; background: #162820; border-radius: 12rpx;
  padding: 0 24rpx; font-size: 27rpx; color: #e8e0d0;
  border: 1rpx solid rgba(255,255,255,0.06); margin-bottom: 16rpx;
}
.tool-textarea {
  width: 100%; min-height: 160rpx; background: #162820; border-radius: 12rpx;
  padding: 20rpx 24rpx; font-size: 26rpx; color: #e8e0d0;
  border: 1rpx solid rgba(255,255,255,0.06); box-sizing: border-box; margin-bottom: 20rpx;
}
.tool-btn-row { display: flex; gap: 16rpx; }
.tool-submit-btn {
  flex: 1; height: 76rpx; line-height: 76rpx; text-align: center;
  background: linear-gradient(135deg, #8b6914, #a0781a); color: #fff;
  border-radius: 14rpx; font-size: 28rpx; font-weight: bold;
  border: none;
}
.tool-submit-btn::after { border: none; }
.tool-refresh-btn {
  background: #2d4a37; color: #8ba89a; border-radius: 10rpx; font-size: 24rpx;
  border: 1rpx solid rgba(255,255,255,0.06);
}
.tool-refresh-btn::after { border: none; }

/* 数据快照 */
.snapshot-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
.snap-item {
  background: #162820; border-radius: 12rpx; padding: 16rpx 12rpx; text-align: center;
}
.snap-item.snap-full { grid-column: span 3; }
.snap-label { font-size: 21rpx; color: #7a9182; display: block; margin-bottom: 6rpx; }
.snap-val { font-size: 32rpx; font-weight: bold; color: #d4af37; }

.danger-btn {
  width: 100%; height: 72rpx; line-height: 72rpx; text-align: center;
  background: transparent; color: #e74c3c; border: 1rpx solid rgba(231,76,60,0.3);
  border-radius: 14rpx; font-size: 27rpx;
}
.danger-btn::after { border: none; }

/* ===== 清理操作 ===== */
.danger-item {
  background: rgba(231,76,60,0.06); border-radius: 14rpx;
  padding: 24rpx; margin-bottom: 20rpx;
  border: 1rpx solid rgba(231,76,60,0.12);
}
.danger-item-title { font-size: 28rpx; color: #e74c3c; font-weight: bold; display: block; margin-bottom: 8rpx; }
.danger-item-desc { font-size: 23rpx; color: #a85454; display: block; margin-bottom: 16rpx; line-height: 1.5; }
.cleanup-btn {
  background: linear-gradient(135deg, #c0392b, #a93226) !important;
  color: #fff !important; font-weight: bold;
}
.cleanup-result {
  display: block; margin-top: 16rpx; padding: 16rpx; background: rgba(46,204,113,0.08);
  border-radius: 10rpx; font-size: 22rpx; color: #7cb87c; line-height: 1.8;
  white-space: pre-wrap; word-break: break-all;
}

/* ===== 弹窗 ===== */
.modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.65); z-index: 999;
  display: flex; align-items: center; justify-content: center;
}
.modal-content {
  width: 88%; max-height: 80vh; background: #1e3024;
  border-radius: 24rpx; overflow: hidden;
  border: 1rpx solid rgba(212,175,55,0.2);
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.5);
}
.modal-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 28rpx 20rpx;
  background: linear-gradient(180deg, rgba(139,105,20,0.12), transparent);
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
}
.modal-title { font-size: 32rpx; font-weight: bold; color: #d4af37; }
.modal-close {
  width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center;
  font-size: 28rpx; color: #7a9182; border-radius: 50%;
  background: rgba(255,255,255,0.05);
}
.modal-body { padding: 24rpx 28rpx; max-height: 60vh; }
.modal-loading { text-align: center; padding: 80rpx 0; color: #7a9182; }

/* 详情弹窗内容 */
.detail-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 14rpx 0; border-bottom: 1rpx solid rgba(255,255,255,0.03);
}
.detail-row:last-child { border-bottom: none; }
.dl-label { font-size: 25rpx; color: #7a9182; }
.dl-value { font-size: 26rpx; color: #e8e0d0; font-weight: 500; }
.role-txt.admin { color: #d4af37 !important; }
.role-txt.user { color: #5dade2 !important; }
.status-txt.active { color: #2ecc71 !important; }
.status-txt.banned { color: #e74c3c !important; }

.detail-divider {
  height: 1rpx; background: rgba(255,255,255,0.06); margin: 20rpx 0;
}
.detail-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12rpx; }
.ds-item {
  background: #162820; border-radius: 10rpx; padding: 14rpx 16rpx;
  font-size: 24rpx; color: #a8bfaa; text-align: center;
}
.recent-logs { margin-top: 20rpx; }
.rl-title { font-size: 25rpx; color: #c9a227; font-weight: 600; display: block; margin-bottom: 12rpx; }
.rl-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 10rpx 0; border-bottom: 1rpx solid rgba(255,255,255,0.02);
}
.rl-reason { font-size: 23rpx; color: #a8bfaa; flex: 1; }
.rl-xp { font-size: 23rpx; color: #58d68d; font-weight: 600; }

/* 宠物编辑弹窗 */
.pet-modal .modal-body { max-height: 70vh; }
.edit-field { margin-bottom: 20rpx; }
.edit-label { font-size: 25rpx; color: #a8bfaa; display: block; margin-bottom: 10rpx; }
.edit-picker {
  height: 76rpx; line-height: 76rpx; background: #162820;
  border-radius: 12rpx; padding: 0 24rpx; font-size: 27rpx; color: #e8e0d0;
  border: 1rpx solid rgba(255,255,255,0.06);
}
.edit-input-num {
  height: 76rpx; background: #162820; border-radius: 12rpx;
  padding: 0 24rpx; font-size: 28rpx; color: #e8e0d0;
  border: 1rpx solid rgba(255,255,255,0.06);
}

/* ===== 空状态 ===== */
.empty-state {
  text-align: center; padding: 80rpx 0;
}
.empty-icon { font-size: 64rpx; display: block; margin-bottom: 16rpx; }
.empty-text { font-size: 26rpx; color: #5a6d5f; }
