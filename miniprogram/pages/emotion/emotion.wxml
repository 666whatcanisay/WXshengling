<!-- 情绪花园 - 动森森林风格 -->
<view class="page">
  <scroll-view scroll-y class="page-scroll" enhanced show-scrollbar="{{false}}">
    <view class="page-inner">

    <!-- 木纹标题栏 -->
    <view class="wood-title">
      <text class="title-icon">🌸</text>
      <text class="title-text">情绪花园</text>
      <text class="title-icon">🌸</text>
    </view>

  <!-- 快捷情绪记录区 -->
  <view class="card mood-record-card">
    <view class="section-title-inline">🌺 今日心情</view>
    <view class="mood-grid">
      <view
        wx:for="{{moodOptions}}"
        wx:key="label"
        class="mood-item {{selectedMood === index ? 'mood-selected' : ''}}"
        bindtap="recordMood"
        data-index="{{index}}"
      >
        <text class="mood-emoji">{{item.emoji}}</text>
        <text class="mood-label">{{item.label}}</text>
      </view>
    </view>

    <!-- 备注输入 -->
    <view class="note-input-wrap">
      <input
        class="note-input"
        placeholder="📝 写下此刻的想法..."
        placeholder-class="note-placeholder"
        value="{{note}}"
        bindinput="onNoteInput"
      />
    </view>

    <!-- 提交按钮 -->
    <button class="btn-leaf submit-mood-btn" bindtap="submitEmotion">✨ 记录心情</button>
  </view>

  <!-- 情绪日历热力图 -->
  <view class="card calendar-card">
    <view class="section-title-inline">📅 情绪日历（近28天）</view>
    <view class="calendar-grid">
      <view
        wx:for="{{emotionCalendar}}"
        wx:key="date"
        class="cal-cell mood-{{item.mood}}"
        title="{{item.date}} | {{item.mood}}"
      >
        <text class="cell-date">{{item.date.slice(5)}}</text>
      </view>
    </view>
    <!-- 图例 -->
    <view class="cal-legend">
      <view class="legend-row">
        <view class="legend-dot dot-happy"></view><text class="legend-text">开心</text>
        <view class="legend-dot dot-neutral"></view><text class="legend-text">平静</text>
        <view class="legend-dot dot-sad"></view><text class="legend-text">低落</text>
      </view>
    </view>
  </view>

  <!-- AI 情绪分析卡片 -->
  <view class="quote-card ai-analysis-card">
    <view class="quote-bar"></view>
    <view class="quote-content">
      <view class="analysis-header">
        <text class="analysis-icon">🤖</text>
        <text class="analysis-title">AI 情绪分析 · {{emotionAnalysis.period}}</text>
      </view>
      <view class="analysis-stats">
        <view class="analysis-stat">
          <text class="stat-emoji">😊</text>
          <text class="stat-num">{{emotionAnalysis.happyCount}}</text>
          <text class="stat-label-sm">天开心</text>
        </view>
        <view class="analysis-stat">
          <text class="stat-emoji">😐</text>
          <text class="stat-num">{{emotionAnalysis.neutralCount}}</text>
          <text class="stat-label-sm">天平静</text>
        </view>
        <view class="analysis-stat">
          <text class="stat-emoji">😔</text>
          <text class="stat-num">{{emotionAnalysis.sadCount}}</text>
          <text class="stat-label-sm">天低落</text>
        </view>
      </view>
      <view class="dominant-mood">
        <text class="dominant-label">主导情绪：</text>
        <text class="dominant-value {{emotionAnalysis.trend === 'up' ? 'trend-up' : ''}}">
          {{emotionAnalysis.dominant}}
          <text wx:if="{{emotionAnalysis.trend === 'up'}}"> 📈</text>
        </text>
      </view>
      <text class="analysis-tip">{{emotionAnalysis.suggestion}}</text>
    </view>
  </view>

  <!-- 宠物情绪联动卡片 -->
  <view class="pet-link-card card-solid">
    <view class="pet-link-header">
      <text class="pet-link-icon">🐾</text>
      <text class="pet-link-title">宠物联动</text>
    </view>
    <view class="pet-link-body">
      <view class="pet-avatar-area">
        <text class="pet-avatar-text">{{petEmotionLink.petName}}</text>
        <text class="pet-mood-face">{{petEmotionLink.currentMood === 'happy' ? '😸' : '😿'}}</text>
      </view>
      <text class="pet-msg">{{petEmotionLink.message}}</text>
      <view class="mood-effect-tag">
        <text class="effect-icon">✨</text>
        <text class="effect-text">{{petEmotionLink.moodEffect}}</text>
      </view>
    </view>
  </view>

    </view>
  </scroll-view>
</view>
