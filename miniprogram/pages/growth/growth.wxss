/* ========== 成长足迹 - 动森森林主题样式 ========== */

/* 页面容器 */
.page-container {
  min-height: 100vh;
  background: #2D4A3E;
  padding: 30rpx 24rpx;
  box-sizing: border-box;
}

/* ---------- 木纹标题栏 ---------- */
.wood-title {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background: linear-gradient(135deg, #8B6914, #B8860B);
  border-radius: 50rpx;
  margin-bottom: 30rpx;
  gap: 16rpx;
}
.title-icon {
  font-size: 28rpx;
}
.title-text {
  color: #F5E6C8;
  font-size: 34rpx;
  font-weight: bold;
}

/* ---------- 实边卡片 ---------- */
.card-solid {
  background: rgba(61,98,84,0.7);
  border: 3rpx solid #8B6914;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 26rpx;
}
.card {
  background: rgba(61,98,84,0.6);
  border: 2rpx dashed rgba(165,190,140,0.4);
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 26rpx;
}

/* ---------- 统计概览行 ---------- */
.overview-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.overview-item {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.overview-icon {
  font-size: 32rpx;
}
.overview-num {
  font-size: 38rpx;
  color: #F5E6C8;
  font-weight: bold;
}
.overview-label {
  font-size: 22rpx;
  color: #C4B89A;
}
.overview-divider {
  width: 2rpx;
  height: 56rpx;
  background: rgba(165,190,140,0.3);
}

/* ---------- 区块内联标题 ---------- */
.section-title-inline {
  font-size: 28rpx;
  color: #F5E6C8;
  font-weight: bold;
  margin-bottom: 18rpx;
}
.section-title {
  font-size: 28rpx;
  color: #F5E6C8;
  margin: 30rpx 0 16rpx;
  padding-left: 10rpx;
}

/* ---------- 热力图 ---------- */
.heatmap-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-bottom: 16rpx;
}
.heat-cell {
  aspect-ratio: 1;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.heat-text {
  font-size: 18rpx;
  color: rgba(245,230,200,0.5);
}
/* 5级绿色深浅 */
.heat-1 { background: rgba(124,179,66,0.15); }
.heat-2 { background: rgba(124,179,66,0.35); }
.heat-3 { background: rgba(124,179,66,0.55); }
.heat-4 { background: rgba(124,179,66,0.75); }
.heat-5 { background: rgba(124,179,66,0.95); }

/* 热力图图例 */
.heatmap-legend {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed rgba(165,190,140,0.2);
}
.legend-sm {
  font-size: 20rpx;
  color: #8B9A7D;
}
.legend-boxes {
  display: flex;
  gap: 6rpx;
}
.l-box {
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
}
.l-1 { background: rgba(124,179,66,0.2); }
.l-2 { background: rgba(124,179,66,0.4); }
.l-3 { background: rgba(124,179,66,0.6); }
.l-4 { background: rgba(124,179,66,0.8); }
.l-5 { background: #7CB342; }

/* ---------- 筛选标签 ---------- */
.filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.f-chip {
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #C4B89A;
  background: rgba(74,115,97,0.35);
  border: 2rpx solid transparent;
}
.f-active {
  background: linear-gradient(135deg, #8B6914, #B8860B);
  color: #F5E6C8;
  border-color: #DAA520;
  font-weight: bold;
}

/* ---------- 时间线 ---------- */
.timeline-wrap {
  position: relative;
  padding-left: 40rpx;
}
.timeline-item {
  position: relative;
  padding-bottom: 32rpx;
}

/* 圆点 */
.tl-dot {
  position: absolute;
  left: -32rpx;
  top: 20rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 3rpx solid #F5E6C8;
}
.dot-xp { background: #DAA520; }
.dot-level_up { background: #FFAB40; }
.dot-pet_stage { background: #7CB342; }
.dot-achievement { background: #FFD700; }

/* 连线 */
.tl-line {
  position: absolute;
  left: -23rpx;
  top: 44rpx;
  width: 2rpx;
  bottom: -16rpx;
  background: rgba(165,190,140,0.3);
}

/* 内容卡片 */
.tl-card {
  padding: 20rpx;
  margin-left: 8rpx;
}
.tl-header {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 10rpx;
}
.tl-type-icon {
  font-size: 28rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}
.tl-content {
  font-size: 26rpx;
  color: #F5E6C8;
  line-height: 1.5;
  flex: 1;
}
.tl-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.tl-date {
  font-size: 22rpx;
  color: #8B9A7D;
}
.tl-xp {
  font-size: 22rpx;
  color: #DAA520;
  font-weight: bold;
}

/* ---------- 空状态 ---------- */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}
.empty-icon {
  font-size: 72rpx;
  opacity: 0.4;
  margin-bottom: 16rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #8B9A7D;
}
