/* ===== Goals 页面 - 动森森林治愈风格 ===== */

/* 页面根容器 */
.page { min-height: 100vh; background: radial-gradient(ellipse at center top, #355447 0%, #2D4A3E 70%); }
/* 滚动容器 */
.page-scroll { height: 100vh; }
/* 内容区内边距 */
.page-inner { max-width: 720rpx; margin: 0 auto; padding: 20rpx 24rpx 150rpx; box-sizing: border-box; }

/* ===== 头部区域：标题栏 + 新建按钮 ===== */
.header-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; gap: 16rpx; }

/* 内联木纹标题 */
.wood-title-inline { margin: 0; flex: 1; padding: 14rpx 28rpx; }

/* 新建目标按钮 */
.btn-add-goal { flex-shrink: 0; width: auto; height: 68rpx; padding: 0 28rpx; font-size: 26rpx; white-space: nowrap; }
.btn-add-goal::after { border: none; }

/* ===== 空状态 ===== */
.empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 120rpx 0; }
.empty-icon { font-size: 96rpx; margin-bottom: 20rpx; opacity: 0.7; }
.empty-text { font-size: 28rpx; color: #8B9A7D; }

/* ===== 实边卡片（复用动森主题） ===== */
.card-solid { background: linear-gradient(135deg, #3D6254, #4A7361); border: 3rpx solid #B8860B; border-radius: 28rpx; padding: 28rpx; margin-bottom: 20rpx; box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.25); position: relative; overflow: hidden; transition: transform 0.2s ease; }
.card-solid:active { transform: scale(0.98); }

/* 左侧深棕色装饰条 — 渐变木纹 */
.card-wood-stripe { position: absolute; left: 0; top: 0; bottom: 0; width: 8rpx; background: linear-gradient(180deg, #DAA520, #8B6914); border-radius: 28rpx 0 0 28rpx; }

/* ===== 目标卡片内部 ===== */
.goal-card-inner { padding: 8rpx 16rpx 8rpx 24rpx; }

/* 标题行 */
.goal-header { display: flex; align-items: center; gap: 16rpx; margin-bottom: 12rpx; }
.goal-emoji { font-size: 44rpx; width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; background: rgba(124,179,66,0.15); border-radius: 16rpx; border: 2rpx solid rgba(124,179,66,0.3); flex-shrink: 0; }
.goal-info { flex: 1; min-width: 0; }
.goal-title { font-size: 30rpx; font-weight: 700; color: #F5E6C8; display: block; margin-bottom: 4rpx; }

/* 状态标签 — 木片样式 */
.status-chip { font-size: 20rpx; padding: 4rpx 16rpx; border-radius: 999rpx; display: inline-block; font-weight: 600; }
.wood-chip-style { background: rgba(139,105,20,0.25); color: #DAA520; border: 1rpx solid rgba(184,134,11,0.4); }

/* 目标描述 */
.goal-desc { font-size: 23rpx; color: #C4B89A; display: block; margin-bottom: 16rpx; line-height: 1.5; }

/* ===== 进度展示区域 ===== */
.progress-area { display: flex; align-items: center; gap: 16rpx; margin-bottom: 12rpx; }

/* 渐变进度条轨道 */
.progress-bar-track { flex: 1; height: 20rpx; background: rgba(45,74,62,0.6); border-radius: 10rpx; overflow: hidden; border: 1rpx solid rgba(139,105,20,0.2); position: relative; }

/* 渐变填充 — 叶子绿渐变 + 微光效果 */
.progress-bar-fill { height: 100%; border-radius: 10rpx; background: linear-gradient(90deg, #7CB342, #AED581, #C5E1A5); box-shadow: 0 0 12rpx rgba(124,179,66,0.4); transition: width 0.5s ease; position: relative; }
.progress-bar-fill::after { content: ''; position: absolute; right: 0; top: -2rpx; width: 8rpx; height: 24rpx; background: #E8F5E9; border-radius: 4rpx; opacity: 0.8; animation: shine 2s ease-in-out infinite; }
@keyframes shine { 0%, 100% { opacity: 0.3; } 50% { opacity: 1; } }

/* 环形百分比指示器 */
.progress-ring-wrap { width: 72rpx; height: 72rpx; flex-shrink: 0; position: relative; display: flex; align-items: center; justify-content: center; }
.progress-ring-bg { position: absolute; inset: 0; border-radius: 50%; border: 4rpx solid rgba(139,105,20,0.3); }
.progress-pct { font-size: 22rpx; font-weight: 800; color: #FFAB40; z-index: 1; text-shadow: 0 2rpx 6rpx rgba(0,0,0,0.3); }

/* ===== 天数信息 ===== */
.days-info { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; padding: 10rpx 16rpx; background: rgba(53,84,71,0.5); border-radius: 12rpx; border: 1rpx dashed rgba(184,134,11,0.25); }
.days-num { font-size: 26rpx; font-weight: 700; color: #F5E6C8; }
.days-label { font-size: 21rpx; color: #8B9A7D; }

/* ===== 今日任务子列表 ===== */
.today-tasks { border-top: 2rpx dashed rgba(184,134,11,0.2); padding-top: 14rpx; }
.today-tasks-title { font-size: 23rpx; font-weight: 600; color: #AED581; display: block; margin-bottom: 10rpx; }

.task-item { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; padding: 4rpx 0; }

/* 圆角复选框 */
.task-round-box { width: 34rpx; height: 34rpx; border-radius: 50%; border: 3rpx solid #8B6914; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: all 0.25s ease; background: transparent; }
.task-round-box.box-checked { background: #7CB342; border-color: #7CB342; }
.task-check-mark { font-size: 19rpx; color: #FFFFFF; font-weight: 700; }

/* 任务文字 */
.task-text { font-size: 25rpx; color: #E8D9BB; flex: 1; }
.task-text.text-done { color: #8B9A7D; text-decoration: line-through; text-decoration-color: #8B9A7D; }

/* ===== 表单覆盖层（毛玻璃效果） ===== */
.form-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(45,74,62,0.8); backdrop-filter: blur(12rpx); display: flex; align-items: center; justify-content: center; z-index: 100; padding: 40rpx; }

/* 表单弹窗 — 木纹模态框 */
.form-modal { width: 100%; max-height: 80vh; overflow-y: auto; padding: 36rpx 28rpx; box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.35); }
.form-modal-title { font-size: 32rpx; font-weight: 700; color: #F5E6C8; display: block; margin-bottom: 28rpx; text-align: center; }

/* 表单标签 */
.form-label { font-size: 25rpx; font-weight: 600; color: #AED581; display: block; margin-bottom: 8rpx; margin-top: 18rpx; }
.form-label:first-of-type { margin-top: 0; }

/* 木纹输入框 */
.wood-input { width: 100%; height: 78rpx; background: rgba(45,74,62,0.5); border: 2rpx solid rgba(139,105,20,0.4); border-radius: 18rpx; padding: 0 22rpx; font-size: 27rpx; color: #F5E6C8; box-sizing: border-box; margin-bottom: 4rpx; }

/* 木纹文本域 */
.wood-textarea { width: 100%; height: 130rpx; background: rgba(45,74,62,0.5); border: 2rpx solid rgba(139,105,20,0.4); border-radius: 18rpx; padding: 14rpx 22rpx; font-size: 27rpx; color: #F5E6C8; box-sizing: border-box; resize: none; }

/* 天数选项 */
.day-options { display: flex; gap: 12rpx; margin-bottom: 28rpx; flex-wrap: wrap; }

/* Emoji选择器 [M-06新增] */
.emoji-picker { display: flex; gap: 10rpx; flex-wrap: wrap; margin-bottom: 8rpx; }
.emoji-chip {
  width: 64rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx;
  background: rgba(45,74,62,0.5);
  border: 2rpx solid rgba(139,105,20,0.25);
  border-radius: 16rpx;
  transition: all 0.2s ease;
}
.emoji-chip.emoji-active {
  background: rgba(124,179,66,0.2);
  border-color: #7CB342;
  box-shadow: 0 0 12rpx rgba(124,179,66,0.3);
  transform: scale(1.1);
}

/* 木片样式选择器 */
.wood-chip { padding: 12rpx 24rpx; border-radius: 999rpx; border: 2rpx solid rgba(139,105,20,0.4); font-size: 25rpx; color: #C4B89A; font-weight: 500; background: transparent; transition: all 0.25s ease; }
.wood-chip.chip-active { background: linear-gradient(135deg, #7CB342, #689F38); color: #fff; border-color: #7CB342; box-shadow: 0 4rpx 12rpx rgba(124,179,66,0.3); }
.wood-chip:active { opacity: 0.75; transform: scale(0.96); }

/* 表单操作按钮 */
.form-actions { display: flex; gap: 16rpx; }

.btn-cancel { flex: 1; height: 74rpx; line-height: 74rpx; border-radius: 999rpx; font-size: 27rpx; font-weight: 600; border: none; }
.btn-cancel::after { border: none; }
.btn-submit { flex: 1; height: 74rpx; line-height: 74rpx; border-radius: 999rpx; font-size: 27rpx; font-weight: 700; border: none; box-shadow: 0 4rpx 14rpx rgba(124,179,66,0.35); }
.btn-submit::after { border: none; }
.btn-submit:active { opacity: 0.85; transform: scale(0.97); }

/* ===== 加载提示 ===== */
.loading-tip { text-align: center; padding: 40rpx; color: #8B9A7D; font-size: 26rpx; }

/* ===== 动森通用组件样式 ===== */
.wood-title { display: flex; align-items: center; justify-content: center; gap: 16rpx; background: linear-gradient(135deg, #8B6914, #B8860B); border-radius: 50rpx; padding: 16rpx 40rpx; margin-bottom: 24rpx; box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.3); }
.wood-title-leaf { font-size: 26rpx; }
.wood-title-text { font-size: 30rpx; font-weight: 800; color: #F5E6C8; letter-spacing: 2px; }

.btn-leaf { display: inline-flex; align-items: center; justify-content: center; height: 70rpx; padding: 0 32rpx; background: linear-gradient(135deg, #7CB342, #689F38); border-radius: 999rpx; font-size: 26rpx; font-weight: 600; color: #fff; border: none; box-shadow: 0 4rpx 14rpx rgba(124,179,66,0.35); }

.btn-wood { display: inline-flex; align-items: center; justify-content: center; height: 70rpx; padding: 0 32rpx; background: linear-gradient(135deg, #8B6914, #B8860B); border-radius: 999rpx; font-size: 26rpx; font-weight: 600; color: #F5E6C8; border: none; box-shadow: 0 4rpx 14rpx rgba(0,0,0,0.25); }
.btn-wood::after { border: none; }
