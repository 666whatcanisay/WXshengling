<view class="page">
  <scroll-view scroll-y class="page-scroll" enhanced show-scrollbar="{{false}}">
    <view class="page-inner">

  <!-- 木纹标题栏 + 新建按钮 -->
  <view class="header-row">
    <view class="wood-title wood-title-inline">
      <text class="wood-title-leaf">🌿</text>
      <text class="wood-title-text">🎯 目标看板</text>
      <text class="wood-title-leaf">🌿</text>
    </view>
    <button class="btn-leaf btn-add-goal" bindtap="showCreateForm">+ 新建目标</button>
  </view>

  <!-- 空状态提示 -->
  <view wx:if="{{goals.length === 0 && !showForm}}" class="empty-state">
    <text class="empty-icon">🌰</text>
    <text class="empty-text">还没有目标哦，点击上方按钮创建一个吧～</text>
  </view>

  <!-- 目标卡片列表 -->
  <view wx:for="{{goals}}" wx:key="id" class="card-solid goal-card" bindtap="goDetail" data-id="{{item.id}}">
    <!-- 左侧深棕色装饰条 -->
    <view class="card-wood-stripe"></view>

    <!-- 卡片内容区 -->
    <view class="goal-card-inner">
      <!-- 标题行：emoji + 标题 + 状态标签 -->
      <view class="goal-header">
        <text class="goal-emoji">{{item.emoji || '🎯'}}</text>
        <view class="goal-info">
          <text class="goal-title">{{item.title}}</text>
          <!-- [G-02修复] 使用预计算的statusLabel -->
          <view class="status-chip wood-chip-style">{{item.statusLabel || '待开始'}}</view>
        </view>
      </view>

      <!-- 描述文字 -->
      <text wx:if="{{item.description}}" class="goal-desc">{{item.description}}</text>

      <!-- 进度条（渐变填充 + 环形指示器） -->
      <view class="progress-area">
        <view class="progress-bar-track">
          <view class="progress-bar-fill" style="width: {{item.progress}}%"></view>
        </view>
        <view class="progress-ring-wrap">
          <view class="progress-ring-bg"></view>
          <text class="progress-pct">{{item.progress}}%</text>
        </view>
      </view>

      <!-- 天数信息 -->
      <view class="days-info">
        <text class="days-num">{{item.completed_days || 0}}/{{item.target_days}}天</text>
        <text class="days-label">已完成天数</text>
      </view>

      <!-- 今日任务子列表（可交互）[M-05修复] -->
      <view wx:if="{{item.todayTasks && item.todayTasks.length > 0}}" class="today-tasks">
        <text class="today-tasks-title">🍃 今日任务</text>
        <view wx:for="{{item.todayTasks}}" wx:key="id" wx:for-item="task" class="task-item"
              catchtap="toggleTodayTask" data-goalid="{{item.id}}" data-taskid="{{task.id}}">
          <view class="task-round-box {{task.done ? 'box-checked' : ''}}">
            <text wx:if="{{task.done}}" class="task-check-mark">✓</text>
          </view>
          <text class="task-text {{task.done ? 'text-done' : ''}}">{{task.text}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 创建目标表单弹窗 -->
  <view wx:if="{{showForm}}" class="form-overlay">
    <view class="form-modal card-solid">
      <text class="form-modal-title">🌱 创建新目标</text>

      <!-- [M-06新增] Emoji选择器 -->
      <text class="form-label">选择图标</text>
      <view class="emoji-picker">
        <view wx:for="{{['🎯','🏃','📚','🐍','💪','🎨','📝','🌱','🔥','💻','🎵','🏋️']}}" wx:key="*this"
              class="emoji-chip {{formEmoji === item ? 'emoji-active' : ''}}"
              catchtap="selectEmoji" data-emoji="{{item}}">
          {{item}}
        </view>
      </view>

      <text class="form-label">目标名称</text>
      <input class="wood-input" placeholder="如：30天晨跑计划" bindinput="onTitle" value="{{formTitle}}" />

      <text class="form-label">目标描述</text>
      <textarea class="wood-textarea" placeholder="简单描述你的目标～" bindinput="onDesc" value="{{formDesc}}" />

      <text class="form-label">目标天数</text>
      <view class="day-options">
        <view wx:for="{{[7, 21, 30, 60, 100]}}" wx:key="*this"
              class="wood-chip {{formDays === item ? 'chip-active' : ''}}"
              bindtap="selectDays" data-days="{{item}}">
          {{item}}天
        </view>
      </view>

      <view class="form-actions">
        <button class="btn-wood btn-cancel" bindtap="cancelForm">取消</button>
        <button class="btn-leaf btn-submit" bindtap="submitGoal">创建目标 🌿</button>
      </view>
    </view>
  </view>

    </view>
  </scroll-view>
</view>
