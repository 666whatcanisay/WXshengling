<template name="goal-tile">
  <view class="goal-tile" bindtap="goDetail" data-id="{{goal.id}}">
    <view class="goal-tile-top">
      <text class="goal-emoji">{{goal.emoji || '🎯'}}</text>
      <text class="goal-status">{{goal.statusLabel || '待开始'}}</text>
    </view>
    <view class="goal-title-row">
      <text class="goal-title">{{goal.title}}</text>
      <text class="goal-arrow" aria-hidden="true">›</text>
    </view>
    <view class="goal-metrics">
      <text class="goal-days" aria-label="累计完成 {{goal.completed_days || 0}} 天，共 {{goal.target_days}} 天">{{goal.completed_days || 0}} / {{goal.target_days}} 天</text>
      <button wx:if="{{goal.todayTasks.length}}" class="goal-task-toggle" catchtap="toggleGoalTasks"
              data-id="{{goal.id}}" aria-expanded="{{expanded}}">
        今日 {{goal.todayDoneCount}} / {{goal.todayTasks.length}} {{expanded ? '▴' : '▾'}}
      </button>
      <text wx:else class="goal-no-tasks">今日无任务</text>
    </view>
    <view wx:if="{{expanded && goal.todayTasks.length}}" class="today-tasks">
      <view wx:for="{{goal.todayTasks}}" wx:key="id" wx:for-item="task" class="task-item"
            catchtap="toggleTodayTask" data-goalid="{{goal.id}}" data-taskid="{{task.id}}">
        <view class="task-round-box {{task.done ? 'box-checked' : ''}}">
          <text wx:if="{{task.done}}" class="task-check-mark">✓</text>
        </view>
        <text class="task-text {{task.done ? 'text-done' : ''}}">{{task.title}}</text>
      </view>
    </view>
  </view>
</template>

<view class="page">
  <scroll-view scroll-y class="page-scroll" enhanced show-scrollbar="{{false}}">
    <view class="page-inner">

  <!-- 标题栏 -->
  <view class="wood-title">
    <text class="wood-title-leaf">🌿</text>
    <text class="wood-title-text">目标看板</text>
    <text class="wood-title-leaf wood-title-leaf-right">🌿</text>
  </view>

  <!-- 新建按钮 -->
  <button class="btn-leaf btn-add-goal" bindtap="showCreateForm">{{goalCreationPending ? '继续确认上次创建' : (goalCreationStorageError ? '重读本机记录' : '+ 新建目标')}}</button>
  <text wx:if="{{goalCreationStorageError && !showForm}}" class="form-label">{{goalCreationStorageError}}</text>

  <!-- 空状态提示 -->
  <view wx:if="{{loadError && !showForm}}" class="empty-state" bindtap="loadGoals">目标读取失败，点击重试</view>
  <view wx:elif="{{loading && goals.length === 0 && !showForm}}" class="empty-state">正在读取目标…</view>
  <view wx:elif="{{goals.length === 0 && !showForm}}" class="empty-state">
    <text class="empty-icon">🌰</text>
    <text class="empty-text">还没有目标哦，点击上方按钮创建一个吧～</text>
  </view>

  <view wx:if="{{goals.length > completedGoalCount}}" class="goal-grid">
    <block wx:for="{{goals}}" wx:key="id">
      <template wx:if="{{item.status !== 'done'}}" is="goal-tile" data="{{goal: item, expanded: expandedGoalId === item.id}}" />
    </block>
  </view>
  <view wx:if="{{completedGoalCount}}">
    <button class="completed-goals-toggle" bindtap="toggleCompletedGoals" aria-expanded="{{completedGoalsExpanded}}">
      <text>已完成目标 <text class="completed-goals-count">{{completedGoalCount}}</text></text>
      <text class="goal-arrow">{{completedGoalsExpanded ? '▴' : '▾'}}</text>
    </button>
    <view wx:if="{{completedGoalsExpanded}}" class="goal-grid">
      <block wx:for="{{goals}}" wx:key="id">
        <template wx:if="{{item.status === 'done'}}" is="goal-tile" data="{{goal: item, expanded: expandedGoalId === item.id}}" />
      </block>
    </view>
  </view>

  <!-- 创建目标表单弹窗 -->
  <view wx:if="{{showForm}}" class="form-overlay">
    <view class="form-modal card-solid">
      <text class="form-modal-title">{{goalCreationPending ? '确认上次创建' : '🌱 创建新目标'}}</text>
      <text wx:if="{{goalCreationPending}}" class="form-label">开始日期 {{goalCreationStart}}。继续确认会使用原请求。</text>
      <text wx:if="{{goalCreationStorageError}}" class="form-label">{{goalCreationStorageError}}</text>

      <!-- [M-06新增] Emoji选择器 -->
      <text class="form-label">选择图标</text>
      <view class="emoji-picker">
        <view wx:for="{{['🎯','🏃','📚','🐍','💪','🎨','📝','🌱','🔥','💻','🎵','🏋️']}}" wx:key="*this"
              class="emoji-chip {{formEmoji === item ? 'emoji-active' : ''}}"
              catchtap="selectEmoji" data-emoji="{{item}}">
          {{item}}
        </view>
      </view>

      <text class="form-label">目标名称</text>
      <input class="wood-input" placeholder="如：30天晨跑计划" bindinput="onTitle" value="{{formTitle}}" disabled="{{goalCreationPending || submittingGoal}}" />

      <text class="form-label">目标描述</text>
      <textarea class="wood-textarea" placeholder="简单描述你的目标～" bindinput="onDesc" value="{{formDesc}}" disabled="{{goalCreationPending || submittingGoal}}" />

      <text class="form-label">目标天数</text>
      <view class="day-options">
        <view wx:for="{{[7, 21, 30, 60, 100]}}" wx:key="*this"
              class="wood-chip {{formDays === item ? 'chip-active' : ''}}"
              bindtap="selectDays" data-days="{{item}}">
          {{item}}天
        </view>
      </view>

      <view class="form-actions">
        <button class="btn-wood btn-cancel" bindtap="cancelForm" disabled="{{submittingGoal}}">{{goalCreationPending ? '稍后确认' : '取消'}}</button>
        <button class="btn-leaf btn-submit" bindtap="submitGoal" disabled="{{submittingGoal}}" loading="{{submittingGoal}}">{{submittingGoal ? '确认中…' : (goalCreationPending ? '继续确认' : '创建目标 🌿')}}</button>
      </view>
    </view>
  </view>

    </view>
  </scroll-view>
</view>
