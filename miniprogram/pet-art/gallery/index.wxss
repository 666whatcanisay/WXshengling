.portrait-gallery { min-height: 100vh; padding: 26rpx; background: #294538; color: #f5e6c8; }
.gallery-card {
  padding: 26rpx 22rpx;
  border: 1rpx solid #68794c;
  border-radius: 26rpx;
  background: #345446;
  text-align: center;
}
.gallery-kicker { font-size: 22rpx; color: #c4d4ac; }
.gallery-species { margin-top: 8rpx; padding: 10rpx; font-size: 36rpx; font-weight: 700; }
.gallery-stages { display: flex; gap: 8rpx; }
.gallery-stages button {
  flex: 1;
  min-width: 0;
  margin: 0;
  padding: 12rpx 0;
  background: #294539;
  color: #eddfbe;
  font-size: 23rpx;
  line-height: 1.3;
}
.gallery-stages button::after { border: 0; }
.gallery-stages .selected { background: #6a6c40; color: #fff0cd; }
.gallery-theme { margin-top: 22rpx; padding: 12rpx; font-size: 24rpx; color: #edca83; }
.gallery-hint { display: block; margin: 8rpx 0 2rpx; font-size: 22rpx; color: #d0dcc0; }
